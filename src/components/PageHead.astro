---
interface Props {
  kicker: string;
  title: string;
  glyph?: string;
}
const { kicker, title, glyph } = Astro.props;
---
<header class="page-head">
  {glyph && <span class="glyph cjk" aria-hidden="true">{glyph}</span>}
  <p class="eyebrow">{kicker}</p>
  <h1>{title}</h1>
  <div class="lede"><slot /></div>
</header>
<style>
  .page-head {
    position: relative;
    max-width: 68rem;
    margin: 0 auto;
    padding: 7rem var(--gutter) 3.5rem;
  }
  h1 {
    font-size: clamp(3.2rem, 8vw, 6.4rem);
    font-weight: 300;
    margin: 1rem 0 1.6rem -0.03em;
  }
  .lede {
    max-width: 38rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    line-height: 1.35;
    color: var(--ink-2);
  }
  .glyph {
    position: absolute;
    right: var(--gutter);
    top: 6rem;
    font-size: clamp(6rem, 14vw, 11rem);
    color: var(--ink-4);
    opacity: 0.35;
    line-height: 1;
    user-select: none;
  }
</style>
