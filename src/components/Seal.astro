---
/** The seal: 結 (musubi — to tie, a knot) cut in white on vermilion. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: cls = '' } = Astro.props;
---
<span class:list={['seal', cls]} style={`--s:${size}px`} aria-hidden="true"><span>結</span></span>
<style>
  .seal {
    display: inline-grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    border-radius: calc(var(--s) * 0.14);
    background: var(--shu-deep);
    color: #f6efe6;
    font-family: var(--font-cjk);
    font-weight: 500;
    font-size: calc(var(--s) * 0.66);
    line-height: 1;
    box-shadow: inset 0 0 0 calc(var(--s) * 0.05) color-mix(in srgb, var(--shu-deep) 80%, #000);
    flex: none;
  }
  .seal span {
    transform: translateY(-0.02em);
  }
</style>
