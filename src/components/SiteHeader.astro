---
import Seal from './Seal.astro';
interface Props {
  current?: string;
  overlay?: boolean;
}
const { current = '', overlay = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { id: 'intro', href: `${base}/`, label: 'Introduction' },
  { id: 'atlas', href: `${base}/atlas/`, label: 'Atlas' },
  { id: 'hypotheses', href: `${base}/hypotheses/`, label: 'Hypotheses' },
  { id: 'traditions', href: `${base}/traditions/`, label: 'Traditions' },
  { id: 'library', href: `${base}/library/`, label: 'Library' },
  { id: 'about', href: `${base}/about/`, label: 'About' },
];
---
<header class:list={['site-header', { overlay }]}>
  <a class="brand" href={`${base}/`} aria-label="Knots — home">
    <Seal size={22} />
    <span class="word">Knots</span>
  </a>
  <nav aria-label="Primary">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <button class="theme-toggle" type="button" aria-label="Toggle paper or night" title="Paper · Night">
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
      <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1"></circle>
      <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5Z" fill="currentColor"></path>
    </svg>
  </button>
  <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false">
    <span></span><span></span>
  </button>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'paper' ? 'night' : 'paper';
    root.dataset.theme = next;
    try {
      localStorage.setItem('knots-theme', next);
    } catch {}
    window.dispatchEvent(new CustomEvent('knots:theme', { detail: next }));
  });
  const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') !== 'true';
    menu.setAttribute('aria-expanded', String(open));
    document.querySelector('.site-header')?.classList.toggle('menu-open', open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.1rem var(--gutter);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-bottom: 1px solid var(--hair);
  }
  .site-header.overlay {
    position: fixed;
    inset: 0 0 auto 0;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 70%, transparent), transparent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: 0;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }
  .word {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--ink);
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-decoration: none;
    padding: 0.4rem 0;
    border-bottom: 1px solid transparent;
    transition: color 250ms var(--ease), border-color 250ms var(--ease);
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--shu);
  }
  .theme-toggle,
  .menu-toggle {
    appearance: none;
    background: none;
    border: 0;
    color: var(--ink-2);
    cursor: pointer;
    padding: 0.35rem;
    display: grid;
    place-items: center;
  }
  .theme-toggle:hover {
    color: var(--ink);
  }
  .menu-toggle {
    display: none;
    width: 34px;
    height: 34px;
    gap: 6px;
    align-content: center;
  }
  .menu-toggle span {
    display: block;
    width: 18px;
    height: 1px;
    background: currentColor;
    transition: transform 300ms var(--ease);
  }
  @media (max-width: 820px) {
    .site-header {
      gap: 0.75rem;
    }
    nav {
      position: fixed;
      inset: 3.6rem 0 auto 0;
      background: var(--glass-strong);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--hair);
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 300ms var(--ease), transform 300ms var(--ease);
    }
    .menu-open nav {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem var(--gutter) 1rem;
    }
    nav a {
      display: block;
      padding: 0.8rem 0;
    }
    .theme-toggle {
      margin-left: auto;
    }
    .menu-toggle {
      display: grid;
    }
    .menu-open .menu-toggle span:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }
    .menu-open .menu-toggle span:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }
  }
</style>
