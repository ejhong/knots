---
/**
 * The top band, as in The OM Project: a title and a line of scripture in
 * Georgia italic — and beneath a hairline, the pages, sitting like tabs on
 * the band's lower edge.
 */
interface Props {
  current?: string;
}
const { current = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { id: 'intro', href: `${base}/`, label: 'Introduction' },
  { id: 'atlas', href: `${base}/atlas/`, label: 'Atlas' },
  { id: 'hypotheses', href: `${base}/hypotheses/`, label: 'Hypotheses' },
  { id: 'research', href: `${base}/research/`, label: 'Research' },
  { id: 'traditions', href: `${base}/traditions/`, label: 'Traditions' },
  { id: 'library', href: `${base}/library/`, label: 'Library' },
  { id: 'about', href: `${base}/about/`, label: 'About' },
];
---
<header class="top-bar">
  <div class="titles">
    <a class="title" href={`${base}/`}><span class="seal cjk" aria-hidden="true">結</span>Knots of Existence</a>
    <p class="subtitle-quote">
      “When all the knots of the heart are cut, here in this life, the mortal becomes immortal. This much is the
      teaching.” <span class="attribution">— Kaṭha Upaniṣad 2.3.15</span>
    </p>
  </div>
  <nav aria-label="Primary">
    {
      links.map((l) => (
        <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .top-bar {
    padding: 13px 24px 0;
    background: var(--border);
    border-bottom: 1px solid #d3cbc1;
    flex-shrink: 0;
  }
  .title {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--text);
    text-decoration: none;
  }
  .title:hover {
    color: var(--text);
  }
  .seal {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 3px;
    background: var(--seal);
    color: #faf7f2;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
  }
  .subtitle-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 11.5px;
    color: var(--muted);
    margin-top: 5px;
    line-height: 1.5;
    max-width: 900px;
  }
  .attribution {
    font-style: normal;
    font-size: 10px;
    opacity: 0.75;
    white-space: nowrap;
  }
  /* The pages: a hairline, then tabs that sit on the band's lower edge. */
  nav {
    display: flex;
    gap: 26px;
    margin-top: 11px;
    border-top: 1px solid rgba(58, 54, 50, 0.1);
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  nav a {
    flex: none;
    font-size: 12px;
    letter-spacing: 0.2px;
    color: var(--muted);
    text-decoration: none;
    padding: 8px 0 7px;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  nav a:hover {
    color: var(--text);
    border-bottom-color: var(--frame-border);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    border-bottom-color: var(--accent-dark);
  }
  @media (max-width: 760px) {
    .top-bar {
      padding: 10px 14px 0;
    }
    .subtitle-quote {
      display: none;
    }
    nav {
      gap: 18px;
      margin-top: 8px;
    }
  }
  /* Phones: all six pages fit on one line. */
  @media (max-width: 480px) {
    nav {
      gap: 12px;
    }
    nav a {
      font-size: 11.5px;
      letter-spacing: 0;
    }
  }
</style>
