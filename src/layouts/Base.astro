---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Enso from '../components/Enso.astro';

interface Props {
  title?: string;
  description?: string;
  /** Full-height app layout (introduction tour, atlas): no page scroll. */
  app?: boolean;
  current?: string;
}
const {
  title,
  description = 'Knots of Existence — an atlas of the body’s held places: a three-dimensional introduction to knots, perforators and fascia, the theories of what knots are, and the maps the contemplative traditions drew of the same ground.',
  app = false,
  current = '',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} · Knots of Existence` : 'Knots of Existence';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#e0dbd4" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}/og.jpg`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Knots of Existence — a figure drawn as the body’s perforators, knots glowing at the neck and shoulders." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[{ app }]}>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <TopBar current={current} />
    <main id="main" class:list={[{ 'app-main': app }]}>
      <slot />
    </main>
    {
      !app && (
        <footer class="page-footer">
          <Enso size={30} seed={11} />
          <p class="mono">Knots of Existence · © 2026 Eugene Jhong</p>
          <p class="mono links">
            <a href={`${base}/library/#jhong2026`}>essays</a>
            <a href="https://github.com/ejhong/knots">source</a>
            <a href="https://ejhong.github.io/om/">the OM project</a>
          </p>
          <p class="mono fine">body: MakeHuman (CC0) · perforator positions are representative · not medical advice</p>
        </footer>
      )
    }
  </body>
</html>

<style is:global>
  body.app {
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .app-main {
    flex: 1;
    display: flex;
    min-height: 0;
    padding: 16px;
    gap: 16px;
  }
  .page-footer {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 40px 24px 48px;
    font-size: 9.5px;
    color: var(--muted);
    text-align: center;
  }
  .page-footer .enso {
    color: var(--frame-accent);
    margin-bottom: 6px;
  }
  .page-footer .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 0;
  }
  .page-footer .links a {
    color: var(--accent-dark);
    text-decoration: none;
  }
  .page-footer .links a:hover {
    color: var(--terracotta);
  }
  .page-footer .links a + a::before {
    content: '·';
    color: var(--faint);
    margin: 0 9px;
  }
  .page-footer .fine {
    color: var(--faint);
    font-size: 9px;
  }
  .skip:focus {
    position: fixed !important;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    z-index: 2000;
    background: var(--bg);
    padding: 6px 12px;
  }
  /* Phones: the screen splits — the figure pinned above (it turns every way),
     the panel below scrolling on its own — so turning and scrolling never compete. */
  @media (max-width: 900px) {
    .app-main {
      flex-direction: column;
      padding: 8px;
      gap: 8px;
    }
  }
</style>
