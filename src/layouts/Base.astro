---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';

interface Props {
  title?: string;
  description?: string;
  /** Full-height app layout (introduction tour, atlas): no page scroll. */
  app?: boolean;
  current?: string;
}
const {
  title,
  description = 'Knots of Existence — an atlas of the body’s held places: a three-dimensional introduction to knots, the perforator-and-sheet hypothesis, its rivals, and the maps the contemplative traditions drew of the same ground.',
  app = false,
  current = '',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} · Knots of Existence` : 'Knots of Existence';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#e0dbd4" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}/og.png`, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[{ app }]}>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <TopBar current={current} />
    <main id="main" class:list={[{ 'app-main': app }]}>
      <slot />
    </main>
    {
      !app && (
        <footer class="page-footer mono">
          <span>© 2026 Eugene Jhong</span>
          <a href="https://ejhong.substack.com/p/knots-of-existence-hypotheses">essay</a>
          <a href="https://github.com/ejhong/knots">source</a>
          <span>body: MakeHuman (CC0) · perforator positions are representative · not medical advice</span>
        </footer>
      )
    }
  </body>
</html>

<style is:global>
  body.app {
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .app-main {
    flex: 1;
    display: flex;
    min-height: 0;
    padding: 16px;
    gap: 16px;
  }
  .page-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 9px;
    color: var(--muted);
    padding: 24px;
    border-top: 1px solid var(--border);
    margin-top: 32px;
  }
  .page-footer a {
    color: var(--muted);
  }
  .skip:focus {
    position: fixed !important;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    z-index: 2000;
    background: var(--bg);
    padding: 6px 12px;
  }
  @media (max-width: 900px) {
    body.app {
      height: auto;
      overflow: auto;
    }
    .app-main {
      flex-direction: column;
      padding: 10px;
      gap: 10px;
    }
  }
</style>
