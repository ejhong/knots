---
import Base from './Base.astro';

/**
 * Reading pages: one sheet of rice paper, centred, with a quiet index under
 * the title and faint CJK marginalia beside each section — a sutra page in
 * the OM palette. Sections opt in to marginalia with `data-glyph`.
 */
interface Props {
  title: string;
  kicker: string;
  lede?: string;
  current: string;
  description?: string;
  /** Large ornament at the top of the sheet. */
  glyph?: string;
  /** One-line index of the page's sections. */
  index?: { id: string; label: string }[];
  wide?: boolean;
  noindex?: boolean;
}
const { title, kicker, lede, current, description, glyph, index = [], wide = false, noindex = false } = Astro.props;
---
<Base title={title} current={current} description={description} noindex={noindex}>
  <div class="doc">
    <article class:list={['sheet', { wide }]}>
      {glyph && <span class="ornament cjk" aria-hidden="true">{glyph}</span>}
      <header class="sheet-head">
        <p class="label">{kicker}</p>
        <h1>{title}</h1>
        {lede && <p class="lede">{lede}</p>}
        {
          index.length > 0 && (
            <nav class="index" aria-label="On this page">
              {index.map((t) => (
                <a href={`#${t.id}`}>{t.label}</a>
              ))}
            </nav>
          )
        }
      </header>
      <div class="sheet-body">
        <slot />
      </div>
    </article>
  </div>
</Base>

<style>
  .doc {
    padding: 24px 16px 0;
  }
  .sheet {
    position: relative;
    max-width: 880px;
    margin: 0 auto;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 42px 64px 52px 72px;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6) inset, 0 12px 40px -24px rgba(58, 54, 50, 0.18);
  }
  .sheet.wide {
    max-width: 1120px;
  }
  .ornament {
    position: absolute;
    top: 30px;
    right: 44px;
    font-size: 46px;
    line-height: 1;
    color: var(--celadon);
    user-select: none;
  }
  .sheet-head {
    max-width: 680px;
    padding-bottom: 22px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.3px;
    line-height: 1.2;
    margin: 8px 0 10px;
    text-wrap: balance;
  }
  .lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }
  .index {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 20px;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .index a {
    color: var(--accent-dark);
    text-decoration: none;
    white-space: nowrap;
  }
  .index a:hover {
    color: var(--terracotta);
  }

  /* Sections and their marginalia. */
  .sheet-body :global(.sec) {
    position: relative;
    max-width: 680px;
    padding: 26px 0 8px;
    scroll-margin-top: 16px;
  }
  .sheet-body :global(.sec + .sec) {
    border-top: 1px solid var(--border);
  }
  .sheet-body :global(.sec.full) {
    max-width: none;
  }
  .sheet-body :global(.sec[data-glyph])::before {
    content: attr(data-glyph);
    position: absolute;
    left: -46px;
    top: 30px;
    writing-mode: vertical-rl;
    font-family: var(--font-cjk);
    font-size: 15px;
    letter-spacing: 5px;
    color: #9fc0b2;
  }
  .sheet-body :global(h2) {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.2px;
    line-height: 1.3;
    margin: 0 0 4px;
  }
  .sheet-body :global(.sec > .label) {
    font-size: 9.5px;
    margin-bottom: 12px;
    display: block;
  }

  @media (max-width: 900px) {
    .doc {
      padding: 10px 10px 0;
    }
    .sheet {
      padding: 26px 20px 32px;
    }
    .ornament {
      font-size: 34px;
      top: 22px;
      right: 20px;
    }
    .sheet-body :global(.sec[data-glyph])::before {
      display: none;
    }
    h1 {
      padding-right: 44px;
    }
  }
</style>
