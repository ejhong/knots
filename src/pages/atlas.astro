---
import Base from '../layouts/Base.astro';
import Enso from '../components/Enso.astro';
import { HYPOTHESES } from '../data/hypotheses';
import { MAP_GROUPS } from '../data/mapIndex';
import '../styles/app.css';
const AGES = [1, 5, 10, 18, 25, 35, 45, 55, 70, 90];
const pct = (a: number) => ((a - 1) / 89) * 100;
---
<Base title="Atlas" app current="atlas" description="An interactive three-dimensional atlas of the body’s perforators, fascia and knots, with alternate theories and traditional maps for comparison.">
  <section class="visualization" data-atlas>
    <div class="canvas-container frame-marks" data-stage>
      <canvas id="atlas-canvas" aria-label="Three-dimensional figure made of the body's perforators, with its fascia and knots. Drag to turn; hover or click to inspect; double-click or hold to release knots."></canvas>

      <div class="overlay tl">
        <select class="mono-select" data-hyp-select aria-label="Theory">
          {HYPOTHESES.map((h) => <option value={h.id} disabled={!h.ready}>{h.label}{h.ready ? '' : ' · soon'}</option>)}
        </select>
      </div>
      <div class="overlay tr legend">
        <span><i class="sw sw-perforator"></i>perforator</span>
        <span><i class="sw sw-knot"></i>knot</span>
        <span><i class="sw sw-vessel"></i>vessel</span>
        <span><i class="sw sw-channel"></i>channel</span>
      </div>
      <div class="overlay bl" data-hint>drag to turn · click to select · double-click or hold to release knots · shift-click for a window</div>
      <div class="overlay br">© 2026 Eugene Jhong</div>
      <div class="tip" data-tip hidden aria-live="polite"></div>
      <div class="loading" data-loading>
        <Enso size={56} seed={5} />
        <span>drawing a hundred thousand perforators</span>
      </div>
    </div>

    <div class="player-controls">
      <div class="timeline-container">
        <div class="timeline-wrap">
          <div class="markers" aria-hidden="true">
            {AGES.map((a) => <span style={`left:${pct(a)}%`}>{a}</span>)}
          </div>
          <input class="timeline" type="range" min="1" max="90" step="0.5" value="34" data-age aria-label="Age in years" />
        </div>
        <span class="time" data-age-out>34 y</span>
      </div>
      <div class="settings-container">
        <button class="settings-btn" type="button" data-settings aria-label="Settings" aria-expanded="false">
          <svg viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"></path></svg>
        </button>
        <div class="settings-popup" data-settings-popup>
          <div class="settings-row">
            <span class="k">Ground</span>
            <select class="mono-select" data-ground>
              <option value="night">ink stone</option>
              <option value="paper">rice paper</option>
            </select>
          </div>
          <div class="settings-row">
            <span class="k">Form</span>
            <span class="form-range">
              <span class="end">female</span>
              <input type="range" min="0" max="1" step="0.01" value="1" data-sex aria-label="Form: female to male" />
              <span class="end">male</span>
            </span>
          </div>
          <div class="settings-row">
            <span class="k">Turntable</span>
            <input type="checkbox" data-turntable checked />
          </div>
        </div>
      </div>
    </div>
  </section>

  <aside class="notes-panel panel" aria-label="Atlas panel">
    <div class="panel-head tabbed">
      <div class="tabs" role="tablist">
        <button class="tab is-active" role="tab" data-tab="notes">overview</button>
        <button class="tab" role="tab" data-tab="layers">layers</button>
        <button class="tab" role="tab" data-tab="maps">maps</button>
      </div>
    </div>
    <div class="panel-body">
      <div class="tab-page" data-page="notes">
        <div class="segment" data-card-kicker>Theory</div>
        <div class="prose-dark" data-card-body></div>
        <div class="segment">Where the knot is <span class="faint" data-section-where></span></div>
        <div class="section-svg" data-section></div>
        <div class="segment">Census</div>
        <div class="census" data-census>
          <div><span class="v" data-c="0">—</span><span class="k">micro</span></div>
          <div><span class="v" data-c="1">—</span><span class="k">medium</span></div>
          <div><span class="v" data-c="2">—</span><span class="k">major</span></div>
          <div><span class="v" data-c="3">—</span><span class="k">roots</span></div>
        </div>
        <p class="sub census-note" data-census-note></p>
        <button class="restore" type="button" data-restore hidden title="Every knot back as it was for this age">reset the knots</button>
      </div>

      <div class="tab-page" data-page="layers" hidden>
        <div class="segment">Show</div>
        <label class="row"><input type="checkbox" data-layer="knots" checked /> knots</label>
        <p class="sub">where the chosen theory places them</p>
        <label class="row"><input type="checkbox" data-layer="perforators" checked /> perforators <span class="n" data-count="perforators"></span></label>
        <p class="sub">major, medium and small — each at its depth</p>
        <label class="row"><input type="checkbox" data-layer="fascia" checked /> fascia &amp; gliding plane</label>
        <p class="sub">superficial fascia · gliding plane · deep fascia</p>
        <label class="row"><input type="checkbox" data-layer="vessels" checked /> source vessels <span class="n" data-count="roots"></span></label>
        <p class="sub">the arteries feeding each tree, and their branches</p>
        <label class="row"><input type="checkbox" data-layer="channels" checked /> deep channels <span class="n" data-count="channels"></span></label>
        <p class="sub">septa, raphes and neurovascular sheaths of the deep fascia — candidates for the acupuncture channels</p>
        <label class="row"><input type="checkbox" data-window /> dissection window</label>
        <p class="sub">skin cut back, superficial fascia removed — or shift-click the body to open one there</p>
        <label class="row"><input type="checkbox" data-layer="territories" /> angiosomes</label>
        <p class="sub">approximate territory of each source vessel</p>
        <div class="segment">Depth</div>
        <div class="slider-row">
          <span class="ends"><span>anatomical</span><span>exploded</span></span>
          <input type="range" min="0" max="1" step="0.01" value="1" data-lift aria-label="Layers: anatomical to exploded" />
        </div>
        <div class="segment">Section</div>
        <label class="row"><input type="radio" name="section" value="none" checked /> none</label>
        <label class="row"><input type="radio" name="section" value="sagittal" /> sagittal — through the midline</label>
        <label class="row"><input type="radio" name="section" value="coronal" /> coronal — front removed</label>
        <label class="row"><input type="radio" name="section" value="neck" /> transverse — through the neck</label>
        <p class="hint">Exploded opens the gliding plane and the superficial fat by fixed gaps so the layers can be seen; anatomical draws typical depths for each region. Major perforators pierce the deep fascia; smaller ones branch above it and pierce the superficial fascia.</p>
      </div>

      <div class="tab-page" data-page="maps" hidden>
        <div class="map-card" data-map-card>
          <div class="mc-kicker" data-mc-kicker>Maps</div>
          <div class="mc-title" data-mc-title>Traditional and clinical maps</div>
          <div class="mc-sub" data-mc-sub></div>
          <p class="mc-note" data-mc-note>Choose a map. While it is on, the anatomy steps back — bring a layer forward below to compare.</p>
        </div>
        <div class="segment">Map</div>
        <label class="row"><input type="radio" name="map" value="" checked /> none</label>
        {
          MAP_GROUPS.filter((g) => g.maps.some((m) => m.ready)).map((g) => (
            <>
              <p class="map-tradition">{g.tradition}</p>
              {g.maps
                .filter((m) => m.ready)
                .map((m) => (
                  <label class="row">
                    <input type="radio" name="map" value={m.id} /> {m.name} <span class="n">{m.count}</span>
                  </label>
                ))}
            </>
          ))
        }
        <div class="chipset channels" data-map-chips hidden></div>
        <div class="segment">Compare with</div>
        <div class="chipset" data-compare-grid>
          <button class="chip" type="button" data-compare="knots">knots</button>
          <button class="chip" type="button" data-compare="perforators">perforators</button>
          <button class="chip" type="button" data-compare="vessels">vessels</button>
          <button class="chip" type="button" data-compare="channels">deep channels</button>
        </div>
        <p class="sub">With a map on, the anatomy steps back; bring one layer forward to compare.</p>
        <div class="segment">To come</div>
        <ul class="soon-list">
          {MAP_GROUPS.flatMap((g) => g.maps.filter((m) => !m.ready).map((m) => <li>{m.name} <span>{g.tradition}</span></li>))}
        </ul>
      </div>
    </div>
  </aside>
</Base>

<style>
  .notes-panel :global(.section-svg) {
    padding: 2px 10px 10px 12px;
  }
  .notes-panel :global(.section-svg svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .form-range {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .form-range input {
    width: 84px;
  }
  .notes-panel :global(.sub) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 10.5px;
    color: var(--panel-faint);
    padding: 0 12px 4px 31px;
    margin-top: -3px;
  }
  .restore {
    margin: 0 14px 12px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--panel-muted);
    background: transparent;
    border: 1px solid var(--panel-line);
    border-radius: 4px;
    padding: 3px 8px;
    cursor: pointer;
  }
  .restore:hover {
    color: #f2ebe0;
    border-color: #6f665c;
  }
  .census-note {
    padding: 2px 14px 10px !important;
    margin-top: 0 !important;
  }
  .notes-panel :global(.ends) {
    display: flex;
    justify-content: space-between;
    color: var(--panel-faint);
    font-size: 9px;
  }
  /* A fixed height: what it shows changes as the pointer moves, and the chips
     below must never move under the pointer. */
  .map-card {
    margin: 10px 12px 6px;
    padding: 10px 12px 11px;
    border: 1px solid var(--panel-line);
    border-radius: 8px;
    background: #2f2c29;
    height: 184px;
    overflow: hidden;
  }
  .mc-kicker,
  .mc-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .mc-kicker {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: #b9a2c6;
  }
  .mc-title {
    font-size: 13.5px;
    font-weight: 600;
    color: #f2ebe0;
    margin-top: 3px;
  }
  .mc-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 12px;
    color: var(--panel-muted);
    margin-top: 1px;
  }
  .mc-note {
    font-family: var(--font-serif);
    font-size: 11.5px;
    line-height: 1.5;
    color: #d8cfc2;
    margin-top: 6px;
  }
  .mc-note :global(.anat) {
    display: block;
    margin-top: 5px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    line-height: 1.55;
    color: var(--panel-faint);
  }
  .map-tradition {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--panel-faint);
    padding: 6px 12px 0;
  }
  .chipset.channels :global(.cjk) {
    font-family: var(--font-cjk);
    font-size: 10px;
    color: var(--panel-faint);
  }
  .soon-list {
    list-style: none;
    padding: 2px 14px 12px;
    font-family: var(--font-serif);
    font-size: 11.5px;
    line-height: 1.7;
    color: var(--panel-faint);
  }
  .soon-list span {
    font-family: var(--font-mono);
    font-size: 9px;
    margin-left: 4px;
    opacity: 0.8;
  }
  .form-range .end {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--muted);
  }
</style>

<script>
  import { mountAtlas } from '../viewer/ui/AtlasUI';
  mountAtlas(document.querySelector('[data-atlas]') as HTMLElement, document.querySelector('.notes-panel') as HTMLElement);
</script>
