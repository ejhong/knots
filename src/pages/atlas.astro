---
import Base from '../layouts/Base.astro';
import Enso from '../components/Enso.astro';
import { HYPOTHESES } from '../data/hypotheses';
import { MAP_GROUPS } from '../data/mapIndex';
import { SCENARIOS } from '../viewer/sim/scenarios';
import '../styles/app.css';
const AGES = [1, 5, 10, 18, 25, 35, 45, 55, 70, 90];
const pct = (a: number) => ((a - 1) / 89) * 100;
const MAP_COLORS: Record<string, string> = {
  silver: '#9aa2a8',
  ai: '#7189a8',
  moegi: '#7ca67c',
  yamabuki: '#c9a45f',
  fuji: '#a482ac',
  toki: '#c87868',
  sabi: '#6fa7a2',
};
---
<Base title="Atlas" app current="atlas" description="An interactive three-dimensional atlas of the body’s perforators, fascia and knots, with rival hypotheses and traditional maps for comparison.">
  <section class="visualization" data-atlas>
    <div class="canvas-container frame-marks" data-stage>
      <canvas id="atlas-canvas" aria-label="Three-dimensional figure made of the body's perforators. Drag to turn; press a knot and breathe out to release it."></canvas>

      <div class="overlay tl">
        <select class="mono-select" data-hyp-select aria-label="Hypothesis">
          {HYPOTHESES.map((h) => <option value={h.id} disabled={!h.ready}>{h.name}{h.ready ? '' : ' — soon'}</option>)}
        </select>
        <span data-hyp-who>Jhong 2026</span>
      </div>
      <div class="overlay tr legend">
        <span><i style="background:#e6dccd"></i>perforator</span>
        <span><i style="background:#d9826d"></i>knot</span>
        <span><i style="background:#9dcc9a"></i>release</span>
        <span><i style="background:#9aa2a8"></i>tree</span>
      </div>
      <div class="overlay bl" data-hint>drag to turn · hold a knot and breathe out · hold space to inhale</div>
      <div class="overlay br">© 2026 Eugene Jhong</div>
      <div class="tip" data-tip hidden></div>
      <div class="loading" data-loading>
        <Enso size={56} seed={5} />
        <span>drawing a hundred thousand staples</span>
      </div>
    </div>

    <div class="player-controls">
      <button class="play-btn" type="button" data-life aria-label="Play a life, from infancy to ninety" title="Play a life">
        <svg viewBox="0 0 24 24" data-play-icon><path d="M8 5v14l11-7z"></path></svg>
      </button>
      <div class="timeline-container">
        <div class="timeline-wrap">
          <div class="markers" aria-hidden="true">
            {AGES.map((a) => <span style={`left:${pct(a)}%`}>{a}</span>)}
          </div>
          <input class="timeline" type="range" min="1" max="90" step="0.5" value="34" data-age aria-label="Age in years" />
        </div>
        <span class="time" data-age-out>34 y</span>
      </div>
      <button class="breath" type="button" data-breath title="Breath — paced at six a minute. Click for manual; hold Space to inhale, release to exhale.">
        <Enso size={22} seed={9} />
        <span class="breath-label" data-breath-label>exhale</span>
      </button>
      <div class="ctrl-group" role="toolbar" aria-label="Tools">
        <button class="seg" type="button" data-tool="look" title="Look (L): drag to turn">look</button>
        <button class="seg is-active" type="button" data-tool="press" title="Press (P): hold on a knot; release comes on the out-breath">press</button>
        <button class="seg" type="button" data-tool="roll" title="Roll (R): drag across the body — pressure and shear">roll</button>
        <button class="seg" type="button" data-tool="hydro" title="Hydrodissect (H): free a collar with fluid, no breath needed">hydro</button>
        <button class="seg" type="button" data-tool="stress" title="Stress (S): paint sympathetic drive">stress</button>
      </div>
      <div class="settings-container">
        <button class="settings-btn" type="button" data-settings aria-label="Settings" aria-expanded="false">
          <svg viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"></path></svg>
        </button>
        <div class="settings-popup" data-settings-popup>
          <div class="settings-row">
            <span class="k">Ground</span>
            <select class="mono-select" data-ground>
              <option value="night">ink stone</option>
              <option value="paper">rice paper</option>
            </select>
          </div>
          <div class="settings-row">
            <span class="k">Form</span>
            <span class="form-range">
              <span class="end">female</span>
              <input type="range" min="0" max="1" step="0.01" value="1" data-sex aria-label="Form: female to male" />
              <span class="end">male</span>
            </span>
          </div>
          <div class="settings-row">
            <span class="k">Speed</span>
            <select class="mono-select" data-speed>
              <option value="3">slow</option>
              <option value="6" selected>normal</option>
              <option value="14">fast</option>
            </select>
          </div>
          <div class="settings-row">
            <span class="k">Turntable</span>
            <input type="checkbox" data-turntable checked />
          </div>
        </div>
      </div>
    </div>
  </section>

  <aside class="notes-panel panel" aria-label="Atlas panel">
    <div class="panel-head tabbed">
      <div class="tabs" role="tablist">
        <button class="tab is-active" role="tab" data-tab="notes">notes</button>
        <button class="tab" role="tab" data-tab="layers">layers</button>
        <button class="tab" role="tab" data-tab="maps">maps</button>
        <button class="tab" role="tab" data-tab="scenes">scenes</button>
      </div>
    </div>
    <div class="panel-body">
      <div class="tab-page" data-page="notes">
        <div class="segment" data-card-kicker>Hypothesis</div>
        <div class="prose-dark" data-card-body></div>
        <div class="segment">Census</div>
        <div class="census" data-census>
          <div><span class="v" data-c="0">—</span><span class="k">micro</span></div>
          <div><span class="v" data-c="1">—</span><span class="k">medium</span></div>
          <div><span class="v" data-c="2">—</span><span class="k">major</span></div>
          <div><span class="v" data-c="3">—</span><span class="k">roots</span></div>
        </div>
        <div class="segment">Releases <span class="faint" data-log-count></span></div>
        <div class="log" data-log><div class="item" style="color:#8f857a">press a knot and breathe out…</div></div>
      </div>

      <div class="tab-page" data-page="layers" hidden>
        <div class="segment">Layers</div>
        <label class="row"><input type="checkbox" data-layer="perforators" checked /> perforators <span class="n" data-count="perforators"></span></label>
        <label class="row"><input type="checkbox" data-layer="trees" checked /> vessel trees</label>
        <label class="row"><input type="checkbox" data-layer="roots" checked /> roots · gates <span class="n" data-count="roots"></span></label>
        <label class="row"><input type="checkbox" data-layer="knots" checked /> knots</label>
        <label class="row"><input type="checkbox" data-layer="territories" /> angiosomes (territories)</label>
        <div class="segment">The sheet — fascia &amp; interstitial space</div>
        <div class="slider-row">
          <span>lift the sheet off the floor <span class="faint" data-lift-out>0</span></span>
          <input type="range" min="0" max="1" step="0.01" value="0" data-lift aria-label="Lift the sheet" />
        </div>
        <div class="segment">Section</div>
        <label class="row"><input type="radio" name="section" value="none" checked /> none</label>
        <label class="row"><input type="radio" name="section" value="sagittal" /> sagittal — through the midline</label>
        <label class="row"><input type="radio" name="section" value="coronal" /> coronal — front removed</label>
        <label class="row"><input type="radio" name="section" value="neck" /> transverse — through the neck</label>
        <p class="hint">Lifting exaggerates the interstitial plane so the staples show as stalks. At zero the layers sit at typical anatomical depths for each region.</p>
      </div>

      <div class="tab-page" data-page="maps" hidden>
        {
          MAP_GROUPS.map((g) => (
            <>
              <div class="segment">{g.tradition}</div>
              {g.maps.map((m) => (
                <label class:list={['row', { soon: !m.ready }]}>
                  <input type="checkbox" data-map={m.id} disabled={!m.ready} />
                  <span class="swatch" style={`background:${MAP_COLORS[m.color] ?? '#9aa2a8'}`} />
                  {m.name}
                  {!m.ready && <span class="n">soon</span>}
                </label>
              ))}
            </>
          ))
        }
      </div>

      <div class="tab-page" data-page="scenes" hidden>
        <div class="segment">Aggravate</div>
        <div class="chipset">
          {SCENARIOS.map((s) => <button class="chip" type="button" data-scenario={s.id} title={s.note}>{s.label}</button>)}
        </div>
        <div class="segment">Relieve</div>
        <div class="chipset">
          <button class="chip relief" type="button" data-warmth title="Heat opens the whole bed — until you step out">sauna</button>
          <button class="chip relief" type="button" data-rest title="Lift the drive; the knots it wrote remain">rest</button>
        </div>
        <div class="prose-dark" data-scene-note>
          <p>An aggravation raises sympathetic drive where a posture or a mood loads the body; knots swell and multiply over sim-minutes. Lift it and the drive goes — but what it wrote stays until released.</p>
        </div>
      </div>
    </div>
  </aside>
</Base>

<style>
  .form-range {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .form-range input {
    width: 84px;
  }
  .form-range .end {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--muted);
  }
</style>

<script>
  import { mountAtlas } from '../viewer/ui/AtlasUI';
  mountAtlas(document.querySelector('[data-atlas]') as HTMLElement, document.querySelector('.notes-panel') as HTMLElement);
</script>
