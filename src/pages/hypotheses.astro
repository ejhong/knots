---
import Doc from '../layouts/Doc.astro';
import { HYPOTHESES } from '../data/hypotheses';
import { refById } from '../data/references';
import { crossSectionSVG } from '../lib/crossSection';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ROWS: [keyof (typeof HYPOTHESES)[number], string][] = [
  ['layer', 'Where'],
  ['substance', 'Made of'],
  ['holds', 'Holds'],
  ['releases', 'Releases'],
  ['timescale', 'Timescale'],
  ['breath', 'Breath'],
  ['travel', 'Travel'],
  ['age', 'Age'],
  ['test', 'Test'],
  ['status', 'Evidence'],
];
const GLYPH: Record<string, string> = {
  perforator: '結',
  latch: '閂',
  'trigger-point': '点',
  densification: '膠',
  nerve: '神経',
  central: '覚',
};
const index = [
  ...HYPOTHESES.map((h, i) => ({ id: h.id, label: `${String(i + 1).padStart(2, '0')} ${h.label}` })),
  { id: 'compare', label: 'side by side' },
];
---
<Doc
  title="What is a knot?"
  kicker="Hypotheses"
  current="hypotheses"
  lede="Six answers, each given at its strongest — its own best evidence and its own sharpest test. They are not all rivals, and where they part, they can be tested."
  description="What is a knot? Six answers — perforators held stuck, the vascular latch, the trigger point, fascial densification, sensitised nerves, and perception — each at its strongest."
  glyph="説"
  index={index}
  wide
>
  {
    HYPOTHESES.map((h, i) => (
      <section class="sec hyp" id={h.id} data-glyph={GLYPH[h.id]}>
        <div class="hyp-head">
          <h2>
            <span class="n mono">{String(i + 1).padStart(2, '0')}</span> {h.name}
          </h2>
          <span class="who mono">
            {h.who}
            {h.year ? ` · ${h.year}` : ''}
          </span>
          {h.ready ? (
            <a class="btn" href={`${base}/atlas/?h=${h.id}`}>
              view in atlas →
            </a>
          ) : (
            <span class="soon mono">atlas view soon</span>
          )}
        </div>
        <p class="short quote">{h.short}</p>
        <figure class="section" set:html={crossSectionSVG({ dSup: 0.0042, dDeep: 0.01, hypothesis: h.id, region: 'upper back', tone: 'light', width: 330 })} />
        <div class="prose">
          {h.body.map((p) => (
            <p set:html={p} />
          ))}
        </div>
        <dl class="kv">
          {ROWS.map(([k, label]) => (
            <>
              <dt>{label}</dt>
              <dd>{h[k] as string}</dd>
            </>
          ))}
        </dl>
        <p class="refs mono">
          {h.refs
            .map((r) => refById(r))
            .filter(Boolean)
            .map((r) => (
              <a href={`${base}/library/#${r!.id}`}>
                {r!.authors.split(',')[0].split(' (')[0]} {r!.year > 0 ? r!.year : ''}
              </a>
            ))}
        </p>
      </section>
    ))
  }

  <section id="compare" class="sec full compare">
    <h2>Side by side</h2>
    <div class="table-wrap" role="region" aria-label="Comparison of hypotheses" tabindex="0">
      <table>
        <thead>
          <tr>
            <th scope="col"></th>
            {
              HYPOTHESES.map((h) => (
                <th scope="col">{h.label}</th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            ROWS.map(([k, label]) => (
              <tr>
                <th scope="row">{label}</th>
                {HYPOTHESES.map((h) => (
                  <td>{h[k] as string}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Doc>

<style>
  .hyp {
    padding-bottom: 22px !important;
  }
  .hyp-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-bottom: 8px;
  }
  .hyp-head h2 {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.2px;
  }
  .n {
    font-size: 11px;
    font-weight: 400;
    color: var(--muted);
    margin-right: 4px;
  }
  .who {
    font-size: 10px;
    color: var(--muted);
  }
  .hyp-head .btn {
    margin-left: auto;
    font-size: 11px;
    padding: 3px 9px;
  }
  .soon {
    margin-left: auto;
    font-size: 9px;
    color: var(--faint);
  }
  .section {
    margin: 4px 0 14px;
    padding: 12px 14px 8px;
    background: var(--frame-bg);
    border-radius: 8px;
    max-width: 380px;
  }
  .section :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .short {
    font-size: 13px;
    line-height: 1.55;
    margin: 0 0 12px;
    max-width: 760px;
  }
  .prose {
    max-width: 760px;
  }
  .kv {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 7px 14px;
    margin: 14px 0 12px;
    padding: 12px 14px;
    background: var(--frame-bg);
    border-radius: 8px;
    max-width: 820px;
  }
  .kv dt {
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
    padding-top: 2px;
  }
  .kv dd {
    font-family: var(--font-serif);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text);
  }
  .refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 10px;
    color: var(--muted);
  }
  .refs a {
    color: var(--muted);
  }
  .compare h2 {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  table {
    border-collapse: collapse;
    min-width: 1200px;
    font-size: 11.5px;
    line-height: 1.45;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 9px 10px;
    border-bottom: 1px solid var(--border);
  }
  thead th {
    font-size: 11.5px;
    font-weight: 700;
    background: var(--frame-bg);
    width: 160px;
  }
  thead th .sw {
    display: block;
    margin-bottom: 5px;
  }
  tbody th {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
    width: 70px;
    background: var(--frame-bg);
  }
  td {
    font-family: var(--font-serif);
    color: var(--text);
  }
  @media (max-width: 700px) {
    .kv {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .kv dd {
      margin-bottom: 8px;
    }
  }
</style>
