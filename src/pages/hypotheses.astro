---
import Doc from '../layouts/Doc.astro';
import { HYPOTHESES } from '../data/hypotheses';
import { refById } from '../data/references';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ROWS: [keyof (typeof HYPOTHESES)[number], string][] = [
  ['layer', 'Where'],
  ['substance', 'Made of'],
  ['holds', 'Holds'],
  ['releases', 'Releases'],
  ['timescale', 'Timescale'],
  ['breath', 'Breath'],
  ['travel', 'Travel'],
  ['age', 'Age'],
  ['test', 'Test'],
  ['status', 'Evidence'],
];
const toc = [
  ...HYPOTHESES.map((h, i) => ({ id: h.id, label: `${String(i + 1).padStart(2, '0')} ${h.name}`, sub: `${h.who} · ${h.year}` })),
  { id: 'compare', label: 'Side by side' },
];
---
<Doc
  title="What is a knot?"
  kicker="Hypotheses"
  current="hypotheses"
  lede="Seven answers, each given at its strongest — with its own best evidence and its own sharpest test. The positions are not all rivals; where they part is testable."
  description="What is a knot? Seven candidate answers — stuck perforators, the vascular latch, the integrated trigger point, fascial densification, nerve sensitivity, central sensitisation, and attention — each at its strongest."
  toc={toc}
  wide
>
  {
    HYPOTHESES.map((h, i) => (
      <section class="hyp" id={h.id}>
        <div class="hyp-head">
          <span class="sw" style={`background:${h.color}`} />
          <h2>
            <span class="n mono">{String(i + 1).padStart(2, '0')}</span> {h.name}
          </h2>
          <span class="who mono">
            {h.who} · {h.year}
          </span>
          {h.ready ? (
            <a class="btn" href={`${base}/atlas/?h=${h.id}`}>
              view in atlas →
            </a>
          ) : (
            <span class="soon mono">atlas view soon</span>
          )}
        </div>
        <p class="short quote">{h.short}</p>
        <div class="prose">
          {h.body.map((p) => (
            <p set:html={p} />
          ))}
        </div>
        <dl class="kv">
          {ROWS.map(([k, label]) => (
            <>
              <dt>{label}</dt>
              <dd>{h[k] as string}</dd>
            </>
          ))}
        </dl>
        <p class="refs mono">
          {h.refs
            .map((r) => refById(r))
            .filter(Boolean)
            .map((r) => (
              <a href={`${base}/library/#${r!.id}`}>
                {r!.authors.split(',')[0].split(' (')[0]} {r!.year > 0 ? r!.year : ''}
              </a>
            ))}
        </p>
      </section>
    ))
  }

  <section id="compare" class="compare">
    <h2>Side by side</h2>
    <div class="table-wrap" role="region" aria-label="Comparison of hypotheses" tabindex="0">
      <table>
        <thead>
          <tr>
            <th scope="col"></th>
            {
              HYPOTHESES.map((h) => (
                <th scope="col">
                  <span class="sw" style={`background:${h.color}`} />
                  {h.name}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            ROWS.map(([k, label]) => (
              <tr>
                <th scope="row">{label}</th>
                {HYPOTHESES.map((h) => (
                  <td>{h[k] as string}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="note prose">
      The perforator essay reads Johnson’s latch as the <em>live</em> form of the same clinging whose <em>stored</em> form is a
      stuck staple, and agrees with the nerve and densification views about two of the three parts of its bundle.
    </p>
  </section>
</Doc>

<style>
  .hyp {
    padding: 22px 0 24px;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 12px;
  }
  .hyp:first-child {
    padding-top: 0;
  }
  .hyp-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-bottom: 8px;
  }
  .hyp-head h2 {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.2px;
  }
  .n {
    font-size: 11px;
    font-weight: 400;
    color: var(--muted);
    margin-right: 4px;
  }
  .sw {
    display: inline-block;
    width: 14px;
    height: 8px;
    border-radius: 2px;
    flex: none;
  }
  .who {
    font-size: 10px;
    color: var(--muted);
  }
  .hyp-head .btn {
    margin-left: auto;
    font-size: 11px;
    padding: 3px 9px;
  }
  .soon {
    margin-left: auto;
    font-size: 9px;
    color: var(--faint);
  }
  .short {
    font-size: 13px;
    line-height: 1.55;
    margin: 0 0 12px;
    max-width: 760px;
  }
  .prose {
    max-width: 760px;
  }
  .kv {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 7px 14px;
    margin: 14px 0 12px;
    padding: 12px 14px;
    background: var(--frame-bg);
    border-radius: 8px;
    max-width: 820px;
  }
  .kv dt {
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
    padding-top: 2px;
  }
  .kv dd {
    font-family: var(--font-serif);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text);
  }
  .refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 10px;
    color: var(--muted);
  }
  .refs a {
    color: var(--muted);
  }
  .compare {
    padding-top: 24px;
    scroll-margin-top: 12px;
  }
  .compare h2 {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  table {
    border-collapse: collapse;
    min-width: 1200px;
    font-size: 11.5px;
    line-height: 1.45;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 9px 10px;
    border-bottom: 1px solid var(--border);
  }
  thead th {
    font-size: 11.5px;
    font-weight: 700;
    background: var(--frame-bg);
    width: 160px;
  }
  thead th .sw {
    display: block;
    margin-bottom: 5px;
  }
  tbody th {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
    width: 70px;
    background: var(--frame-bg);
  }
  td {
    font-family: var(--font-serif);
    color: var(--text);
  }
  .note {
    margin-top: 14px;
    max-width: 760px;
  }
  @media (max-width: 700px) {
    .kv {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .kv dd {
      margin-bottom: 8px;
    }
  }
</style>
