---
import Base from '../layouts/Base.astro';
import Enso from '../components/Enso.astro';
import { CHAPTERS } from '../data/tour';
import { refById } from '../data/references';
import '../styles/app.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const html = (s: string) => s.replaceAll('href="HYP"', `href="${base}/hypotheses/"`).replaceAll('href="ATLAS"', `href="${base}/atlas/"`);
---
<Base current="intro" app>
  <section class="visualization" data-tour>
    <div class="canvas-container frame-marks" data-stage>
      <canvas id="tour-canvas" aria-label="The figure, drawn as the body's perforators, illustrating each chapter."></canvas>
      <div class="overlay tl">
        <span class="chapter-label" data-chapter-label>01 · Observations</span>
      </div>
      <div class="overlay tr legend">
        <span><i class="sw sw-perforator"></i>perforator</span>
        <span><i class="sw sw-knot"></i>knot</span>
        <span><i class="sw sw-release"></i>release</span>
        <span><i class="sw sw-vessel"></i>vessel</span>
      </div>
      <div class="big-number" data-big hidden></div>
      <svg class="plate-callout" data-callout aria-hidden="true"><line class="under" data-callout-line /><line data-callout-line /><circle class="under" data-callout-ring r="11" /><circle data-callout-ring r="11" /></svg>
      <div class="plate-host" data-plate hidden></div>
      <div class="overlay bl">
        <a class="enter" href={`${base}/atlas/`}>enter the atlas →</a>
      </div>
      <div class="overlay br">© 2026 Eugene Jhong</div>
      <div class="loading" data-loading>
        <Enso size={56} seed={5} />
        <span>drawing a hundred thousand perforators</span>
      </div>
    </div>
  </section>

  <aside class="notes-panel panel reading" aria-label="Introduction">
    <div class="panel-head">
      <span>Introduction</span>
    </div>
    <div class="panel-body" data-chapters>
      {
        CHAPTERS.map((c, i) => (
          <article class="chapter" id={c.id} data-chapter={i}>
            <div class="segment">
              {c.n} · {c.title} <span class="cjk glyph">{c.glyph}</span>
            </div>
            <div class="prose-dark" set:html={html(c.html)} />
            {c.refs && (
              <div class="refs">
                {c.refs
                  .map((r) => refById(r))
                  .filter(Boolean)
                  .map((r) => (
                    <a class="item" href={`${base}/library/#${r!.id}`}>
                      ↳ {r!.authors.split(',')[0].split(' (')[0]} {r!.year > 0 ? r!.year : ''} — {r!.title}
                    </a>
                  ))}
              </div>
            )}
          </article>
        ))
      }
      <p class="coda">Not medical advice · <a href={`${base}/about/`}>about</a> · <a href={`${base}/library/`}>library</a></p>
    </div>
  </aside>
</Base>

<script>
  import { mountTour } from '../viewer/ui/TourUI';
  mountTour(document.querySelector('[data-tour]') as HTMLElement, document.querySelector('.notes-panel') as HTMLElement);
</script>

<style>
  .notes-panel.reading {
    width: 380px;
    min-width: 380px;
    max-width: 380px;
  }
  .chapter {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--panel-line);
    opacity: 0.42;
    transition: opacity 0.6s var(--ease);
    cursor: pointer;
  }
  .chapter.active {
    opacity: 1;
    cursor: default;
  }
  .chapter .segment {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .glyph {
    margin-left: auto;
    font-size: 15px;
    font-weight: 400;
    color: #8f857a;
    letter-spacing: 0;
    text-transform: none;
  }
  .refs {
    display: grid;
    padding-top: 2px;
  }
  .refs .item {
    color: var(--panel-faint);
    text-decoration: none;
  }
  .refs .item:hover {
    color: var(--panel-muted);
  }
  .coda {
    padding: 14px 14px 22px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.3px;
    color: var(--panel-faint);
  }
  .coda a {
    color: var(--panel-faint);
  }
  .coda a:hover {
    color: var(--panel-muted);
  }
  /* Field notes: short observations, each led by a small mono label and
     marked with the knot colour. */
  .chapter :global(ul.obs) {
    list-style: none;
    margin: -0.2em 0 0.95em;
    padding: 0;
    display: grid;
    gap: 5px;
  }
  .chapter :global(ul.obs li) {
    position: relative;
    padding-left: 14px;
  }
  .chapter :global(ul.obs li)::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #e27b61;
    opacity: 0.85;
  }
  .chapter :global(ul.obs b) {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 9px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #efe7da;
    margin-right: 4px;
  }
  .chapter-label {
    font-size: 11px;
    color: #d8cec1;
    letter-spacing: 0.3px;
  }
  :global(.paper) .chapter-label {
    color: var(--text);
  }
  .enter {
    font-family: var(--font-mono);
    font-size: 10px;
    color: #d8cec1;
    text-decoration: none;
    border: 1px solid #4a4640;
    border-radius: 4px;
    padding: 3px 8px;
    background: rgba(42, 40, 38, 0.7);
  }
  .enter:hover {
    color: #fff;
    border-color: #6f665c;
  }
  /* The magnified plate of one perforator, and the line to where it is on the body. */
  .plate-host {
    position: absolute;
    left: 16px;
    bottom: 46px;
    z-index: 6;
    width: min(360px, 46%);
    padding: 8px 10px 6px;
    background: rgba(29, 27, 25, 0.84);
    border: 1px solid #3a3836;
    border-radius: 8px;
    box-shadow: 0 6px 28px rgba(0, 0, 0, 0.3);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s var(--ease);
  }
  .plate-host.on {
    opacity: 1;
  }
  :global(.paper) .plate-host {
    background: rgba(250, 247, 242, 0.92);
    border-color: var(--border);
    box-shadow: 0 6px 24px rgba(58, 54, 50, 0.12);
  }
  .plate-host :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .plate-callout {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s var(--ease);
  }
  .plate-callout.on {
    opacity: 1;
  }
  .plate-callout line,
  .plate-callout circle {
    fill: none;
    stroke: #efe7da;
    stroke-opacity: 0.85;
    stroke-width: 1.1;
  }
  .plate-callout line {
    stroke-dasharray: 5 4;
  }
  .plate-callout .under {
    stroke: #1d1b19;
    stroke-opacity: 0.55;
    stroke-width: 3.2;
    stroke-dasharray: none;
  }
  :global(.paper) .plate-callout line,
  :global(.paper) .plate-callout circle {
    stroke: #3a3632;
  }
  :global(.paper) .plate-callout .under {
    stroke: #faf7f2;
  }
  @media (max-width: 700px) {
    .plate-callout {
      display: none;
    }
    .plate-host {
      width: 62%;
      bottom: 40px;
    }
  }
  .big-number {
    position: absolute;
    left: 24px;
    top: 44px;
    z-index: 5;
    font-family: var(--font-mono);
    color: #e6ded2;
    pointer-events: none;
  }
  .big-number :global(.v) {
    display: block;
    font-size: 34px;
    font-weight: 300;
    color: #f0e9de;
    letter-spacing: -0.5px;
  }
  .big-number :global(.k) {
    display: block;
    font-size: 10px;
    color: #b9ae9f;
    margin-top: 2px;
  }
  @media (max-width: 900px) {
    .notes-panel.reading {
      width: auto;
      min-width: 0;
      max-width: none;
    }
  }
</style>
