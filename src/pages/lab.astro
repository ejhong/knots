---
// Development bench for the 3D atlas: a bare canvas with `window.atlas`
// exposed so scripts/screenshots.ts can drive camera, theme and state.
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Lab</title>
    <style>
      html, body { margin: 0; height: 100%; background: #0e0f12; overflow: hidden; }
      #stage { position: fixed; inset: 0; }
      canvas { display: block; width: 100%; height: 100%; }
    </style>
  </head>
  <body>
    <div id="stage"><canvas id="c"></canvas></div>
    <script>
      import { AtlasScene } from '../viewer/AtlasScene';
      const params = new URLSearchParams(location.search);
      const theme = (params.get('theme') as 'paper' | 'night') ?? 'night';
      document.body.style.background = theme === 'paper' ? '#f3f1ec' : '#0e0f12';
      const atlas = new AtlasScene(document.getElementById('c') as HTMLCanvasElement, {
        theme,
        modelBase: `${import.meta.env.BASE_URL}/models/`.replace('//', '/'),
        ladder: params.get('n') ? { total: Number(params.get('n')) } : {},
      });
      (window as any).atlas = atlas;
      atlas.ready.then(() => {
        atlas.engine.start();
        (window as any).atlasReady = true;
      });
    </script>
  </body>
</html>
