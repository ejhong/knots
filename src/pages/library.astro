---
import Doc from '../layouts/Doc.astro';
import { REFERENCES, TAG_LABELS, type Tag } from '../data/references';
import { TIMELINE } from '../data/timeline';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tagCounts = new Map<Tag, number>();
for (const r of REFERENCES) for (const t of r.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).map(([t]) => t);
const KIND: Record<string, string> = { paper: 'paper', book: 'book', text: 'text', web: 'web', essay: 'essay' };
const yearLabel = (y: number) => (y < 0 ? `c. ${-y} BCE` : String(y));
const KIND_COLOR: Record<string, string> = { tradition: 'var(--plum)', essay: 'var(--terracotta)', anatomy: 'var(--stone)', medicine: 'var(--accent-dark)' };
const toc = [
  { id: 'history', label: 'A short history of knots', sub: `${TIMELINE.length} moments` },
  { id: 'sources', label: 'Sources', sub: `${REFERENCES.length} papers, books, texts` },
  ...tags.slice(0, 12).map((t) => ({ id: `sources`, label: `· ${TAG_LABELS[t]}`, sub: `${tagCounts.get(t)}` })),
];
---
<Doc
  title="What has been measured, argued and handed down"
  kicker="Library"
  current="library"
  lede="The papers behind each link in the chain, the critiques, and the texts in which the traditions mapped the same ground. Papers are verified against PubMed."
  description="The research on knots — trigger points, fascia, perforators, vessels — alongside the classical texts of Chinese medicine, yoga, Daoist alchemy and Tibetan practice, and a short history of how they met."
  toc={toc}
>
  <section id="history" class="block">
    <h2>A short history of knots</h2>
    <ol class="timeline">
      {
        TIMELINE.map((m) => (
          <li>
            <span class="year mono" style={`color:${KIND_COLOR[m.kind ?? 'medicine']}`}>
              {m.year}
            </span>
            <span class="text">
              {m.text}
              {m.ref && (
                <a class="cite mono" href={`#${m.ref}`}>
                  ↓
                </a>
              )}
            </span>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="sources" class="block" data-library>
    <h2>Sources</h2>
    <div class="controls">
      <div class="filters" role="group" aria-label="Filter by theme">
        <button class="seg is-active" type="button" data-tag="all">all</button>
        {tags.map((t) => <button class="seg" type="button" data-tag={t}>{TAG_LABELS[t].toLowerCase()}</button>)}
      </div>
      <input class="search" type="search" placeholder="search authors, titles, notes" data-search aria-label="Search the library" />
    </div>
    <ol class="entries">
      {
        REFERENCES.map((r) => (
          <li id={r.id} data-tags={r.tags.join(' ')} data-text={`${r.authors} ${r.title} ${r.venue} ${r.note}`.toLowerCase()}>
            <span class="year mono">{yearLabel(r.year)}</span>
            <div>
              <p class="title">
                {r.url ? (
                  <a href={r.url} rel="noopener">
                    {r.title}
                  </a>
                ) : (
                  r.title
                )}
              </p>
              <p class="by">
                {r.authors} · <i>{r.venue}</i>
              </p>
              <p class="note">{r.note}</p>
              <p class="kind mono">
                {KIND[r.kind]}
                {r.tags.map((t) => ` · ${TAG_LABELS[t].toLowerCase()}`)}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="empty mono" hidden data-empty>nothing matches.</p>
    <p class="contribute">
      Missing something? The library is a data file —
      <a href="https://github.com/ejhong/knots/blob/main/src/data/references.ts">src/data/references.ts</a> — and papers are
      verified against PubMed before they are added. See <a href={`${base}/about/`}>About</a>.
    </p>
  </section>
</Doc>

<script>
  const root = document.querySelector<HTMLElement>('[data-library]')!;
  const chips = root.querySelectorAll<HTMLButtonElement>('[data-tag]');
  const items = [...root.querySelectorAll<HTMLLIElement>('.entries li')];
  const search = root.querySelector<HTMLInputElement>('[data-search]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  let tag = 'all';
  const apply = () => {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const okTag = tag === 'all' || (li.dataset.tags ?? '').split(' ').includes(tag);
      const okText = !q || (li.dataset.text ?? '').includes(q);
      li.hidden = !(okTag && okText);
      if (!li.hidden) shown++;
    }
    empty.hidden = shown > 0;
  };
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      tag = c.dataset.tag!;
      chips.forEach((x) => x.classList.toggle('is-active', x === c));
      apply();
    }),
  );
  search.addEventListener('input', apply);
</script>

<style>
  .block {
    scroll-margin-top: 12px;
  }
  .block + .block {
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }
  h2 {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .timeline {
    list-style: none;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 78px minmax(0, 1fr);
    gap: 12px;
    padding: 6px 0;
    border-bottom: 1px dotted var(--border);
    font-family: var(--font-serif);
    font-size: 12.5px;
    line-height: 1.5;
  }
  .timeline .year {
    font-size: 10px;
    padding-top: 2px;
  }
  .cite {
    margin-left: 6px;
    font-size: 10px;
    color: var(--muted);
    text-decoration: none;
  }
  .controls {
    display: grid;
    gap: 8px;
    margin-bottom: 10px;
    position: sticky;
    top: 0;
    background: var(--bg);
    padding: 6px 0 10px;
    z-index: 2;
    border-bottom: 1px solid var(--border);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
  }
  .seg {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 7px;
    cursor: pointer;
  }
  .seg:hover {
    color: var(--text);
    background: var(--border);
  }
  .seg.is-active {
    color: var(--text);
    background: var(--frame-bg);
    border-color: var(--frame-border);
  }
  .search {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 5px 9px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text);
    width: min(320px, 100%);
    outline: none;
  }
  .search:focus {
    border-color: var(--frame-border);
  }
  .entries {
    list-style: none;
  }
  .entries li {
    display: grid;
    grid-template-columns: 78px minmax(0, 1fr);
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 110px;
  }
  .entries li:target {
    background: linear-gradient(90deg, rgba(200, 120, 104, 0.1), transparent 70%);
  }
  .entries .year {
    font-size: 10px;
    color: var(--muted);
    padding-top: 2px;
  }
  .title {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 2px;
  }
  .title a {
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
  }
  .by {
    font-family: var(--font-serif);
    font-size: 11.5px;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .note {
    font-family: var(--font-serif);
    font-size: 12.5px;
    line-height: 1.5;
    margin-bottom: 3px;
    max-width: 760px;
  }
  .kind {
    font-size: 9px;
    color: var(--faint);
  }
  .empty {
    padding: 14px 0;
    font-size: 11px;
    color: var(--muted);
  }
  .contribute {
    margin-top: 18px;
    font-family: var(--font-serif);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .timeline li,
    .entries li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .controls {
      position: static;
    }
  }
</style>
