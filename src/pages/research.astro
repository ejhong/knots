---
import Doc from '../layouts/Doc.astro';
import data from '../data/sim/vessel.json';
import adaptData from '../data/sim/adapt.json';
import { refById } from '../data/references';
import { switchDiagram } from '../sim/draw';
import { knotSets, treeStory, type AdaptStudy, type TreeFigure } from '../sim/figures';
import { calibrate, type Params } from '../sim/vessel';
import guide from '../data/sim/guide.json';
import type { GuideIndex, TheoryIndex } from '../sim/guide/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/ejhong/knots/blob/main';
const p = data.params.values as unknown as Params;
const s = calibrate(p);
const r = data.robustness;
const v = data.validation;
const col = data.checks.collar;
const cool = data.checks.cooling;
const sc = data.scenarios as Record<string, { summary: { events: { t: number; to: string }[]; flow_after_open: number | null } }>;
const opened = (name: string) => sc[name].summary.events.find((e) => e.to === 'open')?.t ?? NaN;
const pressed = opened('press_and_release') - 150;
const afterEase = sc.stress_eases.summary.flow_after_open ?? 0;
const afterPress = sc.press_and_release.summary.flow_after_open ?? 0;
const tree = data.tree as unknown as { figure: TreeFigure & { u_m: number }; robustness: Record<string, number>; siblings: { siblings: number; shut_by_surge: number; shut_alone: number } };
const tr = tree.robustness;
const treeQueue = (data.tree as unknown as { queue: { drive: number[]; remain: number[]; parent_knot: boolean[] } }).queue;
const f2 = (x: number) => x.toFixed(2);
const pct = (x: number) => `${Math.round(100 * x)}%`;
const guessed = (data.params.vessel as { confidence: string }[]).filter((row) => row.confidence === 'guessed').length;
const sourced = (data.params.vessel as { confidence: string }[]).length - guessed;
const healthyRatio = s.Aopen / s.urest;
const ad = adaptData as unknown as AdaptStudy;
const setAt = (rows: { mult: number; hours: number | null }[], m: number) => rows.find((row) => Math.abs(row.mult - m) < 1e-9)?.hours ?? NaN;
const holdMult = ad.stories.hold_mult;
const setHealthy = setAt(ad.healthy.set_h, holdMult);
const hyFirst = ad.hypertensive.set_h.find((row) => row.hours !== null)!;
const oldKnot = ad.flushes.filter((row) => row.holds_at_rest).at(-1)!;
const adRob = ad.robustness;
const creep15 = ad.healthy.creep_h[0];

const cite = (id: string) => {
  const ref = refById(id);
  if (!ref) return id;
  const parts = ref.authors.split(',')[0].split(' et al')[0].trim().split(' ');
  const last = parts[parts.length - 1];
  const who = /^[A-Z]{1,3}$/.test(last) ? parts.slice(0, -1).join(' ') : last; // "Burton AC" or "Michael Edward Johnson"
  return `<a class="cite" href="${base}/library/#${id}">${who} ${ref.year}</a>`;
};

// The field guide: every theory run from its own physiology through the same scenes (sim/knots_sim/guide).
const g = guide as unknown as GuideIndex;
const trait = (th: TheoryIndex, key: string) => th.traits.find((x) => x.id === key);
const MARK: Record<string, string> = { all: '●', some: '◐', none: '○', silent: '—', not: '·' };
// Where the theories part: questions a hand or an instrument can ask, each answered by every model (its portrait's cell),
// the theories grouped by answer. Generated from the runs; nothing here is written per theory.
const TELLS: { key: string; q: string; ask: string }[] = [
  { key: 'record', q: 'What would a recording show at the moment one lets go?', ask: 'step 4' },
  { key: 'bump', q: 'What does a finger find?', ask: 'a hand, then step 2' },
  { key: 'where', q: 'Where do they sit?', ask: 'step 3' },
  { key: 'hand', q: 'Under a resting hand, when does it let go?', ask: 'step 1' },
  { key: 'attention', q: 'Does attention alone, without touch, let it go?', ask: 'step 1' },
  { key: 'spark', q: 'Is there a spark, and when?', ask: 'step 1' },
  { key: 'stiff', q: 'Does a stretch meet a block at the knot?', ask: 'step 1, then step 2' },
  { key: 'rolled', q: 'Rolled over, does it let go?', ask: 'step 1' },
  { key: 'warmth', q: 'Does heat, as in a hot shower or a sauna, free it?', ask: 'step 1' },
  { key: 'needs', q: 'What would a breath have to do (the least calming that frees the typical knot)?', ask: 'the field guide' },
  { key: 'time', q: 'Once the stress has gone, can an old knot stay?', ask: 'following knots over weeks' },
];
const answers = (key: string) => {
  const m = new Map<string, { th: TheoryIndex; mark: string }[]>();
  for (const th of g.theories) {
    const t = trait(th, key);
    if (!t) continue;
    if (!m.has(t.cell)) m.set(t.cell, []);
    m.get(t.cell)!.push({ th, mark: t.mark });
  }
  return [...m.entries()];
};
const names = (key: string, cell: string) =>
  g.theories.filter((th) => trait(th, key)?.cell === cell).map((th) => th.name.toLowerCase());
const cap = (w: string) => (w ? w[0].toUpperCase() + w.slice(1) : w);
const list = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}`);
const records = g.theories.map((th) => `${th.name.toLowerCase()}: ${trait(th, 'record')?.cell ?? '—'}`);
const handGroups = answers('hand').map(([cell, ths]) => `${cell}: ${list(ths.map((x) => x.th.name.toLowerCase()))}`);
const attGroups = answers('attention').map(([cell, ths]) => `${cell}: ${list(ths.map((x) => x.th.name.toLowerCase()))}`);

const repCell = (rid: string, id: string) => {
  const c = g.reports?.find((r) => r.id === rid)?.theories[id];
  return c && c.n ? `${c.k} of ${c.n}` : '—';
};
const KEY = new RegExp('\\(([a-z]+[0-9]{4}[a-z]?)\\)', 'g');
const t1stiff = (g.theories.find((t) => t.id === 'T1')?.traits.find((x) => x.id === 'stiff')?.text ?? '').replace(
  KEY,
  (m: string, id: string) => (refById(id) ? `(${cite(id)})` : m),
);
// Who could help: named from their published work, affiliations as their latest PubMed records give them (checked
// 28 Sep 2026). None has been approached; none is involved in, or has endorsed, this project.
const PEOPLE: { group: string; people: { who: string; where: string; what: string; refs: string[] }[] }[] = [
  {
    group: 'To record a release',
    people: [
      { who: 'Deborah Falla', where: 'University of Birmingham, Centre of Precision Rehabilitation for Spinal Pain', what: 'high-density EMG of the neck and shoulder in pain, down to single motor units of the upper trapezius', refs: ['dideriksen2016'] },
      { who: 'Dario Farina · Francesco Negro · Aleš Holobar', where: 'Imperial College London · University of Brescia · University of Maribor', what: 'decomposing surface EMG into single motor units: whether one falls silent at a release', refs: ['negro2016'] },
      { who: 'Matthieu Roustit', where: 'Université Grenoble Alpes, Inserm HP2', what: 'laser speckle imaging of skin blood flow, and how reproducible it is', refs: ['roustit2010'] },
      { who: 'Christopher Minson', where: 'University of Oregon', what: 'how skin blood flow is controlled, by heat and by nerves', refs: ['minson2001'] },
      { who: 'Harvey Mayrovitz', where: 'Nova Southeastern University', what: 'skin blood flow and the breath: the inspiratory gasp reflex', refs: ['mayrovitz2026'] },
      { who: 'Siddhartha Sikdar · Jay Shah', where: 'George Mason University · NIH Clinical Center', what: 'ultrasound, elastography and microdialysis of trigger points', refs: ['sikdar2009', 'shah2005'] },
      { who: 'Helene Langevin', where: 'NCCIH, National Institutes of Health (on her 2021 paper)', what: 'ultrasound of the fascial layers sliding: the measure for densification and the sleeve', refs: ['langevin2011'] },
      { who: 'Robert Schleip · Andreas Brandl', where: 'Technical University of Munich', what: "ultrasound and elastography of the back's fascia; fascia's water and stiffness", refs: ['schleip2012b'] },
      { who: 'Carla Stecco · Antonio Stecco', where: 'University of Padova · NYU Grossman School of Medicine', what: "the fascia's anatomy, its hyaluronan and the loose layer's ultrasound", refs: ['stecco2014', 'fede2018'] },
    ],
  },
  {
    group: "To check the models: each theory's own experts",
    people: [
      { who: 'Steven Segal', where: 'University of Missouri', what: 'small-artery networks and the responses conducted along them (perforators)', refs: ['segal1989'] },
      { who: 'Michel Saint-Cyr', where: 'Mayo Clinic Arizona', what: 'the territories of perforators (perforators)', refs: ['saintcyr2009'] },
      { who: 'Michael Edward Johnson', where: 'author of vasocomputation', what: 'the vascular latch, in its own terms (latch)', refs: ['johnson2023'] },
      { who: 'Robert Gerwin', where: 'Johns Hopkins School of Medicine', what: 'the trigger point and its energy crisis (trigger points)', refs: ['gerwin2004'] },
      { who: 'Mary Cowman · Philippe Coussot', where: 'NYU Tandon School of Engineering · Laboratoire Navier, Paris', what: "hyaluronan's viscosity; materials that jam and give way (densification, the sleeve)", refs: ['cowman2015', 'coussot2002'] },
      { who: 'Andrew Dilley', where: 'Brighton and Sussex Medical School', what: "inflamed nerves' sensitivity to pressure and stretch (nerves)", refs: ['dilley2005'] },
      { who: 'John Quintner · Milton Cohen · Geoffrey Bove', where: 'independent, Australia · independent, Australia · Maine', what: 'the nerve view of tender points (nerves)', refs: ['quintner1994', 'quintner2015'] },
      { who: 'Marc Scheltinga', where: 'Máxima Medical Centre, the Netherlands', what: 'cutaneous nerves entrapped at the fascia, and the local anaesthetic test (nerves)', refs: ['boelens2013'] },
      { who: 'Monica Gorassini · CJ Heckman', where: 'University of Alberta · Northwestern University', what: 'persistent inward currents in human motor neurons (the motor switch)', refs: ['gorassini1998', 'heckman2008'] },
      { who: 'Clifford Woolf', where: "Boston Children's Hospital and Harvard Medical School", what: 'central sensitisation (perception)', refs: ['woolf2011'] },
    ],
  },
  {
    group: 'For safety',
    people: [
      { who: 'Willoughby Britton · Jared Lindahl', where: 'Brown University', what: 'the Varieties of Contemplative Experience: the difficulties deep practice can bring', refs: ['lindahl2017'] },
    ],
  },
];

const index = [
  { id: 'summary', label: 'summary' },
  { id: 'part', label: 'where the theories part' },
  { id: 'suggest', label: 'what the models suggest' },
  { id: 'measurement', label: 'the measurement' },
  { id: 'physics', label: 'what physics allows' },
  { id: 'perforators', label: 'the perforators, up close' },
  { id: 'asks', label: 'what we need' },
  { id: 'method', label: 'method' },
  { id: 'further', label: 'the preprint, the pilot, who could help' },
];
---
<Doc
  title="Knots: an open problem, and the measurement that would settle it"
  kicker="For researchers"
  current="research"
  lede="People who work with the body find places that hold for years and let go in a breath. Seven mechanisms could explain them. Each is run as a model from its own physiology, to show how its knots would behave; and at the moment one lets go, each would leave a different trace."
  description="An open problem in physiology: what holds a knot, and what lets it go. Seven theories as models with measured numbers, where they part, what physics allows, and the measurements that would tell them apart."
  glyph="究"
  index={index}
  wide
>
  <section id="summary" class="sec full" data-glyph="要">
    <div class="abstract">
      <p class="label">Summary</p>
      <p>
        <strong>The problem.</strong> Bodyworkers and contemplative practitioners report knots: discrete places in the body
        that hold, sometimes for years, and let go within seconds, under a hand, with a slow breath or to attention, often
        with a tingle over the spot. Nothing about them has been recorded at the moment of release. At least seven
        mechanisms could explain them: a vessel held shut where it pierces the fascia, smooth muscle in the latch state, a
        myofascial trigger point, densified hyaluronan, a sensitised nerve, motor units that latch on, and perception.
      </p>
      <p>
        <strong>How it is approached.</strong> Each theory is written as a model in its strongest form, every parameter
        traced to a quoted line of a paper or marked as a guess, and run from its own physiology through the same scenes: a
        stressful moment, slow breathing, attention, a resting hand, rolling, an hour of moods, in {g.run.settings} settings
        of its uncertain numbers. What its knots would do is read off the runs, not fitted to anyone's reports. That is the{' '}
        <a href={`${base}/hypotheses/#watch`}>field guide</a>, on the Hypotheses page.
      </p>
      <p>
        <strong>What the models show.</strong> They part most at the moment of release. Each would leave a different trace:
        {' '}{records.join('; ')}. They part too in what a hand finds, whether a stretch meets a block, where knots sit, whether
        one lets go under a resting hand or only as it lifts, to a roller or to heat, and whether attention alone frees it
        (<a href="#part">below</a>).
      </p>
      <p>
        <strong>What they suggest.</strong> Set against practitioners' reports, the perforator model, with the sleeve of sliding
        tissue around each vessel, reproduces the most: release with a roller ({repCell('roller', 'T1')} settings), sparks
        ({repCell('spark', 'T1')}), stiffness ({repCell('stiff', 'T1')}), and larger knots freeing smaller ones but not the
        reverse. Knots that let go to attention alone point instead to the vascular latch ({repCell('attention', 'T2')}) or the
        motor switch. Perforators and latches are the same kind of muscle held in two ways, and knots may be more than one
        thing (<a href="#suggest">below</a>).
      </p>
      <p>
        <strong>What physics already says.</strong> A small artery with tone in its wall can hold itself shut, and, held an
        hour or two, its muscle adapts and the knot sets; a vessel pressed shut cannot reopen until the hand lifts, and
        releasing a parent vessel frees most of its children. Hyaluronan cannot hold a vessel shut, hardly changes with
        acidity, and thins only about 2% a degree with warmth; warming cannot release a knot within a breath; the latch
        saves energy but by itself does not remember; the sympathetic drive reaches a sensitised nerve only after about
        fourteen seconds.
      </p>
      <p>
        <strong>What would settle it.</strong> One recording at the moment a knot lets go, with the few instruments that
        tell those traces apart, after cheaper questions a hand can ask. <a href="#measurement">The ladder below</a>, and{' '}
        <a href="#further">a preprint, a one-page pilot and who could help</a> at the end.
      </p>
    </div>
  </section>

  <section id="part" class="sec full" data-glyph="別">
    <h2>Where the theories part</h2>
    <p class="sub">
      The same questions put to every model, and its answer, from the runs (● in every setting, ◐ in some, ○ in none, — the
      account says nothing). Where the answers differ in something a hand or an instrument can tell, that is a test. The
      first question separates all seven.
    </p>
    <div class="tells">
      {TELLS.map(({ key, q, ask }) => (
        <div class="tell">
          <p class="tq">{q} <span class="task mono">{ask}</span></p>
          <ul class="ta">
            {answers(key).map(([cell, ths]) => (
              <li>
                <span class="tcell">{cell}</span>
                <span class="tths">
                  {ths.map(({ th, mark }) => (
                    <a href={`${base}/hypotheses/#${th.key}`} title={`${th.name}: ${mark === 'all' ? 'in every setting' : mark === 'some' ? 'in some settings' : mark === 'none' ? 'in no setting' : 'the account says nothing'}`}>
                      <span class="mk">{MARK[mark]}</span> <span class="glyph">{th.glyph}</span> {th.name}
                    </a>
                  ))}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="caption">
      Every answer is a model's, from its own physiology and its sampled numbers; a model shows what a mechanism would do, not
      that it is what happens. The full portraits, and the films, are in the <a href={`${base}/hypotheses/#watch`}>field guide</a>.
    </p>
  </section>

  <section id="suggest" class="sec full" data-glyph="意">
    <h2>What the models suggest</h2>
    <div class="two">
      <div>
        <p class="find"><strong>More than one kind of knot.</strong> No model reproduces every report
          (<a href={`${base}/hypotheses/#reports`}>the reports against the models</a>). A perforator held shut, with its sleeve,
          accounts for the spark, the release as a hand lifts or a roller passes, stiffness, and larger knots freeing smaller ones; it
          lets go to attention alone in only {repCell('attention', 'T1')} settings, where the latch does in {repCell('attention', 'T2')}.
          The simplest reading is that practitioners meet at least two kinds, and a recording should classify each release rather than
          crown one theory.</p>
        <p class="find"><strong>Perforators and latches: one muscle, two holds.</strong> Both knots are vascular smooth muscle held
          contracted, and heat reaches both through the same number here. They differ in what holds them. A perforator is held by its
          wall's mechanics: over a band of tone both open and shut are stable, and once tone falls below the band the vessel opens, with
          a flood and a spark. The latch is held by information: a prediction that keeps its vessels clamped and the clamp that keeps
          the region out of awareness, so it lets go when noticed. They need not compete. A held prediction could be the command that
          keeps a perforator inside its band: such a knot would let go to attention and to a roller alike, and spark as it went. That
          combination is the next model to build.</p>
      </div>
      <div>
        <p class="find"><strong>Why knots stiffen.</strong> <Fragment set:html={t1stiff} /></p>
        <p class="find"><strong>Peeling and filling.</strong> Some describe the fascia beneath the skin peeling apart along lines,
          leaving places that feel hollow, and then a filling-in felt as re-stitching. The perforators suggest where to look: they and
          their sleeves are the stitches that tether the superficial fascia to the deep. If many sleeves free at once and the returning
          flood fills the gliding plane, the layers could part along the lines between tethers, and close again as the fluid is taken
          up and the sleeves re-hold. This is not yet modelled: the fascia as a system of its own is on the plan.</p>
      </div>
    </div>
  </section>

  <section id="measurement" class="sec full" data-glyph="験">
    <h2>The measurement that would settle it</h2>
    <p class="sub">
      Cheapest first. Each observes what already happens, at the usual pace; each step names the theories it would tell
      apart.
    </p>
    <ol class="steps">
      <li><strong>Noticing, with no instrument.</strong> When does a knot let go under a resting hand? {cap(handGroups.join('; '))}. Does attention alone, without touch, free it? {cap(attGroups.join('; '))}. Is there a tingle
        over the spot as it goes (perforators), a twitch (trigger points), or a tingle along a nerve's branches when it is
        pressed (nerves)? Does the skin slide over it (densification: not)? Does a stretch meet a block there, and does the block go
        with the knot or stay until the layer is moved (a perforator's sleeve can stay stuck)? Does it come back to the same point
        each time the stress returns (nerves, whose knots can sit only where a nerve pierces the fascia)?</li>
      <li><strong>Ultrasound over a few knots,</strong> with colour Doppler and a measure of the layers' sliding: in which
        layer a bump is (a trigger point's nodule, or a motor switch's band, in muscle); whether a perforator runs beneath
        (perforators, and nerves, which travel beside one); whether the layers glide over the spot (densification says they
        do not). The latch and perception predict nothing to see.</li>
      <li><strong>A Doppler map against blinded marks:</strong> do knots sit on perforators more than chance (perforators,
        nerves), on the zone where a muscle's nerve enters (trigger points), or wherever stress is held (the latch,
        densification, the motor switch, perception)?</li>
      <li><strong>The recording at release,</strong> with a button pressed at each felt release and a pressed sham beside
        it, since a press changes every place it presses. Laser speckle over the skin (the perforators' flood; the latch's
        slow rise); surface EMG that picks out single motor units (the motor switch's unit falling silent); elastography
        (a trigger point's stiffness falling in the muscle); ultrasound of the layers' sliding (densification's layers
        sliding again). A nerve's knot is silenced by a local anaesthetic at the point, as entrapped nerves of the abdominal
        wall are <Fragment set:html={`(${cite('boelens2013')})`} />. Perception predicts that nothing in the tissue changes.</li>
    </ol>
    <p class="caption">
      Any measurement with people belongs under the site's moderation guidance (see <a href={`${base}/about/#moderation`}>About</a>).
      None of this is a practice or a protocol.
    </p>
  </section>

  <section id="physics" class="sec full" data-glyph="理">
    <h2>What physics allows</h2>
    <p class="sub">
      Questions that numbers settle before any model runs: what a mechanism cannot do, whatever its settings.
    </p>
    <div class="checks">
      <article class="check">
        <p class="q">Can hyaluronan hold a vessel shut?</p>
        <p class="a">No.</p>
        <p set:html={`A liquid resists motion, not position. At its most viscous (healthy synovial fluid; ${cite('nicholls2018')}), in a collar 20 µm thin, its drag is ${Math.round(col.pressure_over_drag)} times weaker than the pressure holding the vessel open, and fascia holds tens to hundreds of times less hyaluronan (${cite('fede2018')}).`} />
      </article>
      <article class="check">
        <p class="q">Can acidity thicken hyaluronan?</p>
        <p class="a">Not in the body's range.</p>
        <p set:html={`Its flow hardly changes with pH, except near pH 2.5, where it turns gel-like, and above 12 (${cite('gatej2005')}); alone it does not gel (${cite('krause2001')}). A layer that jams is more than hyaluronan: crowded with immobility, or bound to proteins in inflammation (${cite('cowman2015')}).`} />
      </article>
      <article class="check">
        <p class="q">Can warmth free a densified layer?</p>
        <p class="a">Barely.</p>
        <p set:html={`Hyaluronan thins gradually with warmth, two- to threefold from 25 to 65 °C (${cite('cowman2015')}): about 2% a degree. A resting hand warms the layer beneath the fat by a fraction of that range; it would have to slide the layer instead.`} />
      </article>
      <article class="check">
        <p class="q">Can warming release a vessel within a breath?</p>
        <p class="a">No.</p>
        <p>A patch of skin warms with a time constant of at least {Math.round(cool.tau_s_at_max_flow)} s even at maximal skin blood flow. Release within a breath needs something faster than heat.</p>
      </article>
      <article class="check">
        <p class="q">Does the latch remember?</p>
        <p class="a">It economises.</p>
        <p set:html={`Relaxation follows the fall of calcium, not latch-bridge detachment (${cite('rembold1991')}): a latch holds cheaply while the drive lasts. In Johnson's account the memory lies elsewhere, in the held prediction that the clamp keeps from updating: the field guide runs that loop as <a href="${base}/hypotheses/#latch">the vascular latch</a>.`} />
      </article>
      <article class="check">
        <p class="q">Can a pressed vessel let go under the hand?</p>
        <p class="a">Not until it lifts.</p>
        <p>Pressure outside a shut vessel only helps keep it shut. After 40 s of pressure the vessel reopens {pressed.toFixed(1)} s after the pressure lifts, and flow returns from near nothing to {afterPress.toFixed(2)} of resting flow while drive stays raised ({afterEase.toFixed(2)} when stress eases instead).</p>
      </article>
      <article class="check">
        <p class="q">Can calm quiet a sensitised nerve within a breath?</p>
        <p class="a">Not through the sympathetic drive.</p>
        <p set:html={`In injured nerves, sympathetic activity changes ectopic firing only after about 14 s, and over tens of seconds (${cite('devor1994')}). A single out-breath is over before it arrives.`} />
      </article>
      <article class="check">
        <p class="q">Can pressing free a nerve's knot?</p>
        <p class="a">No: it excites it.</p>
        <p set:html={`An inflamed nerve's fibres fire when the site is pressed (${cite('dilley2005')}), and a hand's 20–80 mmHg is more than slows the blood leaving a nerve, 20–30 mmHg (${cite('rydevik1981')}).`} />
      </article>
    </div>
  </section>

  <section id="perforators" class="sec full" data-glyph="結">
    <h2>The perforators, up close</h2>
    <p class="sub">
      The first model and the most detailed: a perforator's small artery, with {sourced} parameters taken from or fitted to
      measurements and {guessed} guesses, each marked; it can be played with on <a href={`${base}/simulation/vessel/`}>its own bench</a>.
      Two things it shows that the field guide's scenes are too short for: how a knot sets over hours, and how a tree of
      vessels holds and lets go together.
    </p>
    <div class="physics">
      <figure class="ink-fig" set:html={switchDiagram(p, s)} />
      <div class="facts">
        <p class="fact"><span class="big">{f2(s.Aopen)}–{f2(s.Afold)}</span><span class="fl">the band of tone, as a share of maximal, over which a small artery is stable both open and shut (rest: {f2(s.urest)}). Above the band it snaps shut; once shut, it stays shut until tone falls below it. <Fragment set:html={cite('burton1951')} /> described the instability.</span></p>
        <p class="fact"><span class="big">{pct(r.share_bistable)}</span><span class="fl">of {r.samples.toLocaleString('en-GB')} plausible parameter sets give the switch; in {pct(r.share_holds_at_rest)} it holds even at resting tone. Whether it holds at rest turns mostly on two numbers, taken from measurements: how much force the muscle keeps as it shortens (<Fragment set:html={cite('mulvany1979')} />, rat small arteries) and the wall's thickness (<Fragment set:html={cite('schiffrin1995')} />, human subcutaneous small arteries).</span></p>
        <p class="fact"><span class="big">{v.gasp.at_s.toFixed(1)} s</span><span class="fl">when flow is lowest after a deep gasp, the one timing not fitted: measured 4.6–5.2 s <Fragment set:html={`(${cite('mayrovitz2026')})`} />. The fitted ones reproduce the gasp's size and recovery and the timing of reactive hyperaemia.</span></p>
      </div>
    </div>
    <h3 id="sleeve" class="h3">The sleeve: how a knot stiffens</h3>
    <p class="sub">
      Each perforator crosses the gliding plane in a sleeve of sliding tissue <Fragment set:html={`(${cite('guimberteau2005')})`} />,
      kept wet by the flow through it. Shut, the vessel lets its sleeve dry; hyaluronan's viscosity rises as the third or fourth
      power of its concentration <Fragment set:html={`(${cite('cowman2015')})`} />, and a material like the gliding layer jams below a
      critical stress <Fragment set:html={`(${cite('coussot2002')})`} />. <Fragment set:html={t1stiff} /> The drying and rebuilding
      times are guesses; the prediction to test is the order: the spark as the vessel opens, the sliding only once the layer is moved.
    </p>

    <h3 id="time" class="h3">Time: how a knot sets</h3>
    <p class="sub">
      The switch alone holds a knot only while tone stays {healthyRatio.toFixed(1)} times rest. But smooth muscle held at a new length adapts to it: it regains
      the force it lost there, as its optimal length moves toward the length it is held at{' '}
      <Fragment set:html={`(${cite('syyong2008')}; ${cite('pratusevich1995')}; ${cite('bednarek2011')})`} />. Arterioles held constricted for four hours no longer
      relax fully when the drive is removed <Fragment set:html={`(${cite('martinezlemus2004')}; ${cite('hill2003')})`} />; held for days, they remodel inward, and
      only if their muscle is active <Fragment set:html={`(${cite('bakker2002')})`} />. In this variant the muscle's optimum follows the length it is held at,{' '}
      {pct(ad.share)} of the way (fitted to the 73% of lost force that pulmonary arterial muscle regained), over about {ad.tau_h.toFixed(0)} h at full activation
      (bracketed by the arterioles: five minutes leaves no trace, four hours does). It belongs to any vessel held by its own muscle: the perforator's, and the
      latch's.
    </p>
    <figure class="paper-fig scroll-x" set:html={knotSets(ad)} />
    <div class="two">
      <div>
        <p class="find"><strong>A knot can set.</strong> Held shut at {holdMult}× resting tone, a knot holds at rest after {setHealthy.toFixed(1)} h: it outlasts
          the stress that made it. Held an hour, it lets go when stress ends; held three, it stays. With the walls of hypertension it can be held from{' '}
          {hyFirst.mult}× rest, and sets there in {(hyFirst.hours ?? NaN).toFixed(1)} h.</p>
        <p class="find"><strong>A set knot is harder to release.</strong> Fully adapted, it stays shut down to {f2(ad.healthy.adapted_aopen_over_rest)} of
          resting tone: calm alone no longer frees it. It needs drive below rest, pressure, or movement.</p>
        <p class="find"><strong>Old knots let go with a wave; young ones without.</strong> A set knot's muscle is weak at open lengths until it re-adapts, so
          released, the vessel opens to {oldKnot.peak_flow.toFixed(1)}× resting flow. A new knot's release brings flow back only to rest, and one released
          before it set reopens narrowed, as the lab's arterioles did after four hours.</p>
        <p class="find"><strong>Days make it structural.</strong> Three days of tone narrow the relaxed lumen by {Math.round(100 * ad.remodel.shrink)}% around
          the same wall <Fragment set:html={`(${cite('bakker2002')})`} />: that alone brings the hold from {ad.remodel.before.toFixed(1)}× to{' '}
          {ad.remodel.aopen_over_rest.toFixed(1)}× resting tone.</p>
      </div>
      <div class="tiles">
        <p class="tile"><span class="big">{setHealthy.toFixed(1)} h</span><span class="fl">held shut at {holdMult}× resting tone before a knot holds at rest</span></p>
        <p class="tile"><span class="big">{pct(adRob.share_sets)}</span><span class="fl">of plausible switches can set; {pct(adRob.share_sets_within)} within {adRob.within_h} h
          held midway up the band (median {(adRob.set_h[1] ?? NaN).toFixed(1)} h)</span></p>
        <p class="tile"><span class="big">{oldKnot.peak_flow.toFixed(1)}×</span><span class="fl">resting flow when an old knot lets go; a new one's, 1×</span></p>
        <p class="tile-note">{adRob.samples} settings: the adaptation's time and share, and the switch's own ranges, each sampled.</p>
      </div>
    </div>
    <p class="caption">
      What it does not show. With drive held steady, the model's open vessels creep shut under sustained tone ({(creep15.hours ?? NaN).toFixed(0)} h at{' '}
      {creep15.mult}× rest), but arterioles held at {Math.round(100 * ad.lab.diameter)}% of their diameter for four hours kept it, where the model's would have
      shut within {(ad.lab.shuts_h ?? NaN).toFixed(1)} h. In an open vessel adaptation seems to make holding cheaper, not narrower, and flow and metabolism push
      back <Fragment set:html={`(${cite('vanbavel2014')})`} />. A shut vessel has no flow, and the results above do not lean on what is missing. The blind
      test is the four-hour closure test, <a href="#asks">below</a>.
    </p>

    <h3 id="trees" class="h3">Trees: a parent and its children</h3>
    <p class="sub">
      Perforators branch: a parent vessel feeds children, and they share its pressure. Each vessel here is the same switch, with its own wall;
      pressures are solved at every step. The worked tree has walls as in hypertension (media 7.5–10% of the lumen) and drive raised to{' '}
      {tree.figure.u_m.toFixed(2)} of maximal tone; the tree's own numbers are guesses and are sampled below.
    </p>
    <figure class="ink-fig wide-fig scroll-x" set:html={treeStory(tree.figure)} />
    <div class="two">
      <div>
        <p class="find"><strong>One knot upstream makes a cluster below it.</strong> When a local surge shuts the parent, the pressure beneath it collapses and all
          four children snap shut within seconds.</p>
        <p class="find"><strong>Release the parent, and the cluster lets go together.</strong> The pressure surges back and three children open within a second.
          The thickest-walled one stays shut while stress stays raised: the next knot in the queue, which goes only when drive falls.</p>
        <p class="find"><strong>Siblings protect each other.</strong> On a shared feed, each closure raises the pressure holding the others open: a surge of
          stress shut {tree.siblings.shut_by_surge} of {tree.siblings.siblings}, where alone, at the same pressure, {tree.siblings.shut_alone} would. Clusters come from the tree's hierarchy, not from neighbours.</p>
        <p class="find"><strong>The higher the stress, the longer the queue.</strong> In the worked tree, the children left held after the parent lets go:{' '}
          {treeQueue.drive.map((u, i) => (treeQueue.parent_knot[i] ? `${treeQueue.remain[i]} at drive ${u.toFixed(2)}` : null)).filter(Boolean).join(', ')}.</p>
      </div>
      <div class="tiles">
        <p class="tile"><span class="big">{pct(tr.share_cluster)}</span><span class="fl">of plausible trees in which the parent held a knot: a cluster formed beneath it ({tr.mean_cluster.toFixed(1)} of 4 children on average)</span></p>
        <p class="tile"><span class="big">{pct(tr.share_cascade)}</span><span class="fl">in which releasing the parent freed most of its cluster within 5 s</span></p>
        <p class="tile"><span class="big">{pct(tr.share_queue)}</span><span class="fl">in which at least one child stayed held after the parent let go</span></p>
        <p class="tile-note">{tr.samples} trees: source and bed pressures, the parent's resistance, the children's walls and the drive, each sampled across its range.</p>
      </div>
    </div>

  </section>

  <section id="asks" class="sec full" data-glyph="願">
    <h2>What we need</h2>
    <ol class="asks">
      <li>
        <p class="ask-h">The force of a nearly shut small artery</p>
        <p>How much active force a small artery's muscle keeps at the very short lengths of a nearly shut vessel, and how thick its wall is, measured in
          human skin perforators or subcutaneous small arteries, young and old, with and without hypertension. The model takes them from rat arteries
          and healthy human walls, and they decide whether a knot can hold at ordinary tone.</p>
      </li>
      <li>
        <p class="ask-h">The four-hour closure test</p>
        <p>In a pressure myograph, shut a small artery with an agonist for five minutes, or for four hours, then lower the agonist to a resting level. If
          knots are vessels that set, the first reopens and the second stays shut, and when it is finally released it opens past its resting diameter.
          It is a day's work for a lab with a myograph, and it tests whether a knot can remember.</p>
      </li>
      <li>
        <p class="ask-h">How fast skin arterioles relax when sympathetic drive falls</p>
        <p>The time course of dilation after a brief sympathetic burst ends, over hairy skin (the back and neck, where knots are reported). It decides
          whether a vessel can let go in one breath or needs many. The gasp reflex itself is measured mostly on the fingers.</p>
      </li>
      <li>
        <p class="ask-h">The loose layer's give</p>
        <p>Whether the gliding layer between the fasciae of the upper back behaves as a material with a critical stress: rheometry of human loose
          connective tissue at the slow shears of ordinary movement, and how long it takes to rebuild at rest. With ultrasound of the layers' sliding
          (as measured in the back, <Fragment set:html={cite('langevin2011')} />) before and after a knot lets go, it would decide densification.</p>
      </li>
      <li>
        <p class="ask-h">The sleeve: do the layers stick where a perforator's flow stops?</p>
        <p>Ultrasound of the layers' sliding around a perforator's exit, with colour Doppler, while its flow is briefly reduced and
          after it returns: whether the layers stop sliding there, and how long they take to slide again, with and without moving
          the tissue. It would test how the perforator view makes knots stiff.</p>
      </li>
      <li>
        <p class="ask-h">A sensitised nerve and the sympathetic drive</p>
        <p>Whether a nerve of the skin that is sensitised where it pierces the fascia, but not injured, answers the sympathetic drive as injured nerves do,
          and how late <Fragment set:html={`(${cite('devor1994')})`} />; and whether knots sit at such piercings, as the tender points of the abdominal
          wall do <Fragment set:html={`(${cite('weum2016')})`} />.</p>
      </li>
      <li>
        <p class="ask-h">The latch's own constants, and a latched unit's squeeze</p>
        <p>How slowly a latched small artery relaxes once its command falls (the constants of <Fragment set:html={cite('hai1988')} />, measured in
          arteries); and how hard a few latched motor units squeeze a vessel that runs through the muscle beside them, the one number on which the motor
          switch with its vessel rests.</p>
      </li>
      <li>
        <p class="ask-h">The recording at release</p>
        <p>A laboratory with ultrasound, single-unit EMG or laser speckle, and a skilled practitioner, to make the recordings above; or the first of them
          alone.</p>
      </li>
      <li>
        <p class="ask-h">The proponents' eyes</p>
        <p>Each theory's model checked by those who hold it: the vascular latch, fascial densification, trigger points, peripheral nerve sensitivity, the
          motor switch and the perceptual account. Variants are welcome; so are objections.</p>
      </li>
      <li>
        <p class="ask-h">A physiologist or modeller as co-author</p>
        <p>For the preprint, and to keep the models honest.</p>
      </li>
    </ol>
    <p class="contact">Everything is open: <a href="https://github.com/ejhong/knots">the code and data</a>; objections and offers as{' '}
      <a href="https://github.com/ejhong/knots/issues">issues</a>.</p>
  </section>

  <section id="method" class="sec full" data-glyph="法">
    <h2>How it is made</h2>
    <div class="two">
      <div>
        <p class="find"><strong>Measured numbers, quoted.</strong> Every parameter has a source in the <a href={`${base}/library/`}>library</a>, the line it comes
          from quoted, and a confidence (measured, inferred, fitted or guessed); a script checks every quote word for word against the paper. Fitted values are
          fitted automatically to measured targets.</p>
        <p class="find"><strong>The models speak first.</strong> Each theory runs from its own physiology through the same scenes; what its knots would do is
          read off the runs. Nothing is fitted to anyone's reports, and a model can show only what a mechanism would do, never that it is what happens.</p>
      </div>
      <div>
        <p class="find"><strong>Written once, run everywhere.</strong> Each model is written once in Python; the browser runs its output, or code generated
          from it, held to the same trajectories by a test. Results are generated, never edited by hand, and each names its run.</p>
        <p class="find"><strong>Every setting, not one.</strong> Each scene runs across the plausible range of every uncertain number. A trait that holds in
          every setting is structural; one that holds in some says which number decides it, and so what to measure.</p>
      </div>
    </div>
    <p class="stamp mono">field guide run {g.run.inputs}{g.run.commit ? ` · commit ${g.run.commit}` : ''} · {g.run.settings} settings per theory · vessel model run {data.run.date} · inputs {data.run.inputs}</p>
    <p class="links mono">
      <a href={`${base}/hypotheses/#watch`}>the field guide</a>
      <a href={`${repo}/sim/PLAN.md`}>the plan</a>
      <a href={`${repo}/sim/knots_sim/models/`}>the seven models</a>
