---
import Doc from '../layouts/Doc.astro';
import { refById } from '../data/references';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const cite = (id: string) => {
  const ref = refById(id);
  if (!ref) return id;
  const parts = ref.authors.split(',')[0].split(' et al')[0].trim().split(' ');
  const last = parts[parts.length - 1];
  const who = /^\p{Lu}{1,3}$/u.test(last) ? parts.slice(0, -1).join(' ') : last; // "Burton AC" or "Michael Edward Johnson"
  return `<a class="cite" href="${base}/library/#${id}">${who} ${ref.year}</a>`;
};
// Who could help: named from their published work, affiliations as their latest PubMed records give them (checked
// 28 Sep 2026). None is involved in, or has endorsed, this project.
const PEOPLE: { group: string; people: { who: string; where: string; what: string; refs: string[] }[] }[] = [
  {
    group: 'For the experiments on knots',
    people: [
      { who: 'Deborah Falla', where: 'University of Birmingham, Centre of Precision Rehabilitation for Spinal Pain', what: 'high-density EMG of the neck and shoulder in pain, down to single motor units of the upper trapezius', refs: ['dideriksen2016'] },
      { who: 'Dario Farina · Francesco Negro · Aleš Holobar', where: 'Imperial College London · University of Brescia · University of Maribor', what: 'decomposing surface EMG into single motor units: whether one falls silent at a release', refs: ['negro2016'] },
      { who: 'Matthieu Roustit', where: 'Université Grenoble Alpes, Inserm HP2', what: 'laser speckle imaging of skin blood flow, and how reproducible it is', refs: ['roustit2010'] },
      { who: 'Christopher Minson', where: 'University of Oregon', what: 'how skin blood flow is controlled, by heat and by nerves', refs: ['minson2001'] },
      { who: 'Harvey Mayrovitz', where: 'Nova Southeastern University', what: 'skin blood flow and the breath: the inspiratory gasp reflex', refs: ['mayrovitz2026'] },
      { who: 'Siddhartha Sikdar · Jay Shah', where: 'George Mason University · NIH Clinical Center', what: 'ultrasound, elastography and microdialysis of trigger points', refs: ['sikdar2009', 'shah2005'] },
      { who: 'Helene Langevin', where: 'NCCIH, National Institutes of Health (on her 2021 paper)', what: 'ultrasound of the fascial layers sliding: the measure for densification and the sleeve', refs: ['langevin2011'] },
      { who: 'Robert Schleip · Andreas Brandl', where: 'Technical University of Munich', what: "ultrasound and elastography of the back's fascia; fascia's water and stiffness", refs: ['schleip2012b'] },
      { who: 'Carla Stecco · Antonio Stecco', where: 'University of Padova · NYU Grossman School of Medicine', what: "the fascia's anatomy, its hyaluronan and the loose layer's ultrasound", refs: ['stecco2014', 'fede2018'] },
    ],
  },
  {
    group: 'For safety',
    people: [
      { who: 'Willoughby Britton · Jared Lindahl', where: 'Brown University', what: 'the Varieties of Contemplative Experience: the difficulties deep practice can bring', refs: ['lindahl2017'] },
    ],
  },
];

// Experiments that might help, on the two open questions: what a knot is, and what runaway release is. Equally weighted, in
// the order the page shows them. docs/RESEARCHHUB.md (the draft call on ResearchHub) repeats their text: keep the two in step.
const EXPERIMENTS: { prong: string; title: string; what: string; show: string; needs: string }[] = [
  {
    prong: 'knots',
    title: 'Who can feel a knot',
    what: `Many people who foam-roll or do bodywork might be surveyed and interviewed: whether they can isolate single
      knots and feel them clearly, whether they can release them, how they learned, and what part the breath plays.
      Those who say they can might then be tested blind: do two of them find the same knots on the same back?`,
    show: `Whether finding and feeling knots is itself a skill, perhaps tied to the breath as releasing them seems to be,
      held by some and not by others. If so, the studies that locate or release knots would need to recruit those who
      have it.`,
    needs: `a survey and interview researcher · many people who foam-roll or do bodywork · a simple blind test`,
  },
  {
    prong: 'knots',
    title: 'Catch a knot as it lets go',
    what: `People who can release knots at will (bodyworkers, practitioners skilled with a foam roller, a ball or the
      breath) might release them in a laboratory while instruments watch the tissue: skin flow by laser speckle or a
      thermal camera, ultrasound with colour Doppler and the layers' sliding, surface EMG resolved to single motor
      units. A button could mark each felt release, with a spot pressed alike, without a knot, as the sham.`,
    show: `Each of the seven proposed mechanisms would, on its own account, leave a different trace at release, from a
      flood of flow to the skin to nothing in the tissue at all; a careful recording might begin to sort releases by
      kind.`,
    needs: `a laboratory with ultrasound and EMG or skin-flow imaging · a few skilled practitioners (experiment 1 might find
      them) · ethics review`,
  },
  {
    prong: 'runaway release',
    title: 'Examine someone in runaway release',
    what: `People already in runaway release might be examined while it runs and again as it settles: ultrasound of the
      fascial layers and their glide where change is felt and at matched places, colour Doppler of the perforators,
      skin-flow imaging, and the blood tests a physician would order. No one would be asked to begin or seek it, and
      their care would come first.`,
    show: `If the tissue is changing, the glide might differ at the reported places and settle on the clock the reports
      give; if only perception is changing, the tissue would likely look as it did.`,
    needs: `a clinician-researcher with imaging who knows meditation-related difficulty · a route to participants · a plan
      for referral · ethics review`,
  },
  {
    prong: 'runaway release',
    title: 'Characterise runaway release',
    what: `The case histories that fit its profile could be gathered, from published case reports, the record of
      meditation-related difficulty, teachers, clinicians and support services, and people who have been through it,
      or are in it now, interviewed with one set of questions: how it began and ran, its stages and regions, how long
      each took, what helped and what made it worse.`,
    show: `No study of it as such is known. A careful description might show whether it is one thing or several, how common
      it is, who is at risk and what helps, and might find the participants for experiment 3.`,
    needs: `a qualitative or clinical researcher, best with experience of meditation-related difficulty
      (${cite('lindahl2017')}; ${cite('cooper2021')}) · ethics review · support at hand for participants`,
  },
  {
    prong: 'knots',
    title: 'Where knots sit',
    what: `Two examiners who can isolate knots (experiment 1), blind to each other, might mark them over a region of the
      back, and a third, blind to the marks, map the perforators with a pencil Doppler, or with a thermal camera as
      the skin rewarms after a mild cold (${cite('weum2016b')}). The marks could then be set against the vessels at
      several distances, and against random and shifted maps.`,
    show: `Whether knots sit on perforators (as the perforator and nerve views expect), where a muscle's nerve enters
      (trigger points), or wherever stress is held (the other four). Perhaps the cheapest test of the perforator view:
      an afternoon's work.`,
    needs: `two examiners who can isolate knots · a pencil Doppler or thermal camera · a statistician`,
  },
  {
    prong: 'knots',
    title: 'Whether a knot is a stable thing',
    what: `Two examiners who can isolate knots might map the same people's knots, blind to each other and to earlier maps,
      with each person mapped again over weeks and months against their own map of perforators.`,
    show: `Whether examiners find the same knots at all, which may depend on their skill (experiment 1), and whether a
      person's knots return to fixed places (as the perforator and nerve views expect) or arise anywhere and drift.
      Much else may rest on the answer.`,
    needs: `two examiners who can isolate knots · a few people, each seen several times · a Doppler or thermal map`,
  },
  {
    prong: 'knots',
    title: 'What is already recorded',
    what: `Laboratories that study trigger points hold ultrasound, colour Doppler and elastography of tender spots,
      recorded for other questions (${cite('sikdar2009')}). Read again with the perforators in mind, these might say
      whether one runs beneath the spot, in which layer any bump lies, and whether the layers glide over it.`,
    show: `A first look, for the cost of the analysis: a bump in muscle would point toward a trigger point or the motor
      switch, a perforator beneath toward perforators or nerves, and layers that do not glide toward densification.`,
    needs: `access to existing recordings · someone who reads musculoskeletal ultrasound`,
  },
  {
    prong: 'knots',
    title: 'A small artery held shut for hours',
    what: `In a pressure myograph, a small artery, human if possible, might be shut with an agonist for five minutes or for
      four hours, and the agonist then lowered to a resting level.`,
    show: `Whether a vessel can remember. If knots are vessels that set, the first might reopen and the second stay shut,
      opening past its resting diameter when finally released; if the second reopens as fully as the first, that would
      count against vessels setting.`,
    needs: `a laboratory with a pressure myograph · small arteries · a day's work`,
  },
  {
    prong: 'knots',
    title: 'The breath and the skin of the trunk',
    what: `The breath's effects on skin flow, such as the brief narrowing of skin vessels with a deep breath, are measured
      mostly in the fingers. They could be measured over the back and neck, where knots are reported, with laser
      speckle: how far the vessels there narrow, and how fast they relax once the sympathetic drive falls.`,
    show: `Whether a vessel over the trunk could let go within one breath or would need many: timing that the vascular
      accounts, the perforators and the latch, depend on.`,
    needs: `laser speckle or laser Doppler · a physiology laboratory`,
  },
  {
    prong: 'knots',
    title: 'Acupoints on perforators',
    what: `Perforators might be mapped by thermal camera as the skin rewarms after a mild cold, and checked by Doppler,
      while practitioners mark the classical points by the WHO's proportional rules, out of the reader's sight. Or,
      from records: the channels could be laid over the CT angiograms taken before abdominal flap surgery, which
      record perforators by the thousand.`,
    show: `Whether the points sit on perforators more than chance would put them. On the five lines where both are measured
      they sit only a little nearer than random points: not shown, not excluded (<a
      href="${base}/research/points/">the evidence so far</a>).`,
    needs: `a thermal camera and Doppler · practitioners and a reader, blind to each other · a statistician`,
  },
];

const index = [
  { id: 'experiments', label: 'experiments that might help' },
  { id: 'further', label: 'the paper, who could help' },
];
---
<Doc
  title="Knots: an open problem, and ways to find out"
  kicker="For researchers"
  current="research"
  lede="People who work with the body find places that hold for years and let go in a breath. Here are ideas for experiments that might help find out what these knots are, and what runaway release is."
  description="An open problem in physiology: what a knot is, and what runaway release is. Ten ideas for experiments that might help, the position paper, and who could help."
  glyph="究"
  index={index}
  wide
>
  <section id="experiments" class="sec full" data-glyph="試">
    <h2>Experiments that might help</h2>
    <p class="sub">
      Two things are unexplained: what a knot is, and what runaway release is. Knots hold, sometimes for years, and let go
      within seconds, and nothing seems yet to have been recorded at the moment one lets go. Seven explanations have been
      proposed; each is set out at its strongest on the <a href={`${base}/hypotheses/`}>Hypotheses</a> page. Runaway release
      is a rarer process described by some who work forcefully and for long at clearing knots. Releases come in chains that
      cannot be set down; then the fascia is felt to peel, hollow and fill in again, in phases over days to weeks that recur
      over months or years (<a href={`${base}/research/perforator-hypothesis/#fascia`}>the position paper, Section 5</a>).
      Each experiment below might help with one or the other. They are ideas from a non-expert working with AI, in no order
      of importance. Those who know the methods should judge them and lead: change them, combine them, or set them aside for
      something better.
    </p>
    <p class="sub">
      Finding a knot may itself be a skill. Informal reports suggest that some who foam-roll cannot isolate single knots at
      all, while others feel and release them readily, perhaps through the breath. If so, studies that locate knots cannot
      assume that anyone can find one, which is why the first experiment asks who can.
    </p>
    <div class="exps">
      {EXPERIMENTS.map((x, i) => (
        <div class="exp" id={`experiment-${i + 1}`}>
          <span class="dk mono">{i + 1} · {x.prong}</span>
          <p class="dt">{x.title}</p>
          <p set:html={x.what} />
          <p><strong>What it might show.</strong> <Fragment set:html={x.show} /></p>
          <p class="need mono">Likely needs: <Fragment set:html={x.needs} /></p>
        </div>
      ))}
    </div>
    <p class="sub">
      Or one not listed here: anything that might help tell what a knot is, or what runaway release is.
    </p>
    <p class="caution">
      Runaway release can be prolonged and dangerous (<a href={`${base}/about/#moderation`}>Moderation</a>; the position paper,
      Section 9). Anyone struggling can find support from <a href="https://www.cheetahhouse.org">Cheetah House</a>; anyone
      thinking about suicide should reach out now: in the US, call or text 988; elsewhere, find a line at{' '}
      <a href="https://findahelpline.com">findahelpline.com</a>.
    </p>
    <p class="caption">
      Any study with people belongs under ethics review and the site's moderation guidance (see{' '}
      <a href={`${base}/about/#moderation`}>About</a>). None of this is a practice or a protocol.
    </p>
  </section>

  <section id="further" class="sec full" data-glyph="繋">
    <h2>The position paper, and who could help</h2>
    <div class="docs">
      <a class="doc-card" href={`${base}/research/perforator-hypothesis/`}>
        <span class="dk mono">position paper · Zenodo preprint</span>
        <span class="dt">The perforator hypothesis: knots as small arteries held shut where they pierce the fascia</span>
        <span class="dd">The case for one mechanism, from established physiology: what it explains and what it does not, the
          alternatives in their strongest forms, the fascia, the acupuncture points, the dangers, and what would refute it.</span>
      </a>
      <a class="doc-card" id="points" href={`${base}/research/points/`}>
        <span class="dk mono">a note · perforators and acupoints</span>
        <span class="dt">Are the perforators where the points are?</span>
        <span class="dd">Whether the major perforators come through the fascia in the same places in everyone, and whether the
          acupoints of Chinese medicine sit on them: the evidence, a test against chance, and a study that might decide it.</span>
      </a>
    </div>
    <p class="sub">
      The paper is a preprint, written by AI under the author's direction and not peer-reviewed, and the author will not take
      it to a journal. If, having weighed the alternatives, you think the perforator hypothesis is the best fit, take it up:
      test it, rework it, publish it (the paper is CC BY 4.0). If you think a rival theory fits better, the models, data and
      code are open to you too.
    </p>
    <p class="links mono"><a href={`${base}/research/perforator-hypothesis.pdf`}>position paper (PDF)</a><a href="https://doi.org/10.5281/zenodo.23901648">position paper (DOI)</a></p>
    <h3 class="h3">Who could help</h3>
    <p class="sub">Groups whose published methods bear directly on these experiments, named from their published work, with
      the places their latest PubMed records give. None has endorsed this project; they are where a laboratory or a co-author
      might most naturally come from.</p>
    {PEOPLE.map(({ group, people }) => (
      <div class="people">
        <p class="pg mono">{group}</p>
        <ul>
          {people.map((pp) => (
            <li>
              <span class="pw">{pp.who}</span> <span class="pl">{pp.where}</span>
              <span class="pd">{pp.what} <Fragment set:html={pp.refs.map((r) => cite(r)).join(' · ')} /></span>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <p class="contact">To take part, object, or point to someone missing: <a href="https://github.com/ejhong/knots/issues">issues</a>{' '}
      on the project's repository.</p>
  </section>
</Doc>

