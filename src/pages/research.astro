---
import Doc from '../layouts/Doc.astro';
import { refById } from '../data/references';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const cite = (id: string) => {
  const ref = refById(id);
  if (!ref) return id;
  const parts = ref.authors.split(',')[0].split(' et al')[0].trim().split(' ');
  const last = parts[parts.length - 1];
  const who = /^\p{Lu}{1,3}$/u.test(last) ? parts.slice(0, -1).join(' ') : last; // "Burton AC" or "Michael Edward Johnson"
  return `<a class="cite" href="${base}/library/#${id}">${who} ${ref.year}</a>`;
};
// Older anchors: the position paper cites research/#points (perforators and acupoints), and until 14 Nov the list was
// #experiments and its cards #experiment-N.
const ALIAS: Record<string, string> = { 'Acupoints on perforators': 'points' };

// Studies that might help, on the two open questions: what a knot is, and what runaway release is. Grouped by where each
// looks (STAGES: what is felt and by whom; knots in the living; other places to look, which are records, cadavers and
// animals; two particular ideas; runaway release) and listed in the order they build on one another, not by importance,
// each with the kind of study it would be. docs/RESEARCHHUB.md (the draft call on ResearchHub) lists the studies by number, title and kind, in this order,
// and points here for their text; it repeats the ask for letters of intent (#respond: what a letter holds, how letters
// are weighed, what happens next) and the care rule. Keep the two in step.
// Runaway release (the author, 22 Nov 2026): letters are asked for on study 12, which describes it and can begin with
// one or two people who might be introduced, with their agreement; study 13 is limited to those one or two, and no one
// is recruited for it. Studies 1 and 12, which begin with what people report, are named as a likely place to start.
// The same day the author asked for a plainer first study (what people who foam-roll feel), with whether another hand
// can feel a knot as a study of its own; for the two studies of vascular mechanism (a small artery held shut for
// hours; the breath and the skin of the trunk) to go; and for the post-mortem study not to depend on knots marked in
// life; and, later that day, for the study of whether a knot is a stable thing to go. Thirteen studies: 1 to 11 on
// knots, 12 and 13 on runaway release.
const STUDIES: { stage: string; prong: string; title: string; design: string; what: string; show: string; needs: string }[] = [
  {
    stage: 'finding-knots',
    prong: 'knots',
    title: 'What people who foam-roll feel',
    design: `Survey and phenomenological interviews`,
    what: `Many who foam-roll, or work on their own bodies in other ways, might simply be asked what they feel, in their
      own words first and then with set questions. Do they feel knots at all, and if so as distinct bumps or only as
      broad, dull areas? Where? Are the bumps there all the time, or only when pressed, attended to or breathed with?
      How firmly must they press to find one? Can they release them, and how did they learn? What does a release feel
      like, and what follows it, from nothing to relief, well-being, tears or euphoria? How often, and do many knots
      ever let go at once, or have releases ever run on in chains that could not be set down (study 12)? Has anyone
      else, a partner or a bodyworker, felt the same bumps? And what part does the breath play, in finding knots as
      well as in releasing them? Bodyworkers might be asked the same about the knots they feel in others.`,
    show: `How much people's experience differs. Informal reports suggest that some feel single knots and release them
      readily, while others feel only dull masses, or nothing; and that feeling knots may itself be a skill, perhaps
      tied to the breath as releasing them seems to be. How common a felt release is among people who roll, and the
      feeling that can follow it, is not known; the survey would give a first estimate, would show what the later
      studies should ask, and would find the people who have the knots meant here. Asked of everyone, the question on
      chains would say how common they are among people who roll, and might find people for study 12.`,
    needs: `a survey and interview researcher · many people who foam-roll, and bodyworkers`,
  },
  {
    stage: 'finding-knots',
    prong: 'knots',
    title: 'Whether another hand can feel a knot',
    design: `Blinded reliability study (test–retest and inter-rater)`,
    what: `Two questions, which may have different answers: can people find their own knots again, and can others feel
      them too? A knot might be felt only by its owner, or by a hand from outside as well. Among people who say they
      feel knots (study 1), each might mark the knots they feel, blind to the other marks: the person their own,
      twice, an hour apart, and two examiners by touch, with the breath the person uses to feel them, if they use
      one. Which knots does each find, and do they agree? And as a person lets a knot go under an examiner's resting
      finger, does the examiner feel the bump go too?`,
    show: `Whether the knots a person feels in themselves can be felt by others too, or only from inside. Someone
      pressing their own knot feels it twice over, with the finger and in the place pressed, and cannot easily tell
      the two apart; an examiner's finger has only the first. If feeling knots is a skill, studies that locate or
      release knots would need to recruit those who have it; if bumps stand out only with a trained breath, an
      examiner might find none in a body at rest; and if only their owners can feel them, later studies would have
      to rely on the owners' own marks.`,
    needs: `people who feel their own knots (study 1) · two examiners, such as bodyworkers · simple blind tests`,
  },
  {
    stage: 'with-knots-found',
    prong: 'knots',
    title: 'What an instrument finds where a knot is felt',
    design: `Blinded comparison: felt knots against matched spots, before and after release`,
    what: `At spots where people feel a knot (studies 1 and 2), and at matched spots nearby, instruments might look,
      each blind to which is which: ultrasound for a bump, a vessel beneath and the layers' glide, with colour
      Doppler and elastography; a pencil Doppler listening for a vessel and its flow; and a thermal camera watching
      the skin rewarm after a mild cold (${cite('weum2016b')}). Each might look twice: while the knots hold, and again once
      their owners have released them by their usual means.`,
    show: `Whether there is anything at a felt knot that an instrument can see, and what. Each account expects something
      different. A Doppler and a thermal camera see a vessel only by the blood moving in it, so a vessel held shut
      would be silent while a knot holds and sound once it lets go (perforators). Ultrasound might show fluid or
      swollen veins, a firm place where the layers do not glide (densification), or a nodule in muscle (trigger
      points, the motor switch). Or there may be nothing to see (perception). If an instrument can tell a knot from
      a matched spot, later studies need not depend on who can feel one.`,
    needs: `ultrasound with colour Doppler and elastography · a pencil Doppler · a thermal camera · people who feel
      their own knots (studies 1 and 2)`,
  },
  {
    stage: 'with-knots-found',
    prong: 'knots',
    title: 'Catch a knot as it lets go',
    design: `Sham-controlled laboratory physiology, with felt releases marked as they happen`,
    what: `People who can release knots at will (bodyworkers, practitioners skilled with a foam roller, a ball, a trained
      breath or attention) might release them in a laboratory while instruments watch the tissue: skin flow by laser
      speckle or a thermal camera, ultrasound with colour Doppler and the layers' sliding, surface EMG resolved to
      single motor units. The breath might be recorded too, with its carbon dioxide, since a run of strong or quick
      out-breaths lowers it and can cause tingling by itself. A button could mark each felt release, with a spot
      pressed alike, without a knot, as the sham. After each, the person might say what followed, from nothing to
      relief, well-being or tears, and how many knots seemed to go; and the range of a stretch that the area limits
      might be measured before and after, on that side and on the other. No one would be taught a breath, or asked
      to press, breathe or work harder or longer, or to release more knots, than they usually do.`,
    show: `Each of the seven proposed mechanisms would, on its own account, leave a different trace at release, from a
      flood of flow to the skin to nothing in the tissue at all, only changes that follow the breath; a careful
      recording might begin to sort releases by kind. It might also show whether the feeling that follows a release
      comes without a roller's pain and its hard, repeated out-breaths as well, since relief, even when an expected
      pain simply does not come, is itself felt as pleasant (${cite('leknes2011')}); whether it grows with how much
      lets go; and whether the dull block eases as an area's knots let go, on the worked side alone or on both.`,
    needs: `a laboratory with ultrasound and EMG or skin-flow imaging, and a capnograph · a few skilled practitioners (study
      1 might find them) · ethics review`,
  },
  {
    stage: 'with-knots-found',
    prong: 'knots',
    title: 'Where knots sit',
    design: `Blinded mapping, with spatial statistics against chance`,
    what: `Knots might be marked over a region of the body in two ways, or both (study 2): by two examiners who can feel
      knots in others, blind to each other, or by people who can isolate their own, with the breath they use to feel
      them, if they use one. A third person, blind to the
      marks, might map the perforators with a pencil Doppler, or with a thermal camera as the skin rewarms after a
      mild cold (${cite('weum2016b')}), and map them again once the marked knots have been released by their owners'
      usual means, with comfortable pressure. Those who use a breath to release their knots would use it as they
      already do; no one would be taught a breath, or asked to press, breathe or work harder or longer than usual.
      Both instruments see a vessel only by its flow, so a perforator held shut would be faint or missing on the
      first map. Knots that do not let go would be left, and
      not counted. The marks could then be set against the vessels of each map at several distances, and against
      random and shifted maps.`,
    show: `Whether knots sit at perforators, and in what state. On the perforator view a held knot lies where the first
      map is empty and the second shows a vessel; on the nerve view its perforator sounds throughout. Or knots may lie
      where a muscle's nerve enters (trigger points), or wherever stress is held (the other four). Marked both ways,
      it would also show whether people's own marks and an examiner's agree. Perhaps the cheapest test of the
      perforator view: an afternoon's work.`,
    needs: `examiners who can feel knots in others, or people who can isolate their own · a pencil Doppler or thermal camera
      · a statistician`,
  },
  {
    stage: 'with-knots-found',
    prong: 'knots',
    title: 'Whether knots grow with age',
    design: `Epidemiology: cross-sectional across ages, then a cohort followed over years`,
    what: `Knots might be counted and sized in people of all ages, from childhood to old age, and in the same people over
      years: by their own marks and by examiners (study 2), and by whichever instrument proves best (study 3). People
      might also be asked when their knots first appeared and how they have changed.`,
    show: `Whether knots grow larger and more numerous with age, and whether children are nearly free of them. The accounts
      part here: perforators, densification and nerves expect knots to rise with age (the first, in number and size);
      latches accumulate from early childhood; trigger points follow overload and injury; the motor switch remembers
      nothing by itself; perception follows history more than age.`,
    needs: `examiners or an instrument (studies 2 and 3) · people of all ages · a statistician`,
  },
  {
    stage: 'elsewhere',
    prong: 'knots',
    title: 'What is already recorded',
    design: `Secondary analysis of existing recordings`,
    what: `Laboratories that study trigger points hold ultrasound, colour Doppler and elastography of the spots they
      examine, recorded for other questions (${cite('sikdar2009')}). Read again with the perforators in mind, these
      might say whether one runs beneath the spot, in which layer any bump lies, and whether the layers glide over it.
      Surgeons hold another record. Before a flap of skin is moved, its perforators are mapped by CT angiography or
      Doppler, which show a vessel only by the blood in it, and at the operation the surgeon sees them directly.`,
    show: `A first look, for the cost of the analysis: a bump in muscle would point toward a trigger point or the motor
      switch, a perforator beneath toward perforators or nerves, and layers that do not glide toward densification.
      But trigger points are found by tenderness in a taut band, and knots seldom hurt unless pressed hard, so the
      recordings may show other things than knots; latent trigger points, painless until pressed, may be the nearest.
      The surgeons' records might say how often a perforator found at operation had been missed by the map before it:
      a ceiling on how many large perforators were shut when scanned yet found at operation. In the lower abdomen it
      is low: in one blinded series the scan missed one of 280 (${cite('rozen2008')}). Other regions might differ: knots
      are said to be densest around the hips and shoulders.`,
    needs: `access to existing recordings · someone who reads musculoskeletal ultrasound · a plastic surgery unit's maps
      and operative records`,
  },
  {
    stage: 'elsewhere',
    prong: 'knots',
    title: 'What cadavers show',
    design: `Anatomy and histology: existing dissection and post-mortem records, then dissection where knots are commonly
      reported`,
    what: `Knots need not have been marked in life. Anatomists and pathologists hold records and tissue from dissections
      and post-mortem examinations, made for other questions, which could be read again for clues. And cadavers
      could be examined where knots are commonly reported, around the hips and shoulders and over the upper back,
      and where they seldom are: the perforators' walls and lumens where they pass the fascia, the fascial layers
      and the tissue between them, the muscle and the nerves, by dissection and under the microscope. Bodies of
      different ages could be compared, since knots are said to gather with age.`,
    show: `Whether anything structural marks the places where knots are common. A vessel narrowed by long holding, a
      thickened or stiffened layer, an entrapped nerve or changed muscle would each point to the accounts that
      expect them; holds kept only by the nervous system (the motor switch, perception) would likely leave nothing,
      and so might any state that is held only in life. It could not show that a given spot was a knot, only what
      there is to find where knots are said to be.`,
    needs: `an anatomist or pathologist · existing records and tissue, or a body donation programme · ethics review`,
  },
  {
    stage: 'elsewhere',
    prong: 'knots',
    title: 'Whether animals have knots',
    design: `Comparative (veterinary): a survey, examination by instrument, and opportunistic necropsy`,
    what: `Veterinarians and animal bodyworkers might be asked whether they find knots in horses, dogs or other animals,
      and where; with their owners' consent, the spots might be examined with the instruments of study 3. Where an
      animal that had them dies or is put down for other reasons, the tissue beneath might be examined too (as in study 8).
      No animal would be harmed for the study.`,
    show: `Whether knots are something mammals share, as most of the accounts would expect, since animals have the same
      vessels, fascia, muscle and nerves; and a route to the tissue beneath a knot that was felt in life.`,
    needs: `veterinarians or animal bodyworkers · a pencil Doppler or ultrasound · ethics review`,
  },
  {
    stage: 'any-time',
    prong: 'knots',
    title: 'Acupoints on perforators',
    design: `Blinded mapping against chance, or a retrospective study of CT angiograms`,
    what: `Perforators might be mapped by thermal camera as the skin rewarms after a mild cold, and checked by Doppler,
      while practitioners mark the classical points by the WHO's proportional rules, out of the reader's sight. Or,
      from records: the channels could be laid over the CT angiograms taken before abdominal flap surgery, which
      record perforators by the thousand.`,
    show: `Whether the points sit on perforators more than chance would put them. On the five lines where both are measured
      they sit only a little nearer than random points: not shown, not excluded (<a
      href="${base}/traditions/#points">the evidence so far</a>).`,
    needs: `a thermal camera and Doppler · practitioners and a reader, blind to each other · a statistician`,
  },
  {
    stage: 'any-time',
    prong: 'knots',
    title: 'Whether vasomotion stops in deep meditation',
    design: `Laboratory physiology with first-person event marking: fNIRS or fMRI, and laser Doppler flowmetry`,
    what: `Vasocomputation proposes that held predictions are held vascular tension: a contraction of the smooth muscle
      around a vessel stores a prediction and, held long enough, latches (${cite('johnson2023')}). It predicts that
      vasomotion, the slow rhythm of the vessels' tone, nearly stops in deep meditative cessations. In meditators who
      report cessations, moments in which experience is said to stop, vasomotion might be recorded as they sit as
      usual: in the brain by fNIRS or fMRI, and in the skin over a knot and at a matched spot by laser Doppler, with
      each cessation marked as it is reported.`,
    show: `Whether the vessels follow the deepest meditative states, as the account predicts; a rhythm unchanged through
      cessations would count against it. Recorded over a knot too, it might show whether the vessels there take part.`,
    needs: `a meditation research laboratory · meditators who report cessations · fNIRS or fMRI, and laser Doppler`,
  },
  {
    stage: 'runaway-release',
    prong: 'runaway release',
    title: 'Characterise runaway release',
    design: `Phenomenology and natural history: a search of what is already recorded, semi-structured interviews and a
      case series`,
    what: `It might begin with interviews: one or two people who know runaway release at first hand might be
      introduced, with their agreement, and this part depends on that agreement. Once their accounts give a profile,
      others might be found in what is already recorded: published case reports, and the
      interviews gathered in studies of meditation-related difficulty, which could be read again with this in mind;
      and through teachers, clinicians and support services. No one else calls it runaway release, so the search
      needs other names: those studies describe currents of energy and involuntary movement
      (${cite('lindahl2017')}) and energy-like somatic experiences (${cite('cooper2021')}), and some of what they
      describe may be this process. The net might be cast wider than the two reports' profile, for any long bodily
      process of release that could not be set down, since a search for the profile alone would find only what it
      looks for. Each person might be asked, with the researchers' own questions: how it began and ran, its stages
      and regions, how long each took, what could be seen, what helped and what made it worse.`,
    show: `It rests so far on two informal reports, and no study of it as such is known. A careful description might show
      whether others describe it too, and under what names; whether it is a syndrome, one recognisable
      pattern that a case definition could capture, or several things; how common it is, who is at risk and what
      helps. Accounts taken by researchers, with their own questions, would also be independent of this project,
      whose perforator view grew from the two reports. And it might say where and when to look, and find the
      participants, for study 13.`,
    needs: `a qualitative or clinical researcher, best with experience of meditation-related difficulty · ethics review
      · support at hand for participants`,
  },
  {
    stage: 'runaway-release',
    prong: 'runaway release',
    title: 'Examine someone in runaway release',
    design: `Observational: case studies with repeated imaging, then a prospective case series`,
    what: `People already in runaway release might be examined while it runs and again as it settles: ultrasound of the
      fascial layers and their glide where change is felt and at matched places, colour Doppler of the perforators,
      skin-flow imaging, photographs of any skin that weeps or crusts, and the blood tests a physician would order. No one would be asked to begin or seek it, and
      their care would come first. For now it is limited to the one or two people who might be introduced (study 12), and who may define the profile,
      if they are willing: no one is recruited for it. A laboratory already measuring knots (studies 3 and 4) has
      the instruments and could add it.`,
    show: `If the tissue is changing, the glide might differ at the reported places and settle on the clock the reports
      give; if only perception is changing, the tissue would likely look as it did. Skin that weeps where knots let go,
      and not where it was rubbed, would show a change in the tissue itself. The process runs its course, so a
      record can be made only while it runs: dated images, taken where change is felt and at matched places, would
      keep what could not be gathered later, even before anyone knows how to read them.`,
    needs: `ultrasound with colour Doppler, and skin-flow imaging · a clinician who knows meditation-related
      difficulty · one or two people, by introduction · a plan for referral · ethics review`,
  },
];
const STAGES: { id: string; title: string; intro: string }[] = [
  {
    id: 'finding-knots',
    title: 'First: what is felt, and by whom',
    intro: `Feeling a knot may itself be a skill, and a knot that its owner feels may or may not be one that others can
      feel. Informal reports suggest that some who foam-roll can isolate a single knot, felt as a distinct bump, and
      release it readily, perhaps through a trained breath that may also help to find it, while others never feel
      single knots at all, only broad, dull masses. The bumps and the dull masses may be one thing: an area with
      many knots is felt more as a dull block, and a trained breath may be needed to feel its knots as distinct
      bumps and to release them. If
      so, studies that locate or release knots cannot assume that anyone can find one, in themselves or in others,
      or that a bump is there for a hand to find in a body at rest. So these two come first: what people who roll
      feel, and whether another hand can feel a knot.`,
