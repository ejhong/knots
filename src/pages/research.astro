---
import Doc from '../layouts/Doc.astro';
import data from '../data/sim/vessel.json';
import exam from '../data/sim/exam.json';
import adaptData from '../data/sim/adapt.json';
import matrixData from '../data/sim/matrix.json';
import aimedData from '../data/sim/aimed.json';
import instrumentData from '../data/sim/instrument.json';
import { refById } from '../data/references';
import { switchDiagram } from '../sim/draw';
import { cellMark, countsStrip, decisionTree, fieldPanels, knotSets, leastMovement, recordings, releaseMap, treeStory, type AdaptStudy, type BreathMaps, type Cell, type FieldStudy, type InstrumentStudy, type Matrix, type TreeFigure } from '../sim/figures';
import { calibrate, type Params } from '../sim/vessel';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/ejhong/knots/blob/main';
const p = data.params.values as unknown as Params;
const s = calibrate(p);
const r = data.robustness;
const v = data.validation as typeof data.validation & { squeeze: Record<string, { rise: number; peak_s: number; measured: { rise: number; peak_s: number } }> };
const col = data.checks.collar;
const cool = data.checks.cooling;
const sc = data.scenarios as Record<string, { summary: { events: { t: number; to: string }[]; peak_flow: number; peak_spark: number; flow_after_open: number | null } }>;
const opened = (name: string) => sc[name].summary.events.find((e) => e.to === 'open')?.t ?? NaN;
const pressed = opened('press_and_release') - 150;
const eased = opened('stress_eases') - 110;
const afterEase = sc.stress_eases.summary.flow_after_open ?? 0;
const afterPress = sc.press_and_release.summary.flow_after_open ?? 0;
const breath = data.breath as unknown as BreathMaps;
const tree = data.tree as unknown as { figure: TreeFigure; robustness: Record<string, number>; siblings: { siblings: number; shut_by_surge: number } };
const tr = tree.robustness;
const fieldData = data.field as unknown as FieldStudy & { conditions: Record<string, { depth_vs_time: number }> };
const fc = fieldData.conditions;
const f2 = (x: number) => x.toFixed(2);
const pct = (x: number) => `${Math.round(100 * x)}%`;
const guessed = (data.params.vessel as { confidence: string }[]).filter((row) => row.confidence === 'guessed').length;
const sourced = (data.params.vessel as { confidence: string }[]).length - guessed;
const need10 = breath.least_movement.within_10;
const wallRows = data.wall_sensitivity as { media_to_lumen: number; Aopen: number; Afold: number; urest: number }[];
const wallAt = (ml: number) => wallRows.find((row) => Math.abs(row.media_to_lumen - ml) < 1e-9)!;
const healthyRatio = s.Aopen / s.urest;
const hyper = wallAt(0.08);
const closureRows = data.closure_sensitivity as { xc: number; Aopen: number; urest: number; bistable: boolean }[];
const tight = closureRows[0];
const ad = adaptData as unknown as AdaptStudy;
const setAt = (rows: { mult: number; hours: number | null }[], m: number) => rows.find((row) => Math.abs(row.mult - m) < 1e-9)?.hours ?? NaN;
const holdMult = ad.stories.hold_mult;
const setHealthy = setAt(ad.healthy.set_h, holdMult);
const hyFirst = ad.hypertensive.set_h.find((row) => row.hours !== null)!;
const oldKnot = ad.flushes.filter((row) => row.holds_at_rest).at(-1)!;
const adRob = ad.robustness;
const creep15 = ad.healthy.creep_h[0];
const treeQueue = (data.tree as unknown as { queue: { drive: number[]; remain: number[]; parent_knot: boolean[] } }).queue;
const deepest = need10[need10.length - 1];
const easing = (data.breath as unknown as { easing: { swing: number; rows: { tau_down: number; fitted: boolean; release_s: (number | null)[] }[] } }).easing;
const easeFitted = easing.rows.find((row) => row.fitted)!;
const easeFast = easing.rows.find((row) => Math.abs(row.tau_down - 3) < 1e-9)!;
const depthAt = (d: number) => breath.depths.indexOf(d);

const cite = (id: string) => {
  const ref = refById(id);
  if (!ref) return id;
  const who = ref.authors.split(',')[0].split(' et al')[0].replace(/\s+\S+$/, '');
  return `<a class="cite" href="${base}/library/#${id}">${who} ${ref.year}</a>`;
};

type Obs = { id: string; group: string; title: string; text: string; evidence: string; note?: string; sources?: string[] };
const groups = exam.groups as { id: string; label: string }[];
const obs = exam.observations as Obs[];

// The exam: every modelled theory through the same trials (src/data/sim/matrix.json, from `knots_sim.exam`).
const mx = matrixData as unknown as Matrix;
const ROWS: { glyph: string; key: string; name: string; id?: string; why?: string }[] = [
  { glyph: '結', key: 'perforator', name: 'Perforators', id: 'T1' },
  { glyph: '閂', key: 'latch', name: 'Vascular latch', why: 'next: it shares the switch; the latch needs the Hai–Murphy rate constants' },
  { glyph: '点', key: 'trigger-point', name: 'Trigger points', id: 'T3' },
  { glyph: '膠', key: 'densification', name: 'Densification', why: 'to model: the layers’ glide, and hyaluronan thinning as they move' },
  { glyph: '神経', key: 'nerve', name: 'Nerves', why: 'to model: a sensitised nerve where it pierces the fascia' },
  { glyph: '覚', key: 'central', name: 'Perception', id: 'T6' },
];
const mxTheory = (id?: string) => mx.theories.find((t) => t.id === id);
const obsTitle = Object.fromEntries(obs.map((o) => [o.id, o.title]));
const partGroups = mx.parts.reduce<{ obs: string; parts: typeof mx.parts }[]>((acc, part) => {
  const last = acc.at(-1);
  if (last && last.obs === part.obs) last.parts.push(part);
  else acc.push({ obs: part.obs, parts: [part] });
  return acc;
}, []);
const nSets = mx.trials.samples;
const notRunWhy = Object.fromEntries(mx.parts.map((part) => [part.id, part.not_run ?? null]));
const cellText = (t: { name: string; samples: number; notes: Record<string, string> }, pid: string, says: string, c: Cell, tested?: number | null) => {
  const note = t.notes[pid] ? ` ${t.notes[pid]}` : '';
  if (c === 'silent') return `${pid} ${says}: ${t.name} is silent: its account says nothing about this.${note}`;
  if (c === 'not run') return `${pid} ${says}: not run yet${notRunWhy[pid] ? ` (${notRunWhy[pid]})` : ''}.${note}`;
  const k = Math.round(c * t.samples);
  const ran = tested === undefined || tested === null ? '' : ` The trial ran (its knot held, then let go) in ${Math.round(tested * t.samples)} of them.`;
  return `${pid} ${says}: holds in ${k} of ${t.samples} plausible settings (${Math.round(100 * c)}%).${ran}${note}`;
};
const bestShare = (t: (typeof mx.theories)[number], pid: string) => {
  const vals = t.variants.map((v) => v.cells[pid]).filter((c): c is number => typeof c === 'number');
  return vals.length ? Math.max(...vals) : null;
};
const scored = mx.parts.filter((part) => mx.theories.some((t) => bestShare(t, part.id) !== null));
const noneCan = scored.filter((part) => mx.theories.every((t) => (bestShare(t, part.id) ?? 0) === 0));
const onlyOne = scored
  .map((part) => ({ part, who: mx.theories.filter((t) => (bestShare(t, part.id) ?? 0) > 0) }))
  .filter((x) => x.who.length === 1);
const variantLabel = (name: string) => name.replace('+', ' + ');
// What each modelled theory can do in the exam, by its best variant per part: in at least a quarter of its settings,
// in fewer, in none.
const examOf = (id: string) => {
  const t = mxTheory(id);
  const b = (pid: string) => (t ? bestShare(t, pid) : null);
  return {
    can: mx.parts.filter((part) => (b(part.id) ?? -1) >= 0.25),
    some: mx.parts.filter((part) => {
      const x = b(part.id);
      return x !== null && x > 0 && x < 0.25;
    }),
    none: mx.parts.filter((part) => b(part.id) === 0),
  };
};
const phrases = (ps: { short: string }[]) => ps.map((part) => part.short).join('; ');
const partById = (pid: string) => mx.parts.find((part) => part.id === pid)!;
const bestOf = (id: string, pid: string) => {
  const t = mxTheory(id);
  return t ? (bestShare(t, pid) ?? 0) : 0;
};
const o22best = Math.max(...mx.theories.map((t) => bestShare(t, 'O2.2') ?? 0));
// The open question (Q1): when a pressed knot lets go, under the hand or as it eases off, per theory and variant.
type Hand = { knots: number; under: number; lift: number; later: number; held: number; under_s: number | null };
const handOf = (id: string, variant?: string) => {
  const t = mxTheory(id);
  const v = t?.variants.find((x) => !variant || x.name === variant) ?? t?.variants[0];
  return (v as unknown as { hand: Hand } | undefined)?.hand;
};
const h1 = handOf('T1');
const h3 = handOf('T3', 'drive');
const h6 = handOf('T6');
type Change = { version: number; date: string; items: string[] };
const changeLog = (exam as unknown as { changes: Change[] }).changes ?? [];
const history = (exam as unknown as { history?: { version: number; date: string; sha256: string; commit: string }[] }).history ?? [];
const openQs = ((exam as unknown as { open?: { id: string; question: string; why: string }[] }).open ?? []);
// Where a theory leads: the parts in which its best share beats every other modelled theory's.
const strengths = (id: string) =>
  mx.parts
    .map((part) => ({ part, b: bestOf(id, part.id), others: Math.max(...mx.theories.filter((t) => t.id !== id).map((t) => bestShare(t, part.id) ?? 0)) }))
    .filter(({ part, b, others }) => b > others && part.id !== 'O15')
    .sort((a, b) => b.b - a.b)
    .slice(0, 2)
    .map(({ part, b }) => `to ${part.short} (${pct(b)})`)
    .join(' and ');
// O8.2: after a knot lets go, where one comes back (per theory, over its variants).
const backs = (id: string) => (mxTheory(id)?.variants ?? []).flatMap((v) => (v.back ? [v.back] : []));
const span = (xs: number[]) => {
  if (!xs.length) return '–';
  const [lo, hi] = [Math.min(...xs), Math.max(...xs)].map((x) => Math.round(100 * x));
  return lo === hi ? `${hi}%` : `${lo}–${hi}%`;
};
const secs = (xs: (number | null)[]) => {
  const ys = xs.filter((x): x is number => x !== null).map(Math.round);
  if (!ys.length) return '–';
  const [lo, hi] = [Math.min(...ys), Math.max(...ys)];
  return lo === hi ? `${hi} s` : `${lo}–${hi} s`;
};
// A breath aimed at a place (route B6, the author's hypothesis): src/data/sim/aimed.json, from `knots_sim.aimed`.
type AimRow = { settings: number; target: number; alone: number; first: number; near: number; far: number; median_s: number | null; held_others: number; flow_near?: number; flow_far?: number };
const aim = aimedData as unknown as { run: { inputs: string; commit: string }; samples: number; widths: string[]; spacing_mm: number[]; near: number; far: number; T1: Record<string, AimRow>; T3: Record<string, AimRow> };
const widthLabel = (w: string) => (w === '0' ? 'not aimed' : w === 'all' ? 'the whole patch' : `${w} spacing${w === '1' ? '' : 's'}`);
const signed = (x: number | undefined) => (x === undefined ? '–' : `${x >= 0 ? '+' : '−'}${Math.round(100 * Math.abs(x))}%`);
const aT1 = (w: string) => aim.T1[w];
const aT3best = Object.values(aim.T3).reduce((m, row) => (row.target > m.target ? row : m), aim.T3['0']);
const ofN = (share: number, n: number) => `${Math.round(share * n)} of ${n}`;
const mm = (w: number) => `${+(w * aim.spacing_mm[0]).toFixed(1)}–${+(w * aim.spacing_mm[1]).toFixed(1)} mm`;
// What an instrument would record (src/data/sim/instrument.json, from `knots_sim.instrument`).
const inst = instrumentData as unknown as InstrumentStudy;
type Spread = { median: number; lo: number; hi: number; n: number } | null;
const rd = (tid: string, variant: string, kind: string, key: string) => (inst.reads[tid]?.[variant]?.[kind]?.[key] ?? null) as Spread;
const x2 = (x: number | undefined | null) => (x === undefined || x === null ? '–' : (+x.toFixed(2)).toString());
const liftSham = rd('T1', 'drive', 'press', 'lift_sham');
const darkBefore = rd('T1', 'drive', 'press', 'dark_before_0.6');
const darkAfter = rd('T1', 'drive', 'press', 'dark_after_0.6');
const t1Rel = rd('T1', 'drive', 'press', 'release_s');
const t3Stiff = rd('T3', 'drive', 'press', 'stiffness_before');
const t3Fall = rd('T3', 'drive', 'press', 'stiffness');
const t3Rel = rd('T3', 'drive', 'press', 'release_s');
const t6Rel = rd('T6', 'arousal', 'press', 'release_s');
const cvs = inst.design.cv.map((c) => `${Math.round(100 * c)}%`).join('–');
const regionLabel = (roi: number) => (roi === 0 ? `the patch (${inst.design.patch_mm} mm)` : `${roi / 10} cm across`);
const needed = (xs: (number | null)[]) => {
  const ys = xs.filter((x): x is number => x !== null);
  if (!ys.length) return 'none shows it';
  const [lo, hi] = [Math.min(...ys), Math.max(...ys)];
  return lo === hi ? `${lo}` : `${lo}–${hi}`;
};
const designRows = (rows: InstrumentStudy['design']['dark']) =>
  inst.roi_mm.map((roi) => ({ roi, cells: inst.own_share.map((s) => rows.find((r) => r.roi_mm === roi && r.own_share === s)!) }));
const b1 = backs('T1');
const b3 = backs('T3');
const b6 = backs('T6');
const e1 = examOf('T1');
const e3 = examOf('T3');
const e6 = examOf('T6');
const inExam = (e: ReturnType<typeof examOf>) => `In the exam, in at least a quarter of its settings: ${phrases(e.can) || 'nothing'}.`;
const notInExam = (e: ReturnType<typeof examOf>) => (e.none.length ? `In the exam, in none of its ${nSets} settings: ${phrases(e.none)}.` : '');


const THEORIES = [
  { glyph: '結', id: 'perforator', name: 'Perforators', who: 'proposed here', hold: 'A small artery shut by the muscle of its own wall: a switch, stable open or shut.', release: 'Tone falling below its reopening threshold (calm; a breath that lowers drive more than it raises it), or movement loosening the wall; pressure, then release.', status: 'modelled', statusText: 'one vessel; a tree; how a knot sets; through the exam' },
  { glyph: '閂', id: 'latch', name: 'Vascular latch', who: 'Johnson', hold: 'Smooth muscle in the latch state, holding tension cheaply; less flow leaves less energy to unlatch.', release: 'Attention to the held tissue, heat and cold, meditation.', status: 'next', statusText: 'shares the switch and how it sets; the latch needs the Hai–Murphy rate constants' },
  { glyph: '点', id: 'trigger-point', name: 'Trigger points', who: 'Travell · Simons', hold: 'An energy crisis at an overactive endplate: contracture squeezes the capillaries, and ischaemia withholds the energy to relax.', release: 'Sustained compression, stretch, needling; a local twitch as it goes.', status: 'modelled', statusText: 'the energy crisis at an endplate; through the exam' },
  { glyph: '膠', id: 'densification', name: 'Densification', who: 'Stecco', hold: 'Hyaluronan between the fascial layers turned viscous: the layers stop gliding.', release: 'Friction, heat and movement.', status: 'open', statusText: 'to model' },
  { glyph: '神経', id: 'nerve', name: 'Nerves', who: 'Quintner · Cohen', hold: 'A sensitised nerve where it pierces the fascia.', release: 'Nerve gliding, desensitisation, freeing it with fluid.', status: 'open', statusText: 'to model' },
  { glyph: '覚', id: 'central', name: 'Perception', who: 'clinical medicine', hold: 'Raised gain in the pain pathways, kept up by threat, attention and poor sleep.', release: 'Safety, sleep, a change of attention; overbreathing makes tingling anywhere.', status: 'modelled', statusText: 'gain, arousal and attention on a body map: the account to beat; through the exam' },
];

const VERDICTS: { glyph: string; name: string; status: string; can: string; cannot: string; open: string }[] = [
  { glyph: '結', name: 'Perforators', status: 'modelled',
    can: `Hold a knot by the vessel's own wall (a switch in ${pct(r.share_bistable)} of plausible settings); let it go by pressure (fastest), by an uneven breath, or by movement; make clusters and a queue through its tree; held an hour or two, set, so that it holds at rest and lets go with a flush. ${inExam(e1)}`,
    cannot: `Hold by its hyaluronan collar (a liquid, ${Math.round(col.pressure_over_drag)} times too weak); let go within a breath by warming. ${notInExam(e1)}`,
    open: `Whether knots sit on perforators. In healthy vessels the hold needs tone about ${(s.Aopen / s.urest).toFixed(1)} times rest; thicker walls (hypertension, perhaps age) and a lumen that closes tighter bring it nearer rest; a vessel only narrowed has no hold. Whether skin perforators adapt as arterioles do in the lab. How fast skin arterioles relax decides one breath or many.` },
  { glyph: '閂', name: 'Vascular latch', status: 'in part',
    can: 'Its core, a small artery held shut, is the same switch, and held long enough, its muscle adapts to being shut: memory, from the muscle’s own remodelling rather than latch bridges. The latch lets a held vessel stay held cheaply, and may harden an old knot against movement, as it does airway muscle against a deep breath.',
    cannot: 'Remember by the latch alone: relaxation follows the fall of calcium, not latch-bridge detachment.',
    open: 'The Hai–Murphy model itself (the rate constants); knots placed where no perforator lies, the brain and organs included, are its territory.' },
  { glyph: '点', name: 'Trigger points', status: 'modelled',
    can: `Hold a knot by its own ischaemia: the energy-crisis loop is a switch inside muscle, released by sustained pressure (calibrated to its 60–90 s) and by stretch, with a twitch as it goes. ${inExam(e3)}`,
    cannot: `${notInExam(e3)} Its knots form over its slow loops, tens of minutes, and which endplates hold one is set more by their own activity than by where stress is held.`,
    open: 'The loop’s energetics, measured at a contracture; a single motor unit as the unit (for micro knots); its slow sustaining factors, over weeks.' },
  { glyph: '膠', name: 'Densification', status: 'not yet run',
    can: 'Change glide between the fascial layers; the collar check does not touch it, since its claim is glide, not holding a vessel.',
    cannot: `Let go within a breath by heat (warming takes at least ${Math.round(cool.tau_s_at_max_flow)} s).`,
    open: 'Hyaluronan thinning as the layers move: its fast route.' },
  { glyph: '神経', name: 'Nerves', status: 'not yet run',
    can: 'Sensitivity where nerves pierce the fascia, which is where the perforators are.',
    cannot: 'Be told apart from perforators by location alone; it needs no change in blood flow at release.',
    open: 'Nerve-specific tests at the knots themselves.' },
  { glyph: '覚', name: 'Perception', status: 'modelled',
    can: `Any place and a queue by salience: when the loudest spot quiets, the next is noticed. ${inExam(e6)}`,
    cannot: `Change the tissue at the spot when a knot lets go: it predicts nothing local. ${notInExam(e6)}`,
    open: 'The first measurement decides it: is there a local change at release, absent at a sham site?' },
];

const WHERE: { glyph: string; name: string; where: string; count: string; scalp: string; inside: string; test: string }[] = [
  { glyph: '結', name: 'Perforators', where: 'where a vessel and its nerve pierce a fascia', count: 'a ladder: ~374 major, ~3,600 medium, ~100,000 small, one every 4–5 mm', scalp: 'yes', inside: 'no', test: 'blinded palpation against a blinded Doppler map of perforators' },
  { glyph: '閂', name: 'Vascular latch', where: 'wherever smooth muscle wraps a vessel or hollow organ', count: 'millions in principle', scalp: 'yes', inside: 'yes: the brain’s vessels and the organs', test: 'knots felt where no perforator lies' },
  { glyph: '点', name: 'Trigger points', where: 'the endplate zones of taut bands, inside muscle', count: 'hundreds, at mapped sites', scalp: 'only over its few muscles', inside: 'no', test: 'palpation against endplate zones (EMG) and ultrasound nodules' },
  { glyph: '膠', name: 'Densification', where: 'the loose layers between fasciae', count: 'tens to hundreds of patches, centimetres across', scalp: 'yes (the galea’s loose layer)', inside: 'no', test: 'ultrasound thickness of the loose layers under each knot' },
  { glyph: '神経', name: 'Nerves', where: 'where cutaneous nerves pierce the fascia', count: 'thousands, beside the medium and major perforators', scalp: 'yes', inside: 'no', test: 'nerve tests at each knot; the same places as perforators' },
  { glyph: '覚', name: 'Perception', where: 'anywhere attention and sensitisation make them', count: 'no fixed number; they can move', scalp: 'yes', inside: 'yes, as felt', test: 'sham places, and whether knots follow attention' },
];

const SIGNALS = ['blood flow in the skin over the spot', 'flow or tension in the muscle beneath', 'stiffness and glide', 'muscle activity (EMG)', 'skin temperature', 'where it tingles'];
const SIGS: { name: string; glyph: string; modelled?: boolean; cells: [string, string][] }[] = [
  { name: 'Perforators', glyph: '結', modelled: true, cells: [['up', 'darker than its neighbours before, not after; a press flushes every pressed site'], ['none', 'little'], ['none', 'little'], ['none', 'no change'], ['up', `an old knot’s flush warms it, over ≥\u00a0${Math.round(cool.tau_s_at_max_flow)}\u00a0s`], ['here', 'the vessel’s own patch']] },
  { name: 'Vascular latch', glyph: '閂', cells: [['up', 'rises, if skin vessels latch'], ['up', 'vascular tension falls'], ['none', 'little'], ['none', 'no change'], ['up', 'rises with flow'], ['silent', 'not stated']] },
  { name: 'Trigger points', glyph: '点', cells: [['none', 'little'], ['up', 'the taut band lets go; flow returns'], ['down', 'the nodule softens'], ['down', 'spontaneous activity falls; a twitch'], ['none', 'little at the skin'], ['here', 'a referred pattern']] },
  { name: 'Densification', glyph: '膠', cells: [['none', 'not required'], ['none', 'not required'], ['down', 'glide between layers returns'], ['none', 'no change'], ['silent', 'warmth may come first'], ['silent', 'not stated']] },
  { name: 'Nerves', glyph: '神経', cells: [['none', 'not required'], ['none', 'not required'], ['none', 'no change'], ['none', 'no change'], ['none', 'no change'], ['here', 'along the nerve’s territory']] },
  { name: 'Perception', glyph: '覚', cells: [['none', 'none locally; any change equal at a sham site'], ['none', 'none locally'], ['none', 'no change'], ['silent', 'may relax everywhere'], ['none', 'none locally'], ['any', 'anywhere; follows CO₂']] },
];
const OUTCOMES: { shows: string; fits: string; not: string }[] = [
  { shows: 'the knot’s patch darker than its neighbours before, and not after (beyond the flush of every pressed place)', fits: 'perforators; the vascular latch, if skin vessels latch', not: 'perception; trigger points (in their model the skin does not change)' },
  { shows: 'a dark spot at the knot that stays dark through its release', fits: 'the ordinary unevenness of skin', not: 'the vessel view, for that knot' },
  { shows: 'nothing in the skin, and the nodule softening under the probe', fits: 'trigger points', not: 'perception; perforators' },
  { shows: 'nothing in the tissue, at the knot or anywhere', fits: 'perception; or a signal not recorded (glide between layers, a nerve)', not: 'perforators; trigger points' },
  { shows: 'the same change at the knot and far from it', fits: 'the breath’s drive, everywhere: it says nothing of the knot', not: '–' },
];
const MARK: Record<string, string> = { up: '▲', down: '▼', none: '—', silent: '·', here: '◉', any: '○' };

const index = [
  { id: 'summary', label: 'summary' },
  { id: 'findings', label: 'what the simulations show' },
  { id: 'observations', label: 'what people report' },
  { id: 'exam', label: 'the exam' },
  { id: 'theories', label: 'the theories' },
  { id: 'where', label: 'where, and how many' },
  { id: 'physics', label: 'what physics allows' },
  { id: 'time', label: 'time: how a knot sets' },
  { id: 'breath', label: 'breath' },
  { id: 'trees', label: 'trees' },
  { id: 'signatures', label: 'what an instrument would record' },
  { id: 'experiment', label: 'the measurement' },
  { id: 'asks', label: 'what we need' },
  { id: 'method', label: 'method' },
];
---
<Doc
  title="Knots: an open problem, and the experiment that would settle it"
  kicker="For researchers"
  current="research"
  lede="People who work with the body find places that hold for years and let go in a breath. Six mechanisms could explain them. Here each is being run as a model with measured numbers, to ask what each can do, and what one recording at the moment of release would show under each."
  description="An open problem in physiology: what holds a knot, and what lets it go. The theories as models with measured numbers, their predictions, and the experiment that would tell them apart."
  glyph="究"
  index={index}
  wide
>
  <section id="summary" class="sec full" data-glyph="要">
    <div class="abstract">
      <p class="label">Summary</p>
      <p>
        <strong>The problem.</strong> Bodyworkers and contemplative practitioners report knots: discrete places in the body
        that hold, sometimes for years, and let go within seconds, under a hand or with a particular breath, often with a
        tingle over the spot, sometimes one releasing many others. Nothing about them has been recorded at the moment of
        release. At least six mechanisms have been proposed: a vessel held shut at a fascial perforation, smooth muscle
        in the latch state, a myofascial trigger point, densified hyaluronan, a sensitised nerve, and perception.
      </p>
      <p>
        <strong>What is done so far.</strong> Each theory is being written as a dynamical model in its strongest form,
        every parameter traced to a quoted line of a paper, and run through the same trials. The first is complete. A
        small artery with tone in its wall holds itself shut over a band of tone and lets go when tone falls below the
        band: a switch in {pct(r.share_bistable)} of {r.samples.toLocaleString('en-GB')} plausible parameter sets, though with the walls of healthy human
        small arteries only while tone stays well above rest, until, held an hour or two, its muscle adapts to being shut and
        the knot sets, holding at rest. Hyaluronan cannot hold a vessel, and warming cannot release one within a breath. The breath can release a knot
        through two routes, drive and movement, both fitted to measurements. A vessel holding a knot upstream shuts the
        vessels below it, and releasing it frees most of them at once. Three of the six, perforators, trigger points and
        perception, have now sat the same exam, each in {nSets} plausible settings: no variant of any does everything people
        report at once{noneCan.length > 0 && <>, and none can {phrases(noneCan)}</>}. <a href="#findings">What this says about each theory.</a>
      </p>
      <p>
        <strong>What would settle it.</strong> First, and cheapest: whether knots sit where a theory's anatomy puts them, checked blind against a
        map of perforators, of muscle endplates, or of the fascial layers. Then a recording at the moment of release: blood flow in the skin and in the
        muscle, stiffness, muscle activity and the breath, at the spot and at a sham site. The first question it answers
        is whether anything changes in the tissue at all. Each theory's predicted recording is set out below, to be
        sealed before any data.
      </p>
      <p>
        <strong>What we need.</strong> A few measurements that decide the most (small-artery myography, including a
        four-hour closure test; how fast skin arterioles relax; how much a fascial piercing concentrates movement), proponents
        to check how their theory has been formalised, and a laboratory to make the recording. <a href="#asks">Details below.</a>
      </p>
    </div>
  </section>

  <section id="findings" class="sec full" data-glyph="得">
    <h2>What the simulations show so far</h2>
    <p class="sub">
      Built from measured numbers and run through the same trials; each result names what it rests on further down the page. None says which theory is
      true: they say what each mechanism can and cannot do, and so where to look. Each is marked by kind: what holds in every plausible
      setting, what turns on numbers still guessed, what could be noticed without an instrument, and what an instrument would show.
    </p>
    <ol class="findings">
      <li><span class="kind">the map: rests on guessed ranges</span> <strong>Three theories through one exam, and none does everything.</strong> Perforators, trigger points and perception, each
        in its strongest form, sat the same trials in {nSets} plausible settings each (<a href="#exam">the matrix</a>). No variant
        of any produces every report at once{noneCan.length > 0 && <>, and none can {phrases(noneCan)}</>}. Each leads somewhere
        different: perforators are the likeliest {strengths('T1')}; trigger points, {strengths('T3')}; perception,{' '}
        {strengths('T6')}.</li>
      <li><span class="kind">you could notice this</span> <strong>When a pressed knot lets go splits the theories.</strong> Pressed, with a slow out-breath, a knot often lets go within
        seconds (O2); asked, the author could not say whether under the hand or as it eases off, so the exam takes either (v2) and
        the question stays <a href="#open">open</a>. The theories part on exactly that. Held a minute and lifted, the perforator
        switch lets {h1 ? pct(h1.lift) : '–'} of its pressed knots go within 5 s of the lift and {h1 ? pct(h1.under) : '–'} under the
        hand: pressed, the vessel cannot open. Perception, {h6 ? pct(h6.lift) : '–'} as the hand lifts: a press is felt more, not
        less. A trigger point, {h3 ? pct(h3.under) : '–'} under the hand{h3?.under_s ? <>, after {Math.round(h3.under_s)} s at the median</> : null}, its
        pressure release taking tens of seconds, as its own literature has it. It is the cheapest observation that would tell them
        apart.</li>
      <li><span class="kind">an instrument would tell</span> <strong>A knot back in the same place: each theory has a way, and each leaves something different to find.</strong> After a
        knot lets go, a knot is held at its place again within 10 minutes (<a href="#back">the table</a>). In the perforators, in{' '}
        {span(b1.map((b) => 1 - b.none))} of settings, and it is {Math.max(0, ...b1.map((b) => b.same)) === 0 ? 'never the same vessel shutting again but' : 'mostly'} a
        child vessel beneath it that the parent's release leaves shut: there all along, felt once the parent no longer masks it. In
        trigger points, the same endplate contracts again in {span(b3.map((b) => b.same))}, a median {secs(b3.map((b) => b.median_s))} after
        the release, if the drive that made it goes on. In perception, the place or one beside it is felt again in{' '}
        {span(b6.map((b) => 1 - b.none))}, after {secs(b6.map((b) => b.median_s))}, as attention moves. Telling which it is
        would take an instrument: a deeper vessel on a Doppler probe, the same endplate on a needle EMG, or nothing in the tissue.</li>
      <li><span class="kind">you could notice this</span> <strong>A breath aimed at one place would have to be narrow; for the perforators it could
        be.</strong> The author's hypothesis is that a trained breath lowers the sympathetic signal at one chosen place (<a href="#aimed">aimed</a>). In the
        perforators, a hard knot that {mx.trials.breaths} broad breaths left lets go in {ofN(aT1('0.25').target, aT1('0').settings)} settings when the
        breath is aimed at it, within {Math.round(aT1('0.25').median_s ?? NaN)} s, where the same breaths not aimed free{' '}
        {ofN(aT1('0').target, aT1('0').settings)}. Aimed within a quarter of the spacing between vessels ({mm(0.25)}), it goes first and alone in{' '}
        {ofN(aT1('0.25').alone, aT1('0.25').settings)}: a chosen knot, out of the order in which a broad breath takes them. Aimed over a spacing or more,
        neighbours go too, and the open vessels around the spot flow {signed(aT1('1').flow_near)} (over one spacing) to {signed(aT1('2').flow_near)} (over
        two) while it is aimed, those further off {signed(aT1('1').flow_far)}: what a laser speckle camera would see, and a sham site would not. In trigger
        points an aimed breath frees a hard knot in {ofN(aT3best.target, aT3best.settings)} settings, after about{' '}
        {Math.round((aT3best.median_s ?? NaN) / 60)} minutes: its ischaemia holds it whatever the drive does. Whether a chosen hard knot can go
        before easier ones nearby is something a practitioner could notice.</li>
      <li><span class="kind">can: turns on one guessed number</span> <strong>A knot can be a small artery holding itself shut, but in healthy vessels only under strong, sustained tone.</strong> With measured wall
        strength and thickness, pressure and reflex timings, a small artery has two stable states over a band of tone, in {pct(r.share_bistable)} of{' '}
        {r.samples.toLocaleString('en-GB')} plausible settings: held until released, by mechanics alone. With the walls of healthy human small arteries the
        band sits high: a shut vessel stays shut only while its tone stays above {healthyRatio.toFixed(1)} times rest. With the thicker walls of hypertension
        (media 8% of the lumen) it sits at {(hyper.Aopen / hyper.urest).toFixed(1)} times rest. How much force the muscle keeps when a vessel is nearly shut
        decides it most; then how tightly the lumen closes, a guess: closed to {f2(tight.xc)} of its relaxed radius it holds at{' '}
        {(tight.Aopen / tight.urest).toFixed(1)} times rest, and a vessel that cannot close past its fold, {f2(s.xfold)} of it, has no hold at all. Narrowed is not held.</li>
      <li><span class="kind">can: a myograph would tell</span> <strong>Held long enough, a knot can set.</strong> Smooth muscle held at a new length adapts to it. With adaptation at its measured pace, a knot held
        shut at {holdMult}× resting tone comes to hold at rest after {setHealthy.toFixed(1)} h, outlasting the stress that made it; released, it opens wide,{' '}
        {oldKnot.peak_flow.toFixed(1)}× resting flow, where a new knot's release brings flow back only to rest. The four-hour closure test would tell, in a
        myograph.</li>
      <li><span class="kind">cannot, in every setting</span> <strong>Liquids cannot hold, and heat is too slow.</strong> Hyaluronan resists motion, not position ({Math.round(col.pressure_over_drag)} times too weak to
        hold a vessel); warming takes at least {Math.round(cool.tau_s_at_max_flow)} s. Whatever releases a knot within a breath is faster than heat.</li>
      <li><span class="kind">follows from measured timings</span> <strong>The breath must be uneven, or move the tissue.</strong> Tone rises fast and eases slowly, so an even breath holds every knot. A breath that lowers
        drive more than it raises it releases the easy knots; a breath that moves the tissue releases knots where it moves, adding up breath by breath.</li>
      <li><span class="kind">you could notice this</span> <strong>Easy knots go first; the deepest hold.</strong> On a patch of {fieldData.n}, a broad easing of drive freed {fc.broad.freed} of {fc.broad.knots},
        in order of difficulty; a focused breath freed {fc.focused.freed_near} of the {fc.focused.knots_near} knots at its spot and {fc.focused.freed_far} of{' '}
        {fc.focused.knots_far} elsewhere; together, {fc.both.freed_near} of {fc.both.knots_near} at the spot.</li>
      <li><span class="kind">a measurement would tell</span> <strong>One breath or many turns on one unmeasured number:</strong> how fast skin arterioles relax when drive falls ({Math.round(easeFitted.release_s[0] ?? NaN)} s
        at the fitted value; {Math.round(easeFast.release_s[0] ?? NaN)} s if they relaxed in 3 s).</li>
      <li><span class="kind">can: rests on guessed resistances</span> <strong>Trees make clusters and queues.</strong> A knot in a parent vessel shuts its children; releasing it frees most of them at once, and the hardest
        stays: when the parent held, a cluster formed beneath it in {pct(tr.share_cluster)} of {tr.samples} plausible trees, and the higher the stress, the
        longer the queue. Siblings on one feed protect each other, so knots do not simply hop sideways.</li>
      <li><span class="kind">an instrument would tell</span> <strong>Pressure, then release, is the fastest way out, but flow returning is not the sign
        of a knot.</strong> A pressed knot lets go {pressed.toFixed(1)} s after the pressure lifts, against {Math.round(eased)} s when stress eases, and
        blood returns to it within seconds. But a press releases the tone of every vessel under the hand: at a pressed place with no knot, flow rises by{' '}
        {x2(liftSham?.median)} of a relaxed vessel's flow as the hand lifts. The sign of a knot, in the vessel view, is its patch against its neighbours':
        darker before, not after (<a href="#signatures">what an instrument would record</a>).</li>
    </ol>
    <h3 class="h3">What this says about each theory, so far</h3>
    <div class="table-wrap">
      <table class="verdicts">
        <thead><tr><th scope="col">theory</th><th scope="col">can, with measured numbers</th><th scope="col">cannot, or not as stated</th><th scope="col">still open</th></tr></thead>
        <tbody>
          {
            VERDICTS.map((t) => (
              <tr>
                <th scope="row"><span class="g cjk">{t.glyph}</span> {t.name}<span class:list={['st', t.status === 'modelled' ? 'st-modelled' : t.status === 'in part' ? 'st-next' : 'st-open']}>{t.status}</span></th>
                <td>{t.can}</td>
                <td>{t.cannot}</td>
                <td>{t.open}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="fine-print">
      Three theories have been through the <a href="#exam">exam</a>, each by its best variant for each part; the vascular latch shares the perforators'
      core. The other rows come from their own statements and the checks that touch them, until their models run. A theory with more rows filled is not a
      better theory, only a more tested one.
    </p>
  </section>

  <section id="observations" class="sec full" data-glyph="報">
    <h2>What people report</h2>
    <p class="sub">
      The observations every theory is tested against, in the author's own account (the <a href={`${base}/#observation`}>introduction</a>{' '}
      and the author's notes). Almost all are self-report; one is measured. They are <strong>versioned</strong>: each change is dated,
      with its reason, including how each word is read when a trial is scored, and every result names the version it used.
      Predictions for an experiment will be sealed before any data.
    </p>
    <p class="seal-line">
      <span class="seal-stamp cjk" aria-hidden="true">結</span>
      <span class="seal-sealed">exam v{exam.version} · {exam.updated}</span>
      <a class="seal-hash mono" href={`${repo}/sim/observations/spec.yaml`}>the file</a>
    </p>
    <details class="changes">
      <summary>What changed, version by version</summary>
      {
        changeLog.map((c) => {
          const sealedAs = history.find((h) => h.version === c.version);
          return (
            <div class="change">
              <p class="change-h mono">
                v{c.version} · {c.date}
                {sealedAs && (
                  <>
                    {' '}· <a href={`https://github.com/ejhong/knots/blob/${sealedAs.commit}/sim/observations/spec.yaml`} title={`SHA-256 ${sealedAs.sha256}`}>sealed as</a>
                  </>
                )}
              </p>
              <ul>{c.items.map((x) => <li>{x}</li>)}</ul>
            </div>
          );
        })
      }
    </details>
    <div class="obs-groups">
      {
        groups.map((g) => {
          const items = obs.filter((o) => o.group === g.id);
          return items.length ? (
            <div class="obs-group">
              <p class="obs-head">{g.label}</p>
              {items.map((o) => (
                <article class="obs">
                  <p class="obs-title">
                    <span class="oid mono">{o.id}</span> {o.title}{' '}
                    <span class:list={['ev', o.evidence === 'M' ? 'ev-m' : 'ev-s']} title={o.evidence === 'M' ? 'measured in the literature' : 'self-report'}>
                      {o.evidence === 'M' ? 'measured' : 'self-report'}
                    </span>
                  </p>
                  <p class="obs-text">{o.text}</p>
                  {o.note && <p class="obs-note">{o.note}</p>}
                </article>
              ))}
            </div>
          ) : null;
        })
      }
    </div>
    <div class="set-aside">
      <p class="obs-head">Set aside, not scored</p>
      <p class="set-aside-sub">Reports that appear only in the essays, whose text was generated and is sometimes off, until the author confirms them:</p>
      <ul>{(exam.set_aside as string[]).map((x) => <li>{x}</li>)}</ul>
    </div>
    {
      openQs.length > 0 && (
        <div class="set-aside" id="open">
          <p class="obs-head">Open, not scored</p>
          {openQs.map((q) => (
            <p class="obs-text"><span class="oid mono">{q.id}</span> {q.question} <span class="set-aside-sub">{q.why}</span></p>
          ))}
          <div class="table-wrap hand-wrap">
            <table class="hand">
              <caption class="sr-only">When each theory lets a pressed knot go: a press held a minute, then lifted</caption>
              <thead><tr><th scope="col">theory · variant</th><th scope="col">under the hand</th><th scope="col">as it lifts (5 s)</th><th scope="col">later</th><th scope="col">holds</th></tr></thead>
              <tbody>
                {
                  mx.theories.flatMap((t) =>
                    t.variants.map((v) => {
                      const h = (v as unknown as { hand: Hand }).hand;
                      return (
                        <tr>
                          <th scope="row">{t.name} <span class="mx-variant">{variantLabel(v.name)}</span></th>
                          <td class="mono">{pct(h.under)}{h.under_s ? <span class="who">median {Math.round(h.under_s)} s</span> : null}</td>
                          <td class="mono">{pct(h.lift)}</td>
                          <td class="mono">{pct(h.later)}</td>
                          <td class="mono">{pct(h.held)}</td>
                        </tr>
                      );
                    }),
                  )
                }
              </tbody>
            </table>
          </div>
          <p class="set-aside-sub">
            Shares of the knots each model holds, over its {nSets} settings and the knot depths, pressed for a minute with slow
            breaths and then lifted. Generated with the matrix (below).
          </p>
        </div>
      )
    }
  </section>

  <section id="exam" class="sec full" data-glyph="試">
    <h2>Every theory through the same exam</h2>
    <p class="sub">
      Each theory, as a model in its strongest form, sits the same trials: a single knot at a range of depths, a patch of{' '}
      {mx.trials.patch} places where stress is held, a cluster, and an hour of breath and mood. Every part of the exam is
      scored in {nSets} settings sampled across the theory's own plausible ranges, and a cell shows the share in which the part
      holds, never one tuned setting. Where turning words into equations is a choice, each choice is a row. Three of six
      theories have run: this is the first matrix. It says what each can do, never which is true.
    </p>
    <p class="legend-row" aria-hidden="true">
      <span><Fragment set:html={cellMark(1)} /> holds in every setting</span>
      <span><Fragment set:html={cellMark(0.25)} /> in a quarter (the disc's area)</span>
      <span><Fragment set:html={cellMark(0)} /> in none of {nSets}</span>
      <span><Fragment set:html={cellMark('silent')} /> silent: the account says nothing</span>
      <span>blank: not run yet</span>
    </p>
    <div class="table-wrap">
      <table class="matrix">
        <caption class="sr-only">Every modelled theory and variant against every part of the exam: the share of plausible settings in which each part holds</caption>
        <thead>
          <tr>
            <th scope="col" rowspan="2" class="mx-name">theory · variant</th>
            {partGroups.map((g) => <th scope="colgroup" colspan={g.parts.length} class="mx-obs" title={`${g.obs} ${obsTitle[g.obs] ?? ''}`}>{g.obs}</th>)}
            <th scope="col" rowspan="2" class="mx-joint" title="the share of settings that pass every scored part at once">all</th>
          </tr>
          <tr>
            {mx.parts.map((part) => <th scope="col" class="mx-part" title={`${part.id} ${part.says}`}>{part.id.includes('.') ? `.${part.id.split('.')[1]}` : '·'}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            ROWS.map((row) => {
              const t = mxTheory(row.id);
              if (!t) {
                return (
                  <tr class="mx-first mx-notyet">
                    <th scope="row"><span class="g cjk">{row.glyph}</span> {row.name}</th>
                    <td colspan={mx.parts.length + 1} class="mx-why">{row.why}</td>
                  </tr>
                );
              }
              return t.variants.map((v, i) => (
                <tr class:list={[{ 'mx-first': i === 0 }]}>
                  <th scope="row">
                    {i === 0 ? <span class="mx-theory"><span class="g cjk">{row.glyph}</span> {row.name}</span> : null}
                    <span class="mx-variant" title={v.description}>{variantLabel(v.name)}</span>
                  </th>
                  {mx.parts.map((part) => {
                    const c = v.cells[part.id] as Cell;
                    const text = cellText(t, part.id, part.says, c, (v as unknown as { tested?: Record<string, number | null> }).tested?.[part.id]);
                    return (
                      <td class:list={['mx-cell', { 'mx-dim': typeof c !== 'number' }]} title={text}>
                        <Fragment set:html={cellMark(c)} />
                        <span class="sr-only">{text}</span>
                      </td>
                    );
                  })}
                  <td class="mx-joint mono" title={`passes every scored part at once in ${Math.round(v.joint * t.samples)} of ${t.samples} settings`}>{v.joint > 0 ? pct(v.joint) : '0'}</td>
                </tr>
              ));
            })
          }
        </tbody>
      </table>
    </div>
    <details class="parts-key">
      <summary>The parts, as scored</summary>
      <ol>
        {mx.parts.map((part) => <li><span class="mono oid">{part.id}</span> {part.says}</li>)}
      </ol>
      <p class="fine-print">
        The trials, the same for every theory: a surge of stress for {Math.round(mx.trials.surge_s / 60)} minutes forms the knots, the
        holding stress keeps them {mx.trials.settle_s} s before any trial; a slow breath is {mx.trials.breath_s[0]} s in and{' '}
        {mx.trials.breath_s[1]} s out; a press lasts {mx.trials.press_s} s; a focused breath or a press starts after{' '}
        {mx.trials.breaths} broad breaths, once the easy knots have gone; the count is taken after{' '}
        {Math.round(mx.trials.hold_s / 60)} minutes at a stress. Stress is in one unit for every theory, and each sets its own
        scale by one rule: the typical place where stress is held sits in the middle of its window, so that the surge makes it a
        knot and the holding stress keeps it one without making it one alone. Minutes of slow breathing lower sympathetic drive (<Fragment set:html={cite('oneda2010')} />,{' '}
        <Fragment set:html={cite('adler2019')} />), and every theory whose breath acts through drive gets that too.
      </p>
    </details>
    {
      noneCan.length > 0 && (
        <p class="find">
          <strong>What none of the three can do, in any of their settings:</strong>{' '}
          {noneCan.map((part, i) => <>{i > 0 ? (i === noneCan.length - 1 ? '; or ' : '; ') : ''}{part.short} <span class="mono oid">{part.id}</span></>)}.
        </p>
      )
    }
    {
      onlyOne.length > 0 && (
        <p class="find">
          <strong>What only one can do:</strong>{' '}
          {onlyOne.map(({ part, who }, i) => {
            const k = Math.round((bestShare(who[0], part.id) ?? 0) * who[0].samples);
            return <>{i > 0 ? '; ' : ''}only {who[0].name.toLowerCase()} can {part.short}, in {k === who[0].samples ? 'every one' : `${k}`} of its {who[0].samples} settings <span class="mono oid">{part.id}</span></>;
          })}.
        </p>
      )
    }
    <h3 class="h3">How many knots each would hold</h3>
    <p class="find">
      Each theory's count: the share of its units holding a knot after half an hour of held stress in the patch, times the units a
      body has by its own sources, as if the whole body were held like the patch (so an upper figure). Practitioners who count
      report hundreds of thousands.
    </p>
    <div class="scroll-x"><Fragment set:html={countsStrip(mx)} /></div>
    <h3 class="h3" id="back">After a knot lets go: where one comes back</h3>
    <p class="find">
      After a release, “a new knot appears in what seems like the same place”: perhaps “the same perforator”, perhaps “a knot from
      somewhere else moved there” (the author, <span class="mono oid">O8.2</span>). In each theory's cluster the worked knot is
      pressed until it lets go, for a minute at most; the hand lifts, and the slow breaths and the holding stress go on. Over the
      settings in which it let go, the share in which a knot is held at its place again within 10 minutes, and by which route.
    </p>
    <div class="table-wrap hand-wrap">
      <table class="hand">
        <caption class="sr-only">After a knot lets go: the share of settings in which a knot is back at its place within 10 minutes, by route</caption>
        <thead><tr><th scope="col">theory · variant</th><th scope="col">the same unit</th><th scope="col">beneath it</th><th scope="col">beside it</th><th scope="col">none</th><th scope="col">soonest, median</th></tr></thead>
        <tbody>
          {
            mx.theories.flatMap((t) =>
              t.variants.filter((v) => v.back).map((v) => {
                const b = v.back!;
                return (
                  <tr>
                    <th scope="row">{t.name} <span class="mx-variant">{variantLabel(v.name)}</span> <span class="who">in {b.settings}</span></th>
                    <td class="mono">{pct(b.same)}</td>
                    <td class="mono">{b.beneath > 0 ? pct(b.beneath) : '–'}</td>
                    <td class="mono">{pct(b.beside)}</td>
                    <td class="mono">{pct(b.none)}</td>
                    <td class="mono">{b.median_s === null ? '–' : `${Math.round(b.median_s)} s`}</td>
                  </tr>
                );
              }),
            )
          }
        </tbody>
      </table>
    </div>
    <p class="fine-print">
      The same unit counts once it has been let go for 2 s (sooner is a flicker, not a release). Beneath: a vessel's children,
      which a released parent can leave shut; they were there all along, felt once the parent no longer masks them, and are
      counted from 10 s after the release, the soonest the trial looks. Beside: a unit next to it that was not held before (a
      sibling on the same feed; a neighbouring endplate on the taut band; one of the eight places around it on the body map). Which
      it is, the reports cannot say; a Doppler probe (a deeper vessel), a needle EMG (the same endplate) or nothing in the tissue at
      all would.
    </p>
    <p class="fine-print">
      Run <span class="mono">{mx.run.inputs}</span>{mx.run.commit ? <> at commit <span class="mono">{mx.run.commit}</span></> : null}, against exam v{mx.exam.version}{' '}
      ({mx.exam.updated}). Generated by <span class="mono">uv run python -m knots_sim.exam</span>; each theory's
      mapping onto the trials is written out, for its proponents to check, at the top of its file in{' '}
      <a href={`${repo}/sim/knots_sim/theories`}>sim/knots_sim/theories</a>.
    </p>
  </section>

  <section id="theories" class="sec full" data-glyph="説">
    <h2>The theories</h2>
    <p class="sub">
      Each at its strongest, as the <a href={`${base}/hypotheses/`}>Hypotheses</a> page states it, with the thing that would hold a
      knot (its switch) and what would let it go. Every theory will sit the same trials, with variants wherever turning words into
      equations is a choice, and its proponents are invited to check the formalisation.
    </p>
    <div class="table-wrap">
      <table class="theories">
        <thead><tr><th scope="col">theory</th><th scope="col">what holds a knot</th><th scope="col">what lets it go</th><th scope="col">model</th></tr></thead>
        <tbody>
          {
            THEORIES.map((t) => (
              <tr>
                <th scope="row"><span class="g cjk">{t.glyph}</span> <a href={`${base}/hypotheses/#${t.id}`}>{t.name}</a><span class="who">{t.who}</span></th>
                <td>{t.hold}</td>
                <td>{t.release}</td>
                <td><span class:list={['st', `st-${t.status}`]}>{t.status === 'modelled' ? 'run' : t.status === 'next' ? 'next' : 'to run'}</span><span class="who">{t.statusText}</span></td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="fine-print">
      Also in the census: a spinal loop through the muscle spindles that perpetuates tension and spreads it to other muscles{' '}
      <Fragment set:html={`(${cite('johansson1991')})`} />, a candidate for spreading knots; fascia contracting like smooth muscle{' '}
      <Fragment set:html={`(${cite('schleip2005')})`} />, too slow to release within a breath; and adhesions, a control that should
      fail every fast test.
    </p>
    <div class="aside">
      <p class="aside-h">Perforators and the vascular latch</p>
      <p>
        The two share a core: both put the hold in the smooth muscle of a small artery. The models push them closer: the vessel's own
        mechanics hold it, and what remembers is the muscle adapting to being shut (<a href="#time">time</a>), not latch bridges, since
        relaxation follows calcium (<Fragment set:html={cite('rembold1991')} />). If the switch is shared, what the perforation adds is
        mechanical, and it may be why these knots are the ones hands and rollers find. Where a vessel pierces the fascia it is pinned
        while the layers slide past it, so movement, stretch and a roller's shear would concentrate on its wall, and a change of shape is
        what loosens the wall (<Fragment set:html={cite('clifford2006')} />). A firm plane lies behind it, so fingers or a roller can press
        it, feel it as a point, and let pressure, then release, reach it. Its nerve pierces beside it, for the tenderness and the spark.
        And it heads a tree, so a knot there makes a cluster. A set knot needs pressure or movement to let go, which a piercing is placed to
        receive. The same hold in a vessel deep in muscle, or in the brain, would be out of reach of hands and not felt as a point.
      </p>
      <p>
        So the perforator view is anatomical: a countable ladder of piercings. Johnson's is general: held tension anywhere smooth muscle
        wraps a tube, the brain's vessels included, as a memory of the mind. A recording can tell them apart by depth (the skin over a
        perforator, or arterioles in muscle) and by pattern (points on a perforator map, or diffuse). And ultrasound, tracking the strain on
        a vessel's wall where it pierces the fascia against one within a layer as a roller passes or a breath moves the tissue, would
        measure the one number the movement route still guesses.
      </p>
    </div>
  </section>

  <section id="where" class="sec full" data-glyph="所">
    <h2>Where knots are, and how many</h2>
    <p class="sub">
      The cheapest test comes before any recording: each theory puts knots in different places, in different numbers. Where a practitioner finds a knot can be
      checked against a map of the anatomy each theory names, blinded both ways.
    </p>
    <div class="table-wrap">
      <table class="where">
        <thead><tr><th scope="col">theory</th><th scope="col">where a knot is</th><th scope="col">how many</th><th scope="col">over the bare scalp?</th><th scope="col">inside the head or organs?</th><th scope="col">the location test</th></tr></thead>
        <tbody>
          {
            WHERE.map((t) => (
              <tr>
                <th scope="row"><span class="g cjk">{t.glyph}</span> {t.name}</th>
                <td>{t.where}</td>
                <td>{t.count}</td>
                <td>{t.scalp}</td>
                <td>{t.inside}</td>
                <td>{t.test}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="two">
      <p class="find"><strong>Micro knots decide between units.</strong> If knots come at dozens per square inch (O15), only a unit that dense can hold one: small
        perforators, small arteries anywhere, or a single motor unit (a trigger-point variant). Patches centimetres across, or hundreds of mapped points, cannot.</p>
      <p class="find"><strong>Places that stay, or places that move.</strong> Anatomical theories put knots back in the same places; perception lets them move with
        attention. And a knot felt inside the head or an organ is the territory of the vascular latch and of perception alone.</p>
    </div>
  </section>

  <section id="physics" class="sec full" data-glyph="理">
    <h2>What physics allows: can a vessel hold a knot?</h2>
    <p class="sub">
      The first model, run in full on the <a href={`${base}/simulation/`}>simulation page</a>, where it can be played with. A
      perforator's small artery, with {sourced} parameters taken from or fitted to measurements and {guessed} guesses, each marked.
    </p>
    <div class="physics">
      <figure class="ink-fig" set:html={switchDiagram(p, s)} />
      <div class="facts">
        <p class="fact"><span class="big">{f2(s.Aopen)}–{f2(s.Afold)}</span><span class="fl">the band of tone, as a share of maximal, over which a small artery is stable both open and shut (rest: {f2(s.urest)}). Above the band it snaps shut; once shut, it stays shut until tone falls below it. <Fragment set:html={cite('burton1951')} /> described the instability.</span></p>
        <p class="fact"><span class="big">{pct(r.share_bistable)}</span><span class="fl">of {r.samples.toLocaleString('en-GB')} plausible parameter sets give the switch; in {pct(r.share_holds_at_rest)} it holds even at resting tone. Whether it holds at rest turns mostly on two numbers, now taken from measurements: how much force the muscle keeps as it shortens (<Fragment set:html={cite('mulvany1979')} />, rat small arteries) and the wall's thickness (<Fragment set:html={cite('schiffrin1995')} />, human subcutaneous small arteries).</span></p>
        <p class="fact"><span class="big">{v.gasp.at_s.toFixed(1)} s</span><span class="fl">when flow is lowest after a deep gasp, the one timing not fitted: measured 4.6–5.2 s <Fragment set:html={`(${cite('mayrovitz2026')})`} />. The fitted ones reproduce the gasp's size and recovery and the timing of reactive hyperaemia.</span></p>
      </div>
    </div>
    <div class="checks">
      <article class="check">
        <p class="q">Can hyaluronan hold a vessel shut?</p>
        <p class="a">No.</p>
        <p set:html={`A liquid resists motion, not position. At its most viscous (healthy synovial fluid; ${cite('nicholls2018')}), in a collar 20 µm thin, its drag is ${Math.round(col.pressure_over_drag)} times weaker than the pressure holding the vessel open, and fascia holds tens to hundreds of times less hyaluronan (${cite('fede2018')}).`} />
      </article>
      <article class="check">
        <p class="q">Can warming release one within a breath?</p>
        <p class="a">No.</p>
        <p>A patch of skin warms with a time constant of at least {Math.round(cool.tau_s_at_max_flow)} s even at maximal skin blood flow. Release within a breath needs something faster than heat.</p>
      </article>
      <article class="check">
        <p class="q">Does the latch remember?</p>
        <p class="a">It economises.</p>
        <p set:html={`Relaxation follows the fall of calcium, not latch-bridge detachment (${cite('rembold1991')}): a latch holds cheaply while the drive lasts. It may still harden a held vessel against movement, as it does airway muscle against a deep breath (${cite('fredberg1996')}).`} />
      </article>
      <article class="check">
        <p class="q">Does pressure, then release, let go?</p>
        <p class="a">Yes, and fastest.</p>
        <p>After 40 s of pressure the vessel reopens {pressed.toFixed(1)} s after the pressure lifts, and flow returns from near nothing to {afterPress.toFixed(2)} of resting flow while drive stays raised ({afterEase.toFixed(2)} when stress eases instead): the pressure ran up a debt, and returning blood repays it through the nerves.</p>
      </article>
    </div>
  </section>

  <section id="time" class="sec full" data-glyph="時">
    <h2>Time: how a knot sets</h2>
    <p class="sub">
      The switch alone holds a knot only while tone stays {healthyRatio.toFixed(1)} times rest. But smooth muscle held at a new length adapts to it: it regains
      the force it lost there, as its optimal length moves toward the length it is held at{' '}
      <Fragment set:html={`(${cite('syyong2008')}; ${cite('pratusevich1995')}; ${cite('bednarek2011')})`} />. Arterioles held constricted for four hours no longer
      relax fully when the drive is removed <Fragment set:html={`(${cite('martinezlemus2004')}; ${cite('hill2003')})`} />; held for days, they remodel inward, and
      only if their muscle is active <Fragment set:html={`(${cite('bakker2002')})`} />. In this variant the muscle's optimum follows the length it is held at,{' '}
      {pct(ad.share)} of the way (fitted to the 73% of lost force that pulmonary arterial muscle regained), over about {ad.tau_h.toFixed(0)} h at full activation
      (bracketed by the arterioles: five minutes leaves no trace, four hours does). It belongs to any vessel held by its own muscle: the perforator's, and the
      latch's.
    </p>
    <figure class="paper-fig scroll-x" set:html={knotSets(ad)} />
    <div class="two">
      <div>
        <p class="find"><strong>A knot can set.</strong> Held shut at {holdMult}× resting tone, a knot holds at rest after {setHealthy.toFixed(1)} h: it outlasts
          the stress that made it. Held an hour, it lets go when stress ends; held three, it stays. With the walls of hypertension it can be held from{' '}
          {hyFirst.mult}× rest, and sets there in {(hyFirst.hours ?? NaN).toFixed(1)} h.</p>
        <p class="find"><strong>A set knot is harder to release.</strong> Fully adapted, it stays shut down to {f2(ad.healthy.adapted_aopen_over_rest)} of
          resting tone: calm alone no longer frees it. It needs drive below rest, pressure, or movement. How long a knot has been held is one reason some go in a
          breath and others take many.</p>
        <p class="find"><strong>Old knots let go with a wave; young ones without.</strong> A set knot's muscle is weak at open lengths until it re-adapts, so
          released, the vessel opens to {oldKnot.peak_flow.toFixed(1)}× resting flow. A new knot's release brings flow back only to rest, and one released
          before it set reopens narrowed, as the lab's arterioles did after four hours. How long a flush lasts turns on what the model leaves out (below); if
          it lasts more than a minute, the skin warms (it takes {Math.round(cool.tau_s_at_max_flow)} s at least).</p>
        <p class="find"><strong>Days make it structural.</strong> Three days of tone narrow the relaxed lumen by {Math.round(100 * ad.remodel.shrink)}% around
          the same wall <Fragment set:html={`(${cite('bakker2002')})`} />: that alone brings the hold from {ad.remodel.before.toFixed(1)}× to{' '}
          {ad.remodel.aopen_over_rest.toFixed(1)}× resting tone.</p>
      </div>
      <div class="tiles">
        <p class="tile"><span class="big">{setHealthy.toFixed(1)} h</span><span class="fl">held shut at {holdMult}× resting tone before a knot holds at rest</span></p>
        <p class="tile"><span class="big">{pct(adRob.share_sets)}</span><span class="fl">of plausible switches can set; {pct(adRob.share_sets_within)} within {adRob.within_h} h
          held midway up the band (median {(adRob.set_h[1] ?? NaN).toFixed(1)} h)</span></p>
        <p class="tile"><span class="big">{oldKnot.peak_flow.toFixed(1)}×</span><span class="fl">resting flow when an old knot lets go; a new one's, 1×</span></p>
        <p class="tile-note">{adRob.samples} settings: the adaptation's time and share, and the switch's own ranges, each sampled.</p>
      </div>
    </div>
    <p class="caption">
      What it does not show. With drive held steady, the model's open vessels creep shut under sustained tone ({(creep15.hours ?? NaN).toFixed(0)} h at{' '}
      {creep15.mult}× rest), but arterioles held at {Math.round(100 * ad.lab.diameter)}% of their diameter for four hours kept it, where the model's would have
      shut within {(ad.lab.shuts_h ?? NaN).toFixed(1)} h. In an open vessel adaptation seems to make holding cheaper, not narrower, and flow and metabolism push
      back <Fragment set:html={`(${cite('vanbavel2014')})`} />; so stress making knots without a surge is not shown. A shut vessel has no flow, and the results
      above do not lean on what is missing. That a young knot comes and goes and an old one persists (O10) was known when this variant was added, so
      the match is found after the fact; the blind test is the four-hour closure test, <a href="#asks">below</a>.
    </p>
  </section>

  <section id="breath" class="sec full" data-glyph="息">
    <h2>Breath: two routes, kept open</h2>
    <p class="sub">
      How the breath acts is not assumed; each route is a variant. <strong>Through drive</strong>, the breath changes the sympathetic
      drive to the skin's small arteries everywhere at once: a deep in-breath tightens them within seconds <Fragment set:html={`(${cite('bolton1936')}; ${cite('lau1995')})`} />,
      and they take about half a minute to ease. <strong>Through movement</strong>, the breath deforms the tissue where the knot is: squeezed
      arteries widen within seconds of release, more after several squeezes than after one long one <Fragment set:html={`(${cite('clifford2006')})`} />,
      and rhythmic stretch cuts smooth muscle's force at once <Fragment set:html={`(${cite('ljung1975')})`} />. The model carries both, the movement
      route fitted to those squeezes (+{pct(v.squeeze.one.rise)} against +{pct(v.squeeze.one.measured.rise)} after one; +{pct(v.squeeze.five.rise)}{' '}
      against +{pct(v.squeeze.five.measured.rise)} after five).
    </p>
    <figure class="paper-fig scroll-x" set:html={releaseMap(breath)} />
    <p class="caption">
      Each knot is formed the same way, then held at a depth: how far the drive holding it sits above its own reopening threshold. Then {breath.breaths}{' '}
      slow breaths (six a minute). Numbers are the breath on which it lets go. Hover a cell for the time.
    </p>
    <div class="two">
      <div>
        <p class="find"><strong>An even breath holds every knot.</strong> Tone rises fast and eases slowly, so a breath that raises drive as much as it lowers it
          keeps knots held. Through drive, only a breath that lowers drive more than it raises it lets knots go, and only the easy ones.</p>
        <p class="find"><strong>Easy knots go first; hard ones take many breaths or none.</strong> Through movement the loosening adds up breath by breath, so a knot
          just above its threshold needs the tissue to move by only {pct(need10[depthAt(0.01)] ?? 0)} of a squeeze that shuts it, repeated for ten breaths;
          a knot a fifth of the way up needs {pct(need10[depthAt(0.2)] ?? 0)}, and the deepest {deepest === null ? 'none will reach' : `needs ${pct(deepest)}`}.</p>
        <p class="find"><strong>One breath or many</strong> turns on one number nobody has measured in skin: how fast its small arteries ease when drive
          falls. With the value fitted to the gasp's slow recovery ({Math.round(easeFitted.tau_down)} s), an uneven breath releases the easiest knot after{' '}
          {Math.round(easeFitted.release_s[0] ?? NaN)} s; if they eased in 3 s, after {Math.round(easeFast.release_s[0] ?? NaN)} s, about one breath.</p>
      </div>
      <figure class="paper-fig small" set:html={leastMovement(breath)} />
    </div>
    <p class="caption">
      What would have to be true for movement to be the route: the least deformation per breath, as a share of a squeeze that shuts the vessel.
      Ultrasound speckle tracking over a knot during the breath could measure it.
    </p>
    <h3 class="h3">Broad or focused: a patch of knots under one breath</h3>
    <p class="sub">
      {fieldData.n} perforators on a patch of skin, each with its own wall, and more stress in some zones (representative, not anatomy). A surge
      forms {fc.broad.knots} knots under strong regional stress; with no breath, {fc.calm.freed} poised at their thresholds drift open. Then the breath acts in one
      of three ways.
    </p>
    <figure class="paper-fig scroll-x" set:html={fieldPanels(fieldData)} />
    <div class="two">
      <p class="find"><strong>Broad release takes the easy knots everywhere.</strong> When drive eases across the patch, {fc.broad.freed} of {fc.broad.knots} let go,
        scattered wherever their thresholds are highest, in order of difficulty (depth and release time correlate at {fc.broad.depth_vs_time.toFixed(2)}).</p>
      <p class="find"><strong>Focused release takes the knots where the tissue moves, whatever else is true.</strong> {fc.focused.freed_near} of the{' '}
        {fc.focused.knots_near} knots at the spot let go, and {fc.focused.freed_far} of {fc.focused.knots_far} elsewhere. Together the two routes free all{' '}
        {fc.both.knots_near} at the spot and {fc.both.freed_far} elsewhere: a focused breath works best in a calm body.</p>
    </div>
    <h3 class="h3" id="aimed">Aimed: a breath that lowers the drive at one chosen place</h3>
    <p class="sub">
      The author's hypothesis: a precise, trained breath, as in a body scan, lowers the sympathetic signal at one chosen place and so
      lets a knot there go. How is not known. The signal is not one global switch: it runs in many separate channels{' '}
      <Fragment set:html={`(${cite('morrison2001')})`} />, and in people its outflow to skin and to muscle can part company{' '}
      <Fragment set:html={`(${cite('vissing1997')})`} />. The mind can change one region's vessels: under hypnosis, a warm bath
      suggested for one forearm dilated that forearm and not the rest <Fragment set:html={`(${cite('casiglia2006')})`} />. And a
      caution: learned warming of the fingers, local as it is, works through a non-neural beta-adrenergic route, not through less
      sympathetic activity <Fragment set:html={`(${cite('freedman1991')})`} />. Whether anything can be aimed at a patch the size of a knot is
      not known. So each theory with a drive to aim is asked what an aimed breath would have to do.
    </p>
    <p class="find">
      On the exam's patch, knots formed and held, then {mx.trials.breaths} broad slow breaths (the knots left are the hard ones), then{' '}
      {mx.trials.breaths} breaths aimed at one knot still held. At a distance from it the breath lowers drive more, by the setting's
      focus gain at the centre (1.5–6 times, guessed), falling off over the footprint's width. The width is in spacings between
      neighbouring places: for perforators, {aim.spacing_mm[0]}–{aim.spacing_mm[1]} mm. Against the same breaths not aimed, in{' '}
      {aim.samples} settings each:
    </p>
    <div class="table-wrap hand-wrap">
      <table class="hand aim">
        <caption class="sr-only">A breath aimed at one held knot: by the width of its footprint, how often the knot lets go, alone, first; and for perforators what a flow meter would see around it while the breath is aimed</caption>
        <thead>
          <tr><th scope="col" rowspan="2">footprint</th><th scope="colgroup" colspan="5">perforators</th><th scope="colgroup" colspan="3">trigger points</th></tr>
          <tr>
            <th scope="col" title="the aimed knot lets go">lets go</th><th scope="col" title="and no other knot besides">alone</th><th scope="col" title="before any other knot">first</th>
            <th scope="col" title={`flow in open vessels within ${aim.near} spacings of the aimed knot, 20 s into the aimed breaths`}>flow near</th><th scope="col" title={`flow in open vessels beyond ${aim.far} spacings`}>far</th>
            <th scope="col">lets go</th><th scope="col">alone</th><th scope="col">first</th>
          </tr>
        </thead>
        <tbody>
          {
            aim.widths.map((w) => {
              const a1 = aim.T1[w];
              const a3 = aim.T3[w];
              return (
                <tr>
                  <th scope="row">{widthLabel(w)}</th>
                  <td class="mono">{pct(a1.target)}</td><td class="mono">{w === '0' ? '–' : pct(a1.alone)}</td><td class="mono">{pct(a1.first)}</td>
                  <td class="mono">{signed(a1.flow_near)}</td><td class="mono">{signed(a1.flow_far)}</td>
                  <td class="mono">{pct(a3.target)}</td><td class="mono">{w === '0' ? '–' : pct(a3.alone)}</td><td class="mono">{pct(a3.first)}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p class="fine-print">
      Shares of the settings with a knot left to aim at ({aim.T1['0'].settings} for perforators, {aim.T3['0'].settings} for trigger
      points). Alone: no other knot let go that the same breaths, not aimed, would have kept. Flow: the change in flow through open
      vessels over one breath, 20 s into the aimed breaths, against the breath before. Generated by{' '}
      <span class="mono">uv run python -m knots_sim.aimed</span> (run <span class="mono">{aim.run.inputs}</span>). Perception is
      not in the table: in it, attention is already local, and aiming it is its focused breath.
    </p>
  </section>

  <section id="trees" class="sec full" data-glyph="樹">
    <h2>Trees: a parent and its children</h2>
    <p class="sub">
      Perforators branch: a parent vessel feeds children, and they share its pressure. Each vessel here is the same switch, with its own wall;
      pressures are solved at every step. The worked tree has walls as in hypertension (media 7.5–10% of the lumen) and drive raised to{' '}
      {(tree.figure as unknown as { u_m: number }).u_m.toFixed(2)} of maximal tone; the tree's own numbers are guesses and are sampled below.
    </p>
    <figure class="ink-fig wide-fig scroll-x" set:html={treeStory(tree.figure)} />
    <div class="two">
      <div>
        <p class="find"><strong>One knot upstream makes a cluster below it.</strong> When a local surge shuts the parent, the pressure beneath it collapses and all
          four children snap shut within seconds.</p>
        <p class="find"><strong>Release the parent, and the cluster lets go together.</strong> The pressure surges back and three children open within a second.
          The thickest-walled one stays shut while stress stays raised: the next knot in the queue, which goes only when drive falls.</p>
        <p class="find"><strong>Siblings protect each other.</strong> On a shared feed, each closure raises the pressure holding the others open: a surge of
          stress shut {tree.siblings.shut_by_surge} of {tree.siblings.siblings}, where alone, at the same pressure, {(tree.siblings as unknown as { shut_alone: number }).shut_alone} would. Clusters come from the tree's hierarchy, not from neighbours.</p>
        <p class="find"><strong>The higher the stress, the longer the queue.</strong> In the worked tree, the children left held after the parent lets go:{' '}
          {treeQueue.drive.map((u, i) => (treeQueue.parent_knot[i] ? `${treeQueue.remain[i]} at drive ${u.toFixed(2)}` : null)).filter(Boolean).join(', ')}.</p>
      </div>
      <div class="tiles">
        <p class="tile"><span class="big">{pct(tr.share_cluster)}</span><span class="fl">of plausible trees in which the parent held a knot: a cluster formed beneath it ({tr.mean_cluster.toFixed(1)} of 4 children on average)</span></p>
        <p class="tile"><span class="big">{pct(tr.share_cascade)}</span><span class="fl">in which releasing the parent freed most of its cluster within 5 s</span></p>
        <p class="tile"><span class="big">{pct(tr.share_queue)}</span><span class="fl">in which at least one child stayed held after the parent let go</span></p>
        <p class="tile-note">{tr.samples} trees: source and bed pressures, the parent's resistance, the children's walls and the drive, each sampled across its range.</p>
      </div>
    </div>
    <p class="caption">
      The author has felt one knot's release let many go with it (O13), written down after this simulation was shared, so the match is found
      after the fact. The blind tests are the details, and a flow surge over the whole cluster at the parent's release.
    </p>
  </section>

  <section id="signatures" class="sec full" data-glyph="徴">
    <h2>What an instrument would record</h2>
    <p class="sub">
      Each modelled theory's own trial, read the way an instrument would read it: knots formed and held, thirty slow breaths, then a
      knot at the spot pressed for a minute with slow breaths and lifted, beside a pressed place that held no knot and a place far from
      the hand. Nothing here is a new trial: the exam's patch trials are recorded as they run, in all {inst.samples} settings of each theory,
      and each trace is the setting whose release is the median.
    </p>
    <figure class="paper-fig scroll-x" set:html={recordings(inst)} />
    <p class="caption">
      Perforators: skin perfusion over each place's patch, as laser speckle would read it (it sees the skin's superficial supply,{' '}
      <Fragment set:html={cite('odoherty2009')} />), with the knot's patch fed {Math.round(100 * inst.own_share[1])}% by its own vessel and the rest by its
      neighbours (a guess: each vessel's territory is linked to its neighbours', <Fragment set:html={cite('saintcyr2009')} />). Trigger points: the
      nodule's contracture, which elastography would read as stiffness. Perception: what is felt; nothing in its tissue changes. Hover a line for
      its values.
    </p>
    <div class="two">
      <p class="find"><span class="kind">an instrument would tell</span> <strong>A press flushes every place it presses.</strong> Held stress narrows
        every vessel in the zone; the hand releases their tone, so as it lifts, flow rises at a pressed place that held no knot by{' '}
        {x2(liftSham?.median)} of a relaxed vessel's flow ({x2(liftSham?.lo)}–{x2(liftSham?.hi)} across settings), as it does at the knot. Flow returning
        at a release says nothing by itself; the comparison has to be a pressed place with no knot.</p>
      <p class="find"><span class="kind">an instrument would tell</span> <strong>The sign of a knot, in the vessel view: a patch darker than its
        neighbours, until it lets go.</strong> Before the press the knot's patch is {darkBefore ? pct(darkBefore.median) : '–'} darker than its
        neighbours' under the same hand (the share its own vessel feeds); ten seconds after it lets go it is{' '}
        {darkAfter ? (Math.abs(darkAfter.median) < 0.1 ? 'about as bright as theirs' : darkAfter.median < 0 ? `${pct(-darkAfter.median)} brighter` : `${pct(darkAfter.median)} darker`) : '–'}. Normal skin has lasting
        darker and brighter spots a few millimetres apart, and their levels against each other persist <Fragment set:html={`(${cite('wardell1994')})`} />:
        a dark spot alone is not a knot, but a dark spot that brightens against its neighbours as a knot lets go would be.</p>
    </div>
    <div class="two">
      <p class="find"><span class="kind">an instrument would tell</span> <strong>Trigger points: nothing in the skin; the nodule softens under the
        hand.</strong> The contracture, {x2(t3Stiff?.median)} before the press, falls by {x2(t3Fall ? -t3Fall.median : null)} as the knot lets go,{' '}
        {t3Rel ? `${Math.round(t3Rel.median)} s` : '–'} after the press began{t3Rel && t3Rel.median < mx.trials.press_s ? ', under the hand' : ''}. An
        ultrasound probe that is also the pressing hand would see it; the skin above would not.</p>
      <p class="find"><span class="kind">an instrument would tell</span> <strong>Perception: nothing in the tissue.</strong> The felt knot fades{' '}
        {t6Rel ? `${Math.round(t6Rel.median)} s` : '–'} after the press began, as the hand lifts, and nothing measurable changes at the knot or at
        either other place. The perforators let theirs go at {t1Rel ? `${Math.round(t1Rel.median)} s` : '–'}, also as the hand lifts: the moment is
        the same, and only the skin tells them apart.</p>
    </div>
    <h3 class="h3">Every theory, from its model or its own statements</h3>
    <div class="table-wrap">
      <table class="sig">
        <thead>
          <tr><th scope="col">theory</th>{SIGNALS.map((x) => <th scope="col">{x}</th>)}</tr>
        </thead>
        <tbody>
          {
            SIGS.map((row) => (
              <tr>
                <th scope="row"><span class="g cjk">{row.glyph}</span> {row.name}{row.modelled && <span class="st st-modelled">model</span>}</th>
                {row.cells.map(([m, text]) => (
                  <td><span class:list={['mk', `mk-${m}`]} aria-hidden="true">{MARK[m]}</span> {text}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="legend-row"><span>▲ rises</span><span>▼ falls</span><span>— no change</span><span>◉ confined to a patch</span><span>○ anywhere</span><span>· not stated</span></p>
  </section>

  <section id="experiment" class="sec full" data-glyph="験">
    <h2>The measurement that would settle it</h2>
    <p class="sub">
      Designed from the models, cheapest first. It describes a measurement; it prescribes nothing to anyone practising, and any practice
      around it belongs under the site's <a href={`${base}/#moderation`}>moderation guidance</a>.
    </p>
    <ol class="steps">
      <li><strong>Before any instrument: what a practitioner could notice.</strong> Four questions the theories answer differently:
        <ul>
          <li><em>When a pressed knot lets go:</em> under the hand, or as it lifts (<a href="#open">Q1</a>). Perforators, as it lifts; perception, as it
            lifts or not at all; trigger points, under the hand{h3?.under_s ? `, after about ${Math.round(h3.under_s)} s` : ''}.</li>
          <li><em>Whether a chosen hard knot can go while easier ones beside it stay.</em> A broad breath takes the easiest first; a breath aimed narrowly
            at one place could take a chosen one first, in the perforators (<a href="#aimed">aimed</a>).</li>
          <li><em>When a knot comes back to the same place:</em> at once (perforators: a vessel beneath, there all along), within seconds to half a
            minute (trigger points), or after about half a minute (perception) (<a href="#back">the table</a>).</li>
          <li><em>How fast knots form:</em> within seconds of a stressful moment, or only after long tension or stillness. The next to run.</li>
        </ul>
      </li>
      <li><strong>A map, with no release.</strong> Laser speckle over skin where knots have been marked by someone who cannot see the image, and
        around them. In the vessel view each knot is a patch 4–5 mm across, darker than its neighbours by the share of its patch its own vessel
        feeds; in trigger points and perception, nothing.</li>
      <li><strong>At a release.</strong> The same camera, a button pressed at each felt release, a breath belt, and three places: the knot, a place
        under the same hand with no knot, and a place far from it. In the vessel view the knot's patch brightens against its neighbours' as it lets
        go, beyond the flush every pressed place shows.</li>
      <li><strong>If the skin shows nothing.</strong> Under the knot, with the probe as the pressing hand: shear-wave elastography for the nodule's
        stiffness (<Fragment set:html={cite('sikdar2009')} /> imaged trigger points this way) and needle EMG at the nidus.</li>
    </ol>
    <h3 class="h3">How many knots, and how many releases</h3>
    <p class="find">
      In the vessel view, by how wide a region is read (a wider one dilutes the patch) and how much of its patch a knot's vessel feeds (not known).
      The noise is laser speckle's week-to-week variability, {cvs} <Fragment set:html={`(${cite('roustit2010')})`} />, which over-states the
      noise within one session; a paired comparison at 5% and 80% power, and never fewer than three.
    </p>
    <div class="table-wrap hand-wrap">
      <table class="hand design">
        <caption class="sr-only">How many knots, or releases, would show the vessel view's signs, by region width and the share of its patch a knot's vessel feeds</caption>
        <thead>
          <tr><th scope="col" rowspan="2">region read</th><th scope="colgroup" colspan={inst.own_share.length}>a dark patch: knots</th><th scope="colgroup" colspan={inst.own_share.length}>it brightens as it lets go: releases</th></tr>
          <tr>{[0, 1].flatMap(() => inst.own_share.map((s) => <th scope="col">{pct(s)} fed</th>))}</tr>
        </thead>
        <tbody>
          {
            designRows(inst.design.dark).map(({ roi, cells }, i) => (
              <tr>
                <th scope="row">{regionLabel(roi)}</th>
                {cells.map((c) => <td class="mono" title={`effect ${x2(c.effect)} of the patch's flow`}>{needed(c.needed)}</td>)}
                {designRows(inst.design.gone)[i].cells.map((c) => <td class="mono" title={`effect ${x2(c.effect)} of the patch's flow`}>{needed(c.needed)}</td>)}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="fine-print">
      Each cell: at laser speckle's lower and higher variability. Read a region the size of one patch and a handful suffice; read two centimetres
      and the patch is lost among its neighbours. Generated by <span class="mono">uv run python -m knots_sim.instrument</span> (run{' '}
      <span class="mono">{inst.run.inputs}</span>).
    </p>
    <h3 class="h3">What each outcome would rule out</h3>
    <div class="table-wrap">
      <table class="verdicts outcomes">
        <thead><tr><th scope="col">at a felt release, the recording shows</th><th scope="col">it fits</th><th scope="col">it does not fit</th></tr></thead>
        <tbody>
          {
            OUTCOMES.map((o) => (
              <tr><th scope="row">{o.shows}</th><td>{o.fits}</td><td>{o.not}</td></tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <figure class="ink-fig wide-fig scroll-x" set:html={decisionTree()} />
    <p class="caption">
      The order of questions the theories not yet modelled also answer: first where knots sit, then whether anything local changes, then in what.
    </p>
  </section>

  <section id="asks" class="sec full" data-glyph="願">
    <h2>What we need</h2>
    <ol class="asks">
      <li>
        <p class="ask-h">The force of a nearly shut small artery</p>
        <p>How much active force a small artery's muscle keeps at the very short lengths of a nearly shut vessel, and how thick its wall is, measured in
          human skin perforators or subcutaneous small arteries, young and old, with and without hypertension. The model now takes them from rat arteries
          and healthy human walls, and they decide whether a knot can hold at ordinary tone.</p>
      </li>
      <li>
        <p class="ask-h">The four-hour closure test</p>
        <p>In a pressure myograph, shut a small artery with an agonist for five minutes, or for four hours, then lower the agonist to a resting level. If
          knots are vessels that set, the first reopens and the second stays shut, and when it is finally released it opens past its resting diameter.
          Arterioles held constricted for four hours already relax incompletely and slowly; the test asks whether a vessel held fully shut stays shut at rest.
          It is a day's work for a lab with a myograph, and it tests whether a knot can remember.</p>
      </li>
      <li>
        <p class="ask-h">How much a piercing concentrates movement</p>
        <p>Ultrasound speckle tracking of a perforator's wall where it pierces the fascia, against a vessel within one layer, as a roller passes or a
          breath moves the tissue. It is the number the movement route guesses, and it would say whether the perforation is what makes these knots
          the ones pressure and movement release.</p>
      </li>
      <li>
        <p class="ask-h">How fast skin arterioles relax when sympathetic drive falls</p>
        <p>The time course of dilation after a brief sympathetic burst ends, over hairy skin (the back and neck, where knots are reported). It decides
          whether a knot can let go in one breath or needs many. The gasp reflex itself is measured mostly on the fingers.</p>
      </li>
      <li>
        <p class="ask-h">The recording at release</p>
        <p>A laboratory with laser speckle, ultrasound or elastography, and a skilled practitioner, to make the keystone recording above; or the first
          question alone.</p>
      </li>
      <li>
        <p class="ask-h">The proponents' eyes</p>
        <p>Each theory's formalisation checked by those who hold it: the vascular latch, fascial densification, trigger points, peripheral nerve
          sensitivity and the perceptual account. Variants are welcome; so are objections.</p>
      </li>
      <li>
        <p class="ask-h">A physiologist or modeller as co-author</p>
        <p>For the preprint, and to keep the models honest.</p>
      </li>
    </ol>
    <p class="contact">Everything is open: <a href="https://github.com/ejhong/knots">the code and data</a>; objections and offers as{' '}
      <a href="https://github.com/ejhong/knots/issues">issues</a>.</p>
  </section>

  <section id="method" class="sec full" data-glyph="法">
    <h2>How it is made</h2>
    <div class="two">
      <div>
        <p class="find"><strong>Measured numbers, quoted.</strong> Every parameter has a source in the <a href={`${base}/library/`}>library</a>, the line it comes
          from quoted, and a confidence (measured, inferred, fitted or guessed); a script checks every quote word for word against the paper. Fitted values are
          fitted automatically to measured targets.</p>
        <p class="find"><strong>Can, not is.</strong> A model can show that a mechanism cannot produce an observation at any plausible parameters, or what a
          measurement would record if it is right. It cannot show that a theory is true.</p>
      </div>
      <div>
        <p class="find"><strong>Written once, run everywhere.</strong> Each model is written once in Python (SymPy); the browser runs code generated from it, held to
          the same trajectories by a test. Results are generated, never edited by hand, and each names its run.</p>
        <p class="find"><strong>Versioned, not tuned.</strong> The observations are versioned: each change is dated with its reason, and every result
          names the version it used. The predictions for an experiment will be sealed before any data.</p>
      </div>
    </div>
    <p class="stamp mono">run {data.run.date} · inputs {data.run.inputs} · exam v{exam.version}, {exam.updated}</p>
    <p class="links mono">
      <a href={`${base}/simulation/`}>the bench</a>
      <a href={`${repo}/sim/PLAN.md`}>the research plan</a>
      <a href={`${repo}/sim/knots_sim/models/vessel.py`}>the vessel model</a>
      <a href={`${repo}/sim/knots_sim/models/tree.py`}>the tree</a>
      <a href={`${repo}/sim/knots_sim/breath.py`}>the breath trials</a>
      <a href={`${repo}/sim/knots_sim/adapt.py`}>how a knot sets</a>
      <a href={`${repo}/sim/observations/spec.yaml`}>the observations</a>
      <a href={`${repo}/sim/findings/`}>findings notes</a>
    </p>
  </section>
</Doc>

