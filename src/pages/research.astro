---
import Doc from '../layouts/Doc.astro';
import { refById } from '../data/references';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const cite = (id: string) => {
  const ref = refById(id);
  if (!ref) return id;
  const parts = ref.authors.split(',')[0].split(' et al')[0].trim().split(' ');
  const last = parts[parts.length - 1];
  const who = /^\p{Lu}{1,3}$/u.test(last) ? parts.slice(0, -1).join(' ') : last; // "Burton AC" or "Michael Edward Johnson"
  return `<a class="cite" href="${base}/library/#${id}">${who} ${ref.year}</a>`;
};
// Older anchors: the position paper cites research/#points (perforators and acupoints), and until 14 Nov the list was
// #experiments and its cards #experiment-N.
const ALIAS: Record<string, string> = { 'Acupoints on perforators': 'points' };

// Studies that might help, on the two open questions: what a knot is, and what runaway release is. Grouped by what each
// needs (STAGES) and listed in the order they build on one another, not by importance, each with the kind of study it would
// be. docs/RESEARCHHUB.md (the draft call on ResearchHub) lists the studies by number, title and kind, in this order,
// and points here for their text; it repeats the ask for letters of intent (#respond: what a letter holds, how letters
// are weighed, what happens next) and the care rule. Keep the two in step.
const STUDIES: { stage: string; prong: string; title: string; design: string; what: string; show: string; needs: string }[] = [
  {
    stage: 'finding-knots',
    prong: 'knots',
    title: 'Who can feel a knot: its owner, others, or both',
    design: `Survey and phenomenological interviews, then a blinded reliability study (test–retest and inter-rater)`,
    what: `Two questions, which may have different answers: can people feel their own knots, and can others feel them too?
      A knot might be felt only by its owner, or by a hand from outside as well. Many who foam-roll or work on their
      own knots might be surveyed and interviewed: whether they can isolate a single knot, felt as a distinct bump, or
      feel only broad, dull masses; whether a bump is there when they first press, or stands out only as they attend
      to it and breathe; how firmly they must press to find one; whether they can release them; what a release feels
      like and what follows it, from nothing to relief, well-being, tears or euphoria, how often, and whether many
      knots ever let go at once; how they learned; and what part the breath plays, in finding knots as well as in
      releasing them. Bodyworkers might be asked the same about the knots they feel in others. Then, in the same
      people, each might mark the knots they feel, blind to the other marks: the person their own, twice, an hour
      apart, and two examiners by touch. Which knots does each find, and do they agree? And as a person lets a knot go
      under an examiner's resting finger, does the examiner feel the bump go too?`,
    show: `Whether feeling knots is itself a skill, perhaps tied to the breath as releasing them seems to be, held by some
      and not by others; and whether the knots a person feels in themselves can be felt by others too, or only from
      inside. Someone pressing their own knot feels it twice over, with the finger and in the place pressed, and
      cannot easily tell the two apart; an examiner's finger has only the first. How common a felt release is among
      people who roll, and the feeling that can follow it, is not known; the survey would give a first estimate, and
      would find the people who have the knots meant here. If feeling knots is a skill, studies that locate or release knots would
      need to recruit those who have the skill they rely on; and if bumps stand out only with a trained breath, an
      examiner might find none in a body at rest.`,
    needs: `a survey and interview researcher · many people who foam-roll, and bodyworkers · simple blind tests`,
  },
  {
    stage: 'finding-knots',
    prong: 'knots',
    title: 'How best to detect a knot',
    design: `Blinded diagnostic-accuracy study, with marked knots as the reference standard`,
    what: `At knots marked by their owners or by examiners (study 1), and at matched spots nearby, instruments might be
      compared, each blind to the marks: a pencil Doppler listening for a perforator and its flow; ultrasound looking
      for a bump, a vessel beneath and the layers' glide, with colour Doppler and elastography; and a thermal camera
      watching the skin rewarm after a mild cold (${cite('weum2016b')}). Each might look twice: while the knots hold,
      and again once their owners have released them by their usual means.`,
    show: `Whether an instrument can find a knot without a skilled hand, which would free other studies from depending on
      who can feel one. A Doppler and a thermal camera see a vessel only by the blood moving in it. If knots are
      perforators held shut, both would find little or nothing at a held knot: its sign would be a spot that is silent and slow
      to rewarm while the knot holds, and that sounds and warms once it lets go. Ultrasound might show what the bump
      is: fluid or swollen veins where the bundle passes the fascia, a firm place where the layers do not glide
      (densification), or a nodule in muscle (trigger points, the motor switch).`,
    needs: `a pencil Doppler · ultrasound with colour Doppler and elastography · a thermal camera · people whose knots have
      been marked`,
  },
  {
    stage: 'with-knots-found',
    prong: 'knots',
    title: 'Catch a knot as it lets go',
    design: `Sham-controlled laboratory physiology, with felt releases marked as they happen`,
    what: `People who can release knots at will (bodyworkers, practitioners skilled with a foam roller, a ball, a trained
      breath or attention) might release them in a laboratory while instruments watch the tissue: skin flow by laser
      speckle or a thermal camera, ultrasound with colour Doppler and the layers' sliding, surface EMG resolved to
      single motor units. The breath might be recorded too, with its carbon dioxide, since a run of strong or quick
      out-breaths lowers it and can cause tingling by itself. A button could mark each felt release, with a spot
      pressed alike, without a knot, as the sham. After each, the person might say what followed, from nothing to
      relief, well-being or tears, and how many knots seemed to go; and the range of a stretch that the area limits
      might be measured before and after, on that side and on the other. No one would be taught a breath, or asked
      to press, breathe or work harder or longer, or to release more knots, than they usually do.`,
    show: `Each of the seven proposed mechanisms would, on its own account, leave a different trace at release, from a
      flood of flow to the skin to nothing in the tissue at all, only changes that follow the breath; a careful
      recording might begin to sort releases by kind. It might also show whether the feeling that follows a release
      comes without a roller's pain and its hard, repeated out-breaths as well, since relief, even when an expected
      pain simply does not come, is itself felt as pleasant (${cite('leknes2011')}); whether it grows with how much
      lets go; and whether the dull block eases as an area's knots let go, on the worked side alone or on both.`,
    needs: `a laboratory with ultrasound and EMG or skin-flow imaging, and a capnograph · a few skilled practitioners (study
      1 might find them) · ethics review`,
  },
  {
    stage: 'with-knots-found',
    prong: 'knots',
    title: 'Where knots sit',
    design: `Blinded mapping, with spatial statistics against chance`,
    what: `Knots might be marked over a region of the body in two ways, or both (study 1): by two examiners who can feel
