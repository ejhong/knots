---
import Doc from '../../layouts/Doc.astro';
import data from '../../data/sim/vessel.json';
import adaptData from '../../data/sim/adapt.json';
import acu from '../../data/sim/acupoints.json';
import { refById } from '../../data/references';
import { switchChart, type Switch } from '../../sim/guide/switch';
import { calibrate, curve, type Params } from '../../sim/vessel';
import { perforatorFigure } from '../../sim/perforatorFigure';
import { clocksFigure } from '../../sim/clocksFigure';

// The position paper: the perforator hypothesis argued from established physiology. The few numbers from the project's
// own calculations are read from src/data/sim/ (the wall's switch, the physics checks, the acupoint comparison); the
// field guide's tallies of reports against models are deliberately not used as evidence here.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/ejhong/knots';
const site = 'https://ejhong.github.io/knots';
const p = data.params.values as unknown as Params;
const s = calibrate(p);
const rob = data.robustness;
const col = data.checks.collar;
const cool = data.checks.cooling;
const f2 = (x: number) => x.toFixed(2);
const pct = (x: number) => `${Math.round(100 * x)}%`;
// Where a set knot lets go: the tone, as a share of resting tone, below which a fully adapted vessel reopens, for the
// healthy, hypertensive and remodelled walls of the project's adaptation study.
const adapted = adaptData as unknown as Record<string, { adapted_aopen_over_rest: number }>;
const setLets = ['healthy', 'hypertensive', 'remodel'].map((k) => adapted[k].adapted_aopen_over_rest);

// Figure 2: the wall's switch, drawn from the same model and measured parameters as the numbers in Section 3.2. Across,
// the tone of the wall; up, how far shut the vessel is, from its relaxed radius (0) to shut (1).
const wall: Switch = (() => {
  const cv = curve(p, 600);
  const shut = (x: number) => 1 - (x - p.xc) / (s.xp - p.xc);
  const open: [number, number][] = [];
  const unstable: [number, number][] = [];
  cv.x.forEach((x, i) => {
    if (x <= s.xp) (x >= s.xfold ? open : unstable).push([cv.A[i], shut(x)]);
  });
  unstable.push(open[0]);
  return {
    x_label: 'the tone of its wall (share of maximal)',
    y_label: 'shut',
    x_max: 1,
    branches: [
      { pts: open, stable: true },
      { pts: unstable, stable: false },
      { pts: [[s.Aopen, 1], [1, 1]], stable: true, held: true },
    ],
    band: [s.Aopen, s.Afold],
    marks: [{ x: s.urest, label: 'rest' }],
    note: '',
  };
})();

// Citations, numbered in order of first use; the list at the end is built from the same order.
const order: string[] = [];
const c = (...ids: string[]) => {
  const ns = ids.map((id) => {
    if (!order.includes(id)) order.push(id);
    return { id, n: order.indexOf(id) + 1 };
  });
  ns.sort((a, b) => a.n - b.n);
  return '<span class="cite">[' + ns.map(({ id, n }) => `<a href="#ref-${id}">${n}</a>`).join(', ') + ']</span>';
};
const short = (u: string) => u.replace('https://', '');
// The concept DOI: it resolves to the latest version on Zenodo.
const doi = '10.5281/zenodo.23901648';
const OWN: Record<string, string> = {
  knotsrepo: `Knots of Existence: models, parameters and runs (2026). <a href="${repo}">${short(repo)}</a>`,
  knotspreprint: `Jhong E. Knots: seven mechanisms, what each would do, and a recording that would tell them apart. Preprint (2026). <a href="${site}/research/preprint/">${short(site)}/research/preprint/</a>`,
  knotspilot: `Jhong E. A pilot recording at the moment a knot lets go: one-page protocol (2026). <a href="${site}/research/pilot/">${short(site)}/research/pilot/</a>`,
  knotspoints: `Knots of Existence. Are the perforators where the points are? (2026). <a href="${site}/research/#points">${short(site)}/research/#points</a>`,
  knotsmemories: `Jhong E. Knots as pattern memories: a two-system model of somatic release in perforators and fascial planes, with an empirically tractable research program. Preprint, Zenodo (11 September 2026). <a href="https://doi.org/10.5281/zenodo.22709006">doi.org/10.5281/zenodo.22709006</a>. An earlier version of the account, with the collar as the hold; superseded by the present paper where they differ.`,
};

// ---------- The text, in reading order ----------

const abstract = `Anyone with a foam roller can find them: small, tender places in the soft tissue that persist for years yet
can let go within seconds, sometimes with a tingle across a patch of skin. No mechanism for them is established, and no
release has been recorded as it happens. We propose one. A knot is a cutaneous perforator, a small artery travelling with
its veins and a nerve through an opening in the fascia, held shut by the smooth muscle of its own wall. Each part rests on
measured physiology. A toned small artery can snap shut and stay shut until its tone falls well below the level that shut
it; held shut for hours, it relaxes only slowly and incompletely; the breath moves the skin's sympathetic drive within
seconds; a squeeze and release widen a small artery; a nerve deprived of blood fires when blood returns; and a vessel held
shut holds shut the branches it feeds. A knot, then, is a memory with an anatomy: written by the sympathetic drive, kept by
the wall, read by the perforator's own nerve. We argue that it is now the strongest account in a specific sense: it
explains more of what is reported, with less that is new, than six alternatives in their strongest forms. We state what it
does not explain, weigh the claim that acupuncture points sit on perforators, describe runaway release, a rare and
dangerous process reported after forceful efforts to clear knots, with the slower changes in the fascia that follow it, and
give the measurements that would refute it.`;

const intro1 = [
  `Anyone with a foam roller can find them: small, discrete, tender places in the soft tissue, dozens of them, by many
  accounts densest around the hips and shoulders, and more with every decade. Massage therapists and physiotherapists call
  them knots or trigger points; contemplative traditions speak of knots in the body's channels. Pressed, a knot announces
  itself unmistakably. Stretched, it gives not the sharp pain of a muscle at the end of its range but a dull block, as
  though layers had stopped sliding past each other.`,
  `Those who work on knots, the author among them, describe a consistent set of features (Box 1). These are impressions
  gathered informally, not measurements. Some are echoed in systematic work: in a study of meditation-related challenges
  among Western Buddhist practitioners, pressure and tension that grew more acute or released in the course of practice
  were one principal set of the somatic changes reported ${c('lindahl2017')}. We take Box 1 as what any account of knots
  must explain, and no more.`,
];

const box1 = [
  `They persist until released, for years if left alone, yet any of them can let go quickly. Some are more stubborn than
  others; freeing those takes more skill, above all with the breath, and the skill takes training. The toughest may take a
  skilled practitioner a whole session, never months.`,
  `They let go within seconds, not days: under a hand, often as it lifts; under a roller; with the breath, by many accounts
  less with a single deep breath than with a subtle, complex pattern of breathing joined to fine attention to the body.`,
  `Deeper ones let go to focused attention, sometimes without touch.`,
  `Warmth helps: a hot shower softens many at once. Some find that a drink of water eases releases within about ten
  minutes, though on the account below it should not (Section 3.5).`,
  `A release can come with a small pop, or a tingle across a patch of skin.`,
  `They limit movement: a stretch meets a dull block at the knot, unlike the sharper pull of a tight muscle, and ordinary
  stretching does little to free it.`,
  `They come in families. When one lets go, others nearby may go with it, or another may appear close by; a large one can
  free smaller ones around it, not the reverse.`,
  `They gather where stress is held, and accumulate with age.`,
  `Some come back to roughly the same place.`,
];

const intro2 = `A knot that lets go within a breath cannot be a scar or an adhesion: what the body has built, it cannot
unbuild in a breath. It must be a state the body is holding, as the first essay on these knots put it
${c('jhong2026a')}: the tissue stays where it is, and the knot is a state written on it. The question is which state, held
where, and by what. Several candidates have been proposed (Section 4). We argue for one, and claim for it something
specific. At present it is the strongest account in three senses: it explains more of Box 1 than any alternative; it does
so with physiology that is already measured, adding a new identification rather than a new mechanism; and it is the
cheapest to refute.`;

const intro3 = `The hypothesis grew in public. The first essay ${c('jhong2026a')} followed Johnson's vasocomputation
${c('johnson2023')}, in which a held vascular contraction stores a state, and placed the store in a latch in the smooth
muscle of small arteries inside muscle. The second ${c('jhong2026')} moved it to the perforators, the bundles that carry an
artery, its veins and a nerve through the fascia to the skin, and supposed that a collar of gelled hyaluronan around each
held it; a longer preprint of the same month set out that version at length ${c('knotsmemories')}. Checked against physics,
the collar failed. At its most viscous, hyaluronan around a vessel pushes back about ${Math.round(col.pressure_over_drag)}
times more weakly than the blood pressure holding the vessel open ${c('nicholls2018', 'fede2018', 'knotsrepo')}, and on its
own, in physiological conditions, it stays a liquid rather than gelling ${c('krause2001')}. If anything holds a perforator shut, it
is the wall. That is the form argued here; where the earlier versions differ, this one replaces them. A companion preprint
runs seven candidate mechanisms evenly, as models ${c('knotspreprint')}; this paper argues for one.`;

const statement = `A knot is a cutaneous perforator, a small artery travelling with its veins, a nerve and a lymphatic through
an opening in a fascia, held shut by the smooth muscle of its own wall. It lets go when the wall's tone falls, or the wall is
moved, enough for the vessel to reopen; blood returning to the patch the vessel feeds wakes its nerve.`;

const claims: [string, string, string][] = [
  ['Place', `Knots sit where perforators pass through the deep fascia (the larger ones) or the superficial fascia (the smaller
  ones), at fixed sites.`, 'new'],
  ['Hold', `A small artery with tone in its wall can close and stay closed until its tone falls well below the level that
  closed it.`, 'established'],
  ['Set', `Held shut for hours, the wall's muscle adapts to its shortened length and relaxes only slowly and incompletely;
  over days the artery remodels inward. The vessel could then stay shut nearer to resting tone.`, 'established in small arteries; in knots, new'],
  ['Drive', `What carries a vessel shut is the sympathetic drive to the skin's vessels, raised by stress and moved within
  seconds by the breath. What lets it go is that drive falling, warmth, or the wall being moved: shaken, or squeezed and
  released.`, 'established physiology; its role in knots, new'],
  ['Nerve', `While the vessel is shut, the patch it feeds is underfed and tender; when blood returns, the nerve that went
  without it fires: the tingle of a release.`, 'the tingle established; the tenderness, new'],
  ['Sleeve', `Each vessel crosses the gliding layer between the fasciae in a sleeve of sliding tissue that its flow keeps
  wet; a vessel shut for long lets its sleeve stiffen, pinning the layers there: the dull block.`, 'hypothesis'],
  ['Trees', `Perforators branch from parents. A shut parent holds its children shut, and when it opens they can open with
  it; a child that opens cannot open its parent.`, 'hydraulics; in knots, new'],
];

const memory = `Read as a whole, the hypothesis describes a memory with an anatomy. In Johnson's account a held vascular
contraction acts as a medium-term memory ${c('johnson2023')}, and the essay that brought the idea to the perforators asked
what would write, store and read such a state ${c('jhong2026')}. Here the answer is concrete. The sympathetic drive writes:
stress raises it, and a perforator it carries shut stays shut as the drive eases, so long as its tone does not fall below
the band; only adaptation and remodelling let it hold at rest. The writing is local. Vessels differ in the thickness of
their walls, the pressure that feeds them and the load at their openings, so a rising drive carries a few of them across
the band at a time, not all at once. The wall keeps: its switch holds
the state, and adaptation and remodelling make it durable. The perforator's own nerve reads: as tenderness while the vessel
holds, and as a tingle when it lets go. Each perforator is a site that can be set or cleared, and a body has hundreds of
large ones and many more small ones ${c('taylor1987')}: a map of held states that a hand can find, the breath can reach and
an instrument could read.`;

const caseIntro = `No single observation below proves the hypothesis. The argument is that one anatomical object, behaving as
measured physiology says it behaves, accounts for nearly every feature in Box 1, where each alternative accounts for some.`;

const where = [
  `Perforators are discrete, numerous and fixed. Taylor and Palmer's whole-body injection studies plotted an average of 374
  major perforators in each body, the arteries closely following the connective-tissue framework ${c('taylor1987')}. They
  pierce the deep fascia at sites that recur from person to person: the clusters are shared, but the individual vessels
  scatter around their cluster's centre, in the leg with standard deviations of 6–11% of the tibia's length, roughly 2–4 cm
  ${c('martin2013')}, and differ between the two sides of one body ${c('rozen2010b')}. That is how knots are described: in the same regions in everyone, never at quite the same
  point.`,
  `They are also where the layers are held. The superficial fascia is tied to the deep fascia by fibrous bands, the
  retinacula cutis, which work as tethers and anchors ${c('dowlatshahi2026')}, and perforators cross the same gap, large and
  sparse where the skin is mobile, smaller and denser where it is tethered ${c('taylor1992')}. Pressure from above presses
  each bundle against the firm deep fascia beneath it: a hand or a roller meets a perforator where it can squeeze it.`,
  `And perforator exits are already used to find tender points. In entrapment of the cutaneous nerves of the abdominal
  wall, the perforating vessels' exit through the rectus fascia beneath the point of maximal pain is found by Doppler and
  used as the landmark for injection ${c('weum2016')}; lidocaine injected at the point of maximal pain relieved it in 13 of
  24 patients, saline in 4 of 24 ${c('boelens2013')}; and a case report describes a tender point with a pulsating
  perforating artery directly beneath it on Doppler, after whose release with fluid the sign placing the pain in the
  abdominal wall disappeared and pain and movement improved ${c('yoshinaga2025')}. These implicate the nerve as much as the vessel. They show that the address is right.`,
];

const hold = [
  `A small artery is a balance between the pressure inside it, pushing it open, and the tension of its muscle, pulling it
  shut. Burton showed that with active tension in the wall the balance has no stable open state below a critical pressure:
  the vessel snaps shut ${c('burton1951')}. Whole vascular beds stop flowing at such a critical closing pressure
  ${c('nichol1951')}, and failing skin flaps show it ${c('cutting1982')}. Because a muscle is weak when it is very short
  ${c('mulvany1979')}, a vessel that has closed needs far less tone to stay closed than it took to close it. Over a band of
  tone, open and shut are both stable, and a shut vessel reopens only when its tone falls below the band, when outside
  pressure is relieved, or when the pressure feeding it rises ${c('miller2026')}. In living tissue, nerves hold some small
  arterioles fully closed at rest: in the muscle of anaesthetised rats, cutting them opened 22% more ${c('bohlen1979')}.`,
  `With the measured strength and wall thickness of human small arteries ${c('mulvany1979', 'schiffrin1995')}, the
  project's model of the wall finds that band between ${f2(s.Aopen)} and ${f2(s.Afold)} of maximal tone, with rest at about
  ${f2(s.urest)} (Figure 2). Across ${rob.samples.toLocaleString('en-GB')} plausible parameter sets, about half
  (${pct(rob.share_bistable)}) give the switch, and only ${pct(rob.share_holds_at_rest)} hold shut at resting tone
  ${c('knotsrepo')}. The hold is possible but demanding: a healthy vessel holds itself shut only while its tone stays well
  above rest. Thicker walls, as in hypertension ${c('schiffrin1995')}, make it easier.`,
];

const gaspNone = rob.share_gasp_shuts_at_rest === 0;
const forms = `How a knot forms follows from the band. Shutting a vessel takes a surge: in the project's model, with measured
parameters, the tone that snaps it shut is about ${Math.round(s.Afold / s.urest)} times its resting tone, and a deep breath at
rest, sized to the fall in fingertip flow it causes (Section 3.4), shuts no vessel in
${gaspNone ? 'any' : `${pct(1 - rob.share_gasp_shuts_at_rest)}`} of the
${rob.samples.toLocaleString('en-GB')} plausible parameter sets ${c('knotsrepo')}. A fright, pain, cold or a squeeze can:
local cooling all but stops the skin's flow ${c('charkoudian2003')}, and pressure from outside lowers the tone it takes
${c('miller2026')}. Staying shut takes less, but the stress must last: a constriction of five minutes leaves no trace
${c('hill2003', 'martinezlemus2004')}, while one of hours begins to set. A knot, on this account, is the trace of a coincidence, a surge and a
stress that outlasted it; a brief stress leaves none. That may be why knots gather where stress is held for long, and why
children have few.`;

const set = `Smooth muscle adapts to the length at which it is held. Arterioles constricted for five minutes relax fully when
the drive is removed; after four hours they relax slowly ${c('hill2003')} and incompletely, their cells repositioned to hold
the smaller diameter ${c('martinezlemus2004')}, though the hold still needs calcium and goes at once without it
${c('hill2003')}. Smooth muscle held short regains much of the force it lost there ${c('syyong2008', 'bednarek2011')}, and
resistance arteries kept constricted for three days remodel inward, their relaxed lumen 10–16% smaller ${c('bakker2002')}. A
vessel held shut long enough might then hold nearer to rest: the knot would set, and the setting would deepen with time,
while still answering to whatever lowers the wall's calcium. A set knot would be more stubborn: holding at rest, it lets go
only when the drive falls well below rest, in the model when the wall's tone falls to between ${pct(Math.min(...setLets))} and
${pct(Math.max(...setLets))} of its resting level ${c('knotsrepo')}, and the slower relaxation of arterioles held for hours
suggests it may also take longer to go. Practitioners describe knots that differ in how stubborn they are, any of which a
trained breath can free quickly; on this account, that asks the breath to take the drive, or the wall's calcium, well below
rest (Section 8). The setting also predicts something an isolated vessel can show (Section 7).`;

const breath = `The skin's small arteries are governed by sympathetic nerves: skin blood flow runs from almost nothing under
local cooling to several litres a minute in heat ${c('charkoudian2003')}, and about a third of the superficial fascia's
nerve fibres are autonomic, gathered around its vessels ${c('fede2022')}. The breath reaches this drive within seconds. A
deep inspiration constricts the skin's vessels ${c('bolton1936')}, cutting fingertip flow by 59–71% ${c('lau1995')},
beginning 3.6–3.8 s after the breath, deepest at about 5 s, and recovering over the following ten to thirty seconds
${c('mayrovitz2026')}. Slow breathing works the other way: fifteen minutes of it lowered sympathetic activity to muscle by
five bursts in every hundred heartbeats ${c('adler2019')}. A single deep breath, then, briefly raises the drive to the skin's
vessels, which may be why releases are reported less with one deep breath than with a subtler pattern (Box 1). These
measurements come from the skin of the fingers and toes, unusually rich in sympathetic control, and from the nerves to
muscle; whether the breath moves the drive to the perforators of the trunk as fast, or as far, is not known. Movement is a
possible second route: vibration cuts the active force of vascular smooth muscle at once ${c('ljung1975')}, but at 1 to 400
cycles a second, far faster than a breath, and whether the slow stretch of breathing does the same is untested. Which route
matters, and which pattern of breathing serves it, is open; the hypothesis requires only that a releasing breath lower the
drive more than it raises it, or move the wall.`;

const hands = `A vessel pressed shut from outside cannot reopen while the pressure lasts; it can reopen as the pressure
lifts ${c('miller2026')}. A knot under a hand should therefore let go as the hand lifts or eases, not while it presses.
Squeezed and released, the feed arteries of rat muscle widen within seconds, and several brief squeezes widen them more
than one long one ${c('clifford2006')}: a roller's passes are a series of brief squeezes, and it shears the tissue around the vessel as well.
Heat acts more slowly and more widely. Local warming raises the skin's flow most of the way to its maximum
${c('minson2001')}, but a patch of skin warms with a time constant of about ${Math.round(cool.tau_s_at_max_flow)} s even
at maximal flow ${c('knotsrepo')}: too slow to free a knot within a breath, fast enough over the minutes of a hot shower,
and everywhere the water touches.`;

const water = `Some also find that a drink of water eases releases within about ten minutes (Box 1). On this account it
should not. Drinking water raises the sympathetic drive: in healthy people the nerves to muscle fire more, most at half an
hour, and the calf's vessels narrow ${c('scott2001')}, and in young men half a litre lowers the skin's flow in the palm at
twenty-five minutes ${c('lu2012')}. Systolic pressure, which would help a shut vessel open (Section 3.2), rises by about
11 mmHg in older people and not in the young ${c('jordan2000')}. A narrower vessel in the skin is a harder knot to free, so
in the young, whose pressure does not rise, the report counts against the hypothesis, unless the drinker was short of
water: after exercise that dehydrates, resting blood pressure is lower, and fluid given by vein lowers the drive to muscle
${c('charkoudian2003b')}; whether a drink does the same is not measured. A recording would tell (Section 7). Nor is water
harmless in quantity: more than five litres drunk within a few hours has diluted the blood's sodium enough to swell the
brain, and has killed ${c('gardner2002')}.`;

const spark = `While a perforator is shut, the patch it feeds is underfed, and so is the nerve that travels with it.
Underfed, not starved: a perforator's territory is linked to its neighbours' by anastomoses ${c('taylor2011')}, through
which some blood can still come. At active trigger points the tissue is acidic and rich in the substances that sensitise
pain nerves ${c('shah2005')}; an underfed patch of skin and fascia could build the same chemistry, and its nerve would be
tender to pressure. On this account a knot is tender because it is shut. When flow returns after a five-minute arterial
occlusion of the forearm, the skin's flow overshoots, rising by about 187% and peaking about 11 s after the release
${c('alexandrou2021')}, a response in which sensory nerves and BKCa channels take part ${c('lorenzo2007')}. A nerve that has
gone without blood also fires on its own when the blood returns: recorded in human sensory nerves, this firing begins about
half a minute after circulation is restored and peaks by the second minute, as the felt tingling does ${c('ochoa1980')}.
When a shut perforator opens, blood floods its patch and the nerve that went without it fires: on a small scale, the
prickle of a limb waking after pressure. The tingle should follow the opening within about a minute and cover the vessel's
territory, a patch of skin rather than a line ${c('taylor2011')}. Two cautions. Overbreathing increases such firing
${c('ochoa1980')}, so a tingle during forceful breathing is weak evidence by itself; and a single perforator's flood is far
smaller than a cuff's, which is why a recording needs a pressed sham beside it (Section 7).`;

const block = `Each perforator crosses the gliding layer between the superficial and deep fasciae, a web of small fluid-filled
cells that lets skin, fat, fascia and vessels slide past each other ${c('guimberteau2005')}. The vessel's flow keeps its
stretch of this web wet. Shut for long, the sleeve would dry and stiffen. This is not the collar of Section 1.3, which had
to hold a vessel shut against the blood pressure and could not. The sleeve need only resist the small shear of layers
sliding past each other, and for that it needs a material that holds until pushed past a threshold. The gliding layer
offers candidates: crowding and immobility raise hyaluronan's concentration and viscosity and reduce the gliding of the
layers, and in inflammation modified hyaluronan can form aggregates or gel-like structures ${c('cowman2015')}; materials of
this kind can jam below a critical stress and give way abruptly above it ${c('coussot2002')}. A jammed sleeve pins the
layers at that point, and a stretch meets a block there. Fascial layers glide less in chronic low back pain
${c('langevin2011')}, and the loose sublayers of the neck's fascia are thicker in chronic neck pain ${c('stecco2014')}. The
sleeve is the least established part of the hypothesis, and it predicts an order a recording could check: the flood and the
tingle as the vessel opens, the sliding only once the layer is moved.`;

const trees = `Perforators form trees: a parent vessel feeds children around it. A child cannot flow while its parent is
shut, so a shut parent holds its children shut, and when the parent opens, those not held by their own walls open with it.
A child that opens does nothing for a parent that stays shut. The asymmetry is hydraulic: pressure comes from the source.
Signals along the wall would not supply it, for a dilation started on an arteriole spreads both ways ${c('segal1986')},
fading with a length constant of about two millimetres, and those started on daughter vessels sum in the parent
${c('segal1989')}; over the centimetres between one perforator and the next, they would have faded. Release should then run
in families: freeing a large knot frees small ones around it, and freeing a small one does not free the large one.
Trigger-point practice describes a similar order: dry needling a key trigger point raised the pressure-pain threshold of
satellite points in its zone of referred pain ${c('hsieh2007')}, though a spinal mechanism has been proposed for it.`;

const age = `Small mesenteric arteries from organ donors over sixty-five contract more strongly to adrenergic stimulation
${c('elassar2022')}, and resting sympathetic activity to muscle rises with age ${c('ng1993')}; older skin reaches a lower
maximal flow when heated ${c('vionnet2014')}. All three would make vessels likelier to hold and harder to flood open. But the
skin's reflex vasoconstriction is blunted with age ${c('holowatz2010')}, so whether the drive to the skin's own vessels rises
is not settled. The hypothesis predicts that the number of knots tracks the loss of the skin's microvascular reactivity,
place by place, and that children have few.`;

const clocksCap = `Figure 3. The clocks. How fast knots are reported to change (terracotta; rough, from Box 1), beside how
fast the physiology the hypothesis names is measured to change (slate). A deep breath narrows the skin's vessels from 3.6 s,
most at about 5 s, recovering over the following ten to thirty seconds ${c('mayrovitz2026')}; a reopened vessel's flow peaks
about 11 s after release ${c('alexandrou2021')}; a patch of skin warms with a time constant of
${Math.round(cool.tau_s_at_max_flow)} s at maximal flow and ${Math.round(cool.tau_s_at_tenth_flow)} s at a tenth of it
${c('knotsrepo')}; arterioles constricted for five minutes keep no trace of it, and after four hours relax only slowly and
incompletely ${c('martinezlemus2004', 'hill2003')}; arteries constricted for three days remodel inward ${c('bakker2002')}.
The slower changes in the fascia (Section 5) are reported over days to weeks. The shaded band is a breath.`;

// Table 1: what the hypothesis accounts for, and on what.
const T1: [string, string, string, string][] = [
  ['Discrete, tender places in the same regions in everyone', 'Perforator exits: fixed sites, shared clusters; tender because shut', c('taylor1987', 'martin2013', 'weum2016', 'shah2005'), 'Identity untested'],
  ['They persist until released; some are stubborn', 'A wall that holds itself shut; muscle that adapts; an artery that remodels', c('burton1951', 'martinezlemus2004', 'bakker2002'), 'Each measured; together untested'],
  ['They let go within seconds', 'A shut vessel reopens as soon as its tone falls below the band', c('burton1951', 'nichol1951', 'miller2026'), 'Established mechanism'],
  ['With the breath', 'A deep breath raises the drive for seconds; slow breathing lowers it', c('mayrovitz2026', 'adler2019'), 'Measured in fingers and in nerves to muscle; in knots, untested'],
