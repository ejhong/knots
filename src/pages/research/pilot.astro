---
// The one-page pilot protocol (28 Sep) is retired: its recording is now one of the experiments on the Research page.
// The address stays because the position paper (Zenodo, draft 3) cites it.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = `${base}/research/#experiments`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Knots of Existence: experiments that would help</title>
  </head>
  <body>
    <p>The pilot is now one of <a href={to}>the experiments that would help</a>, on the Research page.</p>
  </body>
</html>
