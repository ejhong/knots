    color: var(--accent-dark);
  }
  .caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 11.5px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 760px;
    margin: 6px 0 14px;
  }
  @media (max-width: 700px) {
    .two {
      grid-template-columns: minmax(0, 1fr);
