    font-family: var(--font-serif);
    font-size: 12.5px;
    line-height: 1.55;
  }
  .pt-facts {
    max-width: 820px;
    margin: 6px 0 4px;
  }
  .pt-table {
    overflow-x: auto;
    max-width: 940px;
    margin: 6px 0 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
