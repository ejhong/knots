---
import Doc from '../../layouts/Doc.astro';
import guide from '../../data/sim/guide.json';
import type { GuideIndex, Trait } from '../../sim/guide/data';
import { envelopeChart } from '../../sim/guide/envelope';

const g = guide as unknown as GuideIndex;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/ejhong/knots/blob/main';
const films = g.scenes.filter((s) => s.film);
const GROUPS: [string, string][] = [
  ['feel', 'What it feels like'],
  ['where', 'Where they are'],
  ['many', 'How many'],
  ['form', 'How and when they form'],
  ['release', 'How and when they let go'],
  ['move', 'How they move'],
  ['time', 'Over time'],
  ['record', 'What an instrument would record'],
];
const MARK: Record<string, string> = { all: '●', some: '◐', none: '○', silent: '—', not: '·' };
const MARK_WORD: Record<string, string> = {
  all: 'in every setting',
  some: 'in some settings',
  none: 'in no setting',
  silent: 'the account says nothing',
  not: 'not modelled',
};
const ROWS: [string, string][] = [
  ['inside', 'Felt from inside'],
  ['bump', 'Found by a finger'],
  ['where', 'Where'],
  ['many', 'In a 4 cm patch'],
  ['forms', 'How they form'],
  ['breath', 'Slow breathing'],
  ['attention', 'Attention, no touch'],
  ['micro', 'Subtle breaths, attending'],
  ['needs', 'What a breath must do'],
  ['hand', 'A resting hand'],
  ['letgo', 'How it lets go'],
  ['spark', 'A spark'],
  ['move', 'After one lets go'],
  ['family', 'Parents and children'],
  ['time', 'Held for hours'],
  ['record', 'What a recording shows'],
];
const traitOf = (id: string, key: string): Trait | undefined => g.theories.find((t) => t.id === id)?.traits.find((x) => x.id === key);
const mins = (s: number) => (s >= 120 ? `${Math.round(s / 60)} min` : `${Math.round(s)} s`);
const index = [
  { id: 'guide', label: 'the field guide' },
  { id: 'close', label: 'up close' },
  { id: 'differ', label: 'how they differ' },
  { id: 'notyet', label: 'not yet modelled' },
  { id: 'made', label: 'how it is made' },
];
---
<Doc
  title="How would a knot behave?"
  kicker="Simulation · a field guide"
  current="simulation"
  lede="Each theory, run as a model from its own physiology, grows its own knots in the same patch of body. Choose a scene and watch how they would form, feel, let go and move. Nothing here is fitted to anyone's reports: it is what each mechanism would do."
  description="A field guide to knots: seven theories of what a knot is, four of them run as models from their own physiology in the same patch of body, showing how their knots would form, feel, let go and move, and what an instrument would record."
  glyph="験"
  index={index}
  wide
>
  <section id="guide" class="sec full" data-glyph="観">
    <div class="instrument" data-guide>
      <div class="scenes" role="group" aria-label="Scenes">
        {films.map((s) => (
          <button class="chip" type="button" data-scene={s.id} aria-pressed="false">
            {s.name} <span class="dur">{mins(s.duration)}</span>
          </button>
        ))}
      </div>
      <p class="what" data-what></p>
      <div class="patches">
        {g.theories.map((th) => (
          <div class="card" data-card={th.id} tabindex="0" role="button" aria-label={`${th.name}: see it up close`}>
            <p class="card-head"><span class="glyph">{th.glyph}</span> {th.name} <span class="count" data-count={th.id}></span></p>
            <canvas class="patch" data-patch={th.id} aria-hidden="true"></canvas>
            <p class="caption" data-caption={th.id} aria-live="polite"></p>
          </div>
        ))}
      </div>
      <div class="transport">
        <button class="play" type="button" data-play aria-label="Play">▶</button>
        <div class="track">
          <svg class="timeline" data-timeline preserveAspectRatio="none" aria-hidden="true"></svg>
          <input class="scrub" type="range" min="0" max="100" step="0.5" value="0" data-scrub aria-label="Time in the scene" />
        </div>
      </div>
      <p class="clock mono" data-clock></p>
      <p class="key mono">
        <span><i class="k-knot"></i>a knot</span>
        <span><i class="k-spark"></i>letting go</span>
        <span><i class="k-hand"></i>a hand, a roller</span>
        <span><i class="k-att"></i>attention</span>
        <span><i class="k-stress"></i>where stress is held</span>
        <span>the breath's wave, and the stress, run along the timeline · model output: it measures nothing</span>
      </p>

      <div id="close" class="close">
        <p class="close-title" data-close-title></p>
        <div class="close-grid">
          <div>
            <canvas class="patch big" data-patch-close aria-hidden="true"></canvas>
            <p class="small mono">From above: 4 cm of the upper back, the neck toward the top, the muscle's fibres running across.</p>
          </div>
          <div>
            <p class="small mono">Beneath the spot</p>
            <div class="plate" data-plate></div>
            <p class="small mono">What instruments would record there, through the scene</p>
            <div class="inst" data-inst></div>
          </div>
        </div>
      </div>
    </div>

    {g.theories.map((th, i) => (
      <div class="traits" data-traits={th.id} id={th.key} hidden={i !== 0}>
        <h2>{th.glyph} {th.name}: how its knots would behave</h2>
        <p class="sub">Every line comes from running the model through the scenes in {g.run.settings} settings, each a draw across the
          plausible range of every uncertain number. {th.layout.note[0].toUpperCase() + th.layout.note.slice(1)}.</p>
        {GROUPS.map(([gid, glabel]) => {
          const ts = th.traits.filter((t) => t.group === gid);
          return ts.length ? (
            <div class="group">
              <p class="group-h mono">{glabel}</p>
              <ul>
                {ts.map((t) => (
                  <li class={`t t-${t.mark}`}>
                    <span class="mk" title={MARK_WORD[t.mark]} aria-label={MARK_WORD[t.mark]}>{MARK[t.mark]}</span>
                    <span><strong>{t.label}.</strong> {t.text}{t.depends && <span class="dep"> ({t.depends})</span>}</span>
                  </li>
                ))}
              </ul>
            </div>
          ) : null;
        })}
        <p class="legend mono">● in every setting (a structural prediction) · ◐ in some (with the number it depends on most) · ○ in none · — the account says nothing</p>
      </div>
    ))}
  </section>

  <section id="differ" class="sec full" data-glyph="別">
    <h2>How they differ</h2>
    <p class="sub">The same scenes, four answers. Where two columns part on something a hand or an instrument can tell, that is a test
      (see{' '}<a href={`${base}/research/#measurement`}>the measurement</a>).</p>
    <h3 class="h3">What a breath would have to do</h3>
    <p class="sub">However complex its pattern, a breath reaches a knot only through a few routes: the drive to its vessels or its motor
      units, the tissue's movement, attention. So the models need its effect, not its pattern. For each theory: the least calming of the
      knot's own drive, aimed at it and held for a time, that frees the typical knot (thick line) and the easiest quarter (thin), in 32
      settings. The grey bars are what a breath does. Perception has no drive of its own at a place, so its calming is of arousal,
      everywhere.</p>
    <figure class="env" set:html={envelopeChart(g.theories)} />
    <div class="table-wrap">
      <table class="differ">
        <thead>
          <tr><th></th>{g.theories.map((th) => <th scope="col"><span class="glyph">{th.glyph}</span> {th.name}</th>)}</tr>
        </thead>
        <tbody>
          {ROWS.map(([key, label]) => (
            <tr>
              <th scope="row">{label}</th>
              {g.theories.map((th) => {
                const t = traitOf(th.id, key);
                return <td>{t ? <><span class="mk" aria-hidden="true">{MARK[t.mark]}</span> {t.cell}</> : '—'}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="notyet" class="sec full" data-glyph="未">
    <h2>Not yet modelled</h2>
    <div class="notyet">
      {g.not_yet.map((n) => (
        <article>
          <p class="ny-h"><span class="glyph">{n.glyph}</span> {n.name}</p>
          <p>{n.why}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="made" class="sec full" data-glyph="法">
    <h2>How it is made</h2>
    <div class="made prose">
      <p>Each theory is a model in its strongest form (<a href={`${base}/hypotheses/`}>Hypotheses</a>), every number taken from a quoted line of
        a paper or marked as a guess with a range. The same patch, the same scenes, the same hand and breath for every theory; each places its
        own units where its anatomy puts them. What is felt comes from one rule for all: a hand feels stiffness through skin and fat, fainter
        the deeper it lies. The films show one typical setting; the lines below each theory speak for all {g.run.settings}. In every theory a
        stressful moment forms knots and the held stress keeps them: that is how stress is scaled, not a finding.</p>
      <p>A model shows what a mechanism would do; it measures nothing, and it cannot say which theory is true. The scenes are things that
        happen to a model, not instructions. Deep somatic and meditative work carries real risks: see the site's
        <a href={`${base}/about/#moderation`}>moderation guidance</a>.</p>
      <p class="links mono">
        <a href={`${base}/simulation/vessel/`}>one perforator up close</a>
        <a href={`${base}/research/`}>research</a>
        <a href={`${repo}/sim/PLAN.md`}>the plan</a>
        <a href={`${repo}/sim/findings/guide.md`}>every trait, as a note</a>
        <a href={`${repo}/sim/knots_sim/guide/`}>the engine</a>
        <a href={`${repo}/sim/params/`}>every number</a>
      </p>
      <p class="stamp mono">run {g.run.inputs}{g.run.commit ? ` · commit ${g.run.commit}` : ''} · {g.run.settings} settings per theory</p>
    </div>
  </section>
</Doc>

<script>
  import { mountGuide } from '../../sim/guide/player';
  const root = document.querySelector<HTMLElement>('[data-guide]');
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  if (root) mountGuide(root.closest('section') as HTMLElement, base);
</script>

<style>
  .mono {
    font-family: var(--font-mono);
  }
  .sub {
    max-width: 720px;
    margin: 4px 0 14px;
    font-family: var(--font-serif);
    font-size: 13.5px;
    line-height: 1.65;
  }
  .instrument {
    background: var(--panel-bg);
    border-radius: var(--radius);
    padding: 16px 18px 14px;
    color: var(--panel-text);
    box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.35);
  }
  .scenes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--panel-muted);
    background: transparent;
    border: 1px solid var(--panel-line);
    border-radius: 999px;
    padding: 4px 10px;
    cursor: pointer;
  }
  .chip .dur {
    color: var(--panel-faint);
    margin-left: 4px;
  }
  .chip[aria-pressed='true'] {
    color: var(--panel-text);
    border-color: #c9a77c;
    background: rgba(201, 167, 124, 0.12);
  }
  .what {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 12.5px;
    color: var(--panel-muted);
    margin: 10px 2px 12px;
    min-height: 1.4em;
  }
  .patches {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .card {
    background: #1b2023;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 8px 8px 6px;
    cursor: pointer;
    outline: none;
  }
  .card:hover,
  .card:focus-visible {
    border-color: var(--panel-line);
  }
  .card.on {
    border-color: #6f7c79;
  }
  .card-head {
    margin: 0 0 6px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .glyph {
    font-family: var(--font-cjk);
    color: var(--jade-light);
    font-weight: 400;
  }
  .count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    color: #e27b61;
  }
  .patch {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 6px;
  }
  .caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--panel-muted);
    margin: 6px 2px 0;
    min-height: 3em;
  }
  .transport {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
  }
  .play {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid #c9a77c;
    background: rgba(201, 167, 124, 0.12);
    color: #e6dccd;
    font-size: 12px;
    cursor: pointer;
    flex: none;
  }
  .track {
    position: relative;
    flex: 1;
    height: 46px;
  }
  .timeline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .scrub {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .clock {
    font-size: 10px;
    color: var(--panel-faint);
    margin: 6px 0 0 44px;
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font-size: 9.5px;
    color: var(--panel-faint);
    margin: 10px 0 0;
  }
  .key i {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-right: 5px;
    vertical-align: -1px;
  }
  .k-knot {
    background: #e27b61;
    box-shadow: 0 0 6px #e27b61;
  }
  .k-spark {
    background: #a8e6cd;
  }
  .k-hand {
    background: rgba(201, 167, 124, 0.5);
    border: 1px solid #c9a77c;
  }
  .k-att {
    border: 1px dashed #a8e6cd;
  }
  .k-stress {
    background: rgba(201, 164, 95, 0.35);
  }
  .close {
    margin-top: 18px;
    border-top: 1px solid var(--panel-line);
    padding-top: 14px;
  }
  .close-title {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 10px;
  }
  .close-grid {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }
  .small {
    font-size: 9.5px;
    color: var(--panel-faint);
    margin: 6px 0;
  }
  .plate :global(svg),
  .inst :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    background: #1b2023;
    border-radius: 6px;
  }
  .traits {
    margin-top: 22px;
    max-width: 820px;
  }
  .traits h2 {
    margin-bottom: 2px;
  }
  .group {
    margin: 12px 0 0;
  }
  .group-h {
    font-size: 9.5px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--seal);
    margin: 0 0 4px;
  }
  .traits ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }
  .t {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    font-family: var(--font-serif);
    font-size: 13px;
    line-height: 1.58;
  }
  .t strong {
    font-family: var(--font-sans);
    font-size: 12.5px;
  }
  .mk {
    color: var(--accent-dark);
    font-size: 12px;
  }
  .dep {
    color: var(--muted);
    font-style: italic;
  }
  .legend {
    font-size: 9.5px;
    color: var(--muted);
    margin-top: 12px;
  }
  .table-wrap {
    overflow-x: auto;
  }
  .h3 {
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 700;
    margin: 18px 0 2px;
  }
  .env {
    margin: 6px 0 22px;
    max-width: 780px;
    overflow-x: auto;
  }
  .env :global(svg) {
    display: block;
    width: 100%;
    min-width: 560px;
    height: auto;
  }
  .differ {
    border-collapse: collapse;
    font-family: var(--font-serif);
    font-size: 12.5px;
    min-width: 640px;
  }
  .differ th,
  .differ td {
    text-align: left;
    vertical-align: top;
    padding: 6px 12px 6px 0;
    border-bottom: 1px solid var(--border);
  }
  .differ thead th {
    font-family: var(--font-sans);
    font-size: 12px;
  }
  .differ tbody th {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    color: var(--muted);
    white-space: nowrap;
  }
  .notyet {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .notyet article {
    background: var(--frame-bg);
    border-radius: 8px;
    padding: 12px 14px;
    font-family: var(--font-serif);
    font-size: 12.5px;
    line-height: 1.55;
  }
  .notyet p {
    margin: 0 0 6px;
  }
  .ny-h {
    font-family: var(--font-sans);
    font-weight: 700;
  }
  .made p {
    max-width: 760px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 10px;
  }
  .stamp {
    font-size: 9.5px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .patches {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .close-grid,
    .notyet {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .instrument {
      padding: 12px 10px;
    }
    .card-head {
      font-size: 11px;
      flex-wrap: wrap;
      gap: 2px 5px;
    }
    .count {
      margin-left: 0;
      width: 100%;
    }
    .patches {
      gap: 8px;
    }
    .caption {
      font-size: 10.5px;
    }
  }
</style>
