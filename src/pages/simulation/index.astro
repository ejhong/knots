---
// The field guide now lives on the Hypotheses page, beside what each theory says: this address sends visitors there.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = `${base}/hypotheses/#watch`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Knots of Existence: the field guide has moved</title>
  </head>
  <body>
    <p>The field guide is now on <a href={to}>the Hypotheses page</a>.</p>
  </body>
</html>
