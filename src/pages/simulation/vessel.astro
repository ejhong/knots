---
import Doc from '../../layouts/Doc.astro';
import data from '../../data/sim/vessel.json';
import { refById } from '../../data/references';
import adaptData from '../../data/sim/adapt.json';
import { bandScale, logBars, sectionDrawing, shareBars, switchDiagram, tracesFrame } from '../../sim/draw';
import { knotSets, treeStory, type AdaptStudy, type TreeFigure } from '../../sim/figures';
import { calibrate, type Params } from '../../sim/vessel';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const p = data.params.values as unknown as Params;
const s = calibrate(p);
const r = data.robustness;
const v = data.validation;
const col = data.checks.collar;
const cool = data.checks.cooling;
const guessedCount = (data.params.vessel as { confidence: string }[]).filter((row) => row.confidence === 'guessed').length;
const sc = data.scenarios as Record<string, { summary: { events: { t: number; to: string }[]; peak_flow: number; peak_spark: number; peak_debt: number; flow_before_open: number | null; flow_after_open: number | null } }>;
const opened = (name: string) => sc[name].summary.events.find((e) => e.to === 'open')?.t ?? NaN;
const eased = opened('stress_eases') - 110;
const pressed = opened('press_and_release') - 150;
const f2 = (x: number) => x.toFixed(2);
const pct = (x: number) => `${Math.round(100 * x)}%`;
const cite = (id: string) => {
  const ref = refById(id);
  if (!ref) return id;
  const who = ref.authors.split(',')[0].split(' et al')[0].replace(/\s+\S+$/, '');
  return `<a class="cite" href="${base}/library/#${id}">${who} ${ref.year}</a>`;
};
const SOBOL_LABEL: Record<string, string> = {
  width: 'length–tension width',
  wall: 'wall thickness',
  r100: 'vessel size',
  P: 'pressure inside',
  xopt: 'stretch of greatest force',
  xc: 'shut radius',
  Tmax: 'maximal tension',
  beta: 'passive stiffness',
  porh_rise: 'size of hyperaemia',
  gasp_drop: 'size of the gasp reflex',
};
const sobol = Object.entries(r.sobol.to_hold)
  .map(([k, x]) => ({ label: SOBOL_LABEL[k] ?? k, value: Math.min(1, Math.max(0, x.ST)) }))
  .sort((a, b) => b.value - a.value)
  .slice(0, 5);
type Row = { key: string; label: string; symbol: string; value: number; unit: string; confidence: string; source?: string; locator?: string; quote?: string; note?: string; fit?: string; range?: number[] };
const vesselRows = data.params.vessel as Row[];
const checkRows = (data.params.checks as Row[]).filter((x) => x.unit !== '—');
const quoteRows = (data.params.checks as Row[]).filter((x) => x.unit === '—');
const fmt = (x: number) =>
  Math.abs(x) >= 1e4 || (Math.abs(x) < 1e-3 && x !== 0) ? x.toExponential(2).replace('e', '×10^').replace('+', '') : Number(x.toPrecision(3)).toLocaleString('en-GB');
const unit = (u: string) => u.replace('r100²', 'r₁₀₀²').replace('r100', 'r₁₀₀');
const shown = (row: Row) => {
  if (row.key === 'r100' || row.key === 'collar_thickness') return `${fmt(row.value * 1e6)} µm`;
  if (row.key === 'layer_depth') return `${fmt(row.value * 1000)} mm`;
  if (row.unit === 'J/m³·K') return `${fmt(row.value / 1e6)} MJ/m³·K`;
  return `${fmt(row.value)}${row.unit && row.unit !== '1' ? ` ${unit(row.unit)}` : ''}`;
};
const range = (row: Row) => {
  if (!row.range) return '';
  const [a, b] = row.range;
  if (row.key === 'r100' || row.key === 'collar_thickness') return `${fmt(a * 1e6)}–${fmt(b * 1e6)} µm`;
  if (row.key === 'layer_depth') return `${fmt(a * 1000)}–${fmt(b * 1000)} mm`;
  if (row.unit === 'J/m³·K') return `${fmt(a / 1e6)}–${fmt(b / 1e6)}`;
  return `${fmt(a)}–${fmt(b)}`;
};
/** Symbols as written in the tables (T_max, τ_down) with their subscripts set as subscripts. */
const sym = (x: string) => x.replace(/_([^_\s]+)$/, '<sub>$1</sub>');
// How a knot sets over hours (sim/knots_sim/adapt.py), and a tree of vessels (sim/knots_sim/models/tree.py).
const healthyRatio = s.Aopen / s.urest;
const ad = adaptData as unknown as AdaptStudy;
const setAt = (rows: { mult: number; hours: number | null }[], m: number) => rows.find((row) => Math.abs(row.mult - m) < 1e-9)?.hours ?? NaN;
const holdMult = ad.stories.hold_mult;
const setHealthy = setAt(ad.healthy.set_h, holdMult);
const hyFirst = ad.hypertensive.set_h.find((row) => row.hours !== null)!;
const oldKnot = ad.flushes.filter((row) => row.holds_at_rest).at(-1)!;
const adRob = ad.robustness;
const creep15 = ad.healthy.creep_h[0];
const tree = data.tree as unknown as { figure: TreeFigure & { u_m: number }; robustness: Record<string, number>; siblings: { siblings: number; shut_by_surge: number; shut_alone: number } };
const tr = tree.robustness;
const treeQueue = (data.tree as unknown as { queue: { drive: number[]; remain: number[]; parent_knot: boolean[] } }).queue;
const index = [
  { id: 'switch', label: 'the switch' },
  { id: 'checks', label: 'four checks' },
  { id: 'predicts', label: 'what it predicts' },
  { id: 'sure', label: 'how sure' },
  { id: 'measured', label: 'against measurements' },
  { id: 'time', label: 'how a knot sets' },
  { id: 'trees', label: 'a parent and its children' },
  { id: 'numbers', label: 'every number' },
  { id: 'made', label: 'how it was made' },
];
const repo = 'https://github.com/ejhong/knots/blob/main';
---
<Doc
  title="Can a knot hold?"
  kicker="Hypotheses · perforators, up close"
  current="hypotheses"
  lede="If a knot is a perforator held shut, something has to hold it, and it has to let go within seconds. A first model, built only from published measurements, finds that the vessel can hold itself."
  description="A small artery with tone in its wall is a switch: open or shut over a band of tone. A live model of one perforator, built from published measurements, and four checks of what could hold a knot."
  glyph="験"
  index={index}
  wide
>
  <section id="switch" class="sec full" data-glyph="結">
    <h2>One perforator, running</h2>
    <div class="prose intro">
      <p>
        A perforator's small artery, 0.24 mm across. Blood pushes its wall out; the wall pulls in with its own elastic
        tension and with the tone of its muscle. Over a band of tone both answers balance: an open vessel snaps shut
        when tone passes the fold, and a shut one stays shut until tone falls well below it. Every number comes from a
        measurement listed at the foot of the page, and the few that are guesses say so.
      </p>
    </div>

    <div class="bench" data-bench>
      <figure class="fig fig-cs" set:html={sectionDrawing()} />
      <figure class="fig fig-sw" set:html={switchDiagram(p, s)} />
      <figure class="fig fig-tr" set:html={tracesFrame()} />
      <div class="side">
        <p class="read"><span class="k">state</span> <span class="state" data-out="state" data-state="open">open</span></p>
        <dl class="reads">
          <dt>tone</dt><dd data-out="tone">{f2(s.urest)}</dd>
          <dt>flow</dt><dd data-out="flow">1.00× rest</dd>
          <dt>debt</dt><dd data-out="debt">0.00</dd>
          <dt>time</dt><dd data-out="clock">0:00</dd>
        </dl>
        <label class="ctl-row">
          <span class="k">stress</span>
          <input type="range" data-ctl="stress" min="0" max={(1 - s.urest).toFixed(3)} step="0.005" value="0" aria-label="Stress: extra tone above rest" />
        </label>
        <div class="ctl-row buttons">
          <button class="ctl" type="button" data-ctl="gasp">a deep breath</button>
          <button class="ctl" type="button" data-ctl="press" aria-pressed="false">pressure</button>
        </div>
        <div class="ctl-row">
          <span class="k">breathing</span>
          <div class="seg-row" role="group" aria-label="Breathing">
            <button class="ctl" type="button" data-breath="off" aria-pressed="true">off</button>
            <button class="ctl" type="button" data-breath="even" aria-pressed="false">even</button>
            <button class="ctl" type="button" data-breath="relaxing" aria-pressed="false">relaxing</button>
          </div>
        </div>
        <div class="ctl-row">
          <span class="k">the breath moves the tissue here</span>
          <div class="seg-row" role="group" aria-label="How much the breath moves the tissue at the knot">
            <button class="ctl" type="button" data-move="0" aria-pressed="true">not at all</button>
            <button class="ctl" type="button" data-move="0.1" aria-pressed="false">a little</button>
            <button class="ctl" type="button" data-move="0.3" aria-pressed="false">more</button>
          </div>
        </div>
        <div class="ctl-row">
          <span class="k">trials</span>
          <div class="trials">
            <button class="ctl" type="button" data-trial="knot_forms" aria-pressed="false">a knot forms</button>
            <button class="ctl" type="button" data-trial="stress_eases" aria-pressed="false">stress eases</button>
            <button class="ctl" type="button" data-trial="press_and_release" aria-pressed="false">pressure, then release</button>
            <button class="ctl" type="button" data-trial="relaxing_breath_at_threshold" aria-pressed="false">relaxing breaths</button>
            <button class="ctl" type="button" data-trial="moving_breath" aria-pressed="false">the breath moves the tissue</button>
            <button class="ctl" type="button" data-trial="gasp_near_fold" aria-pressed="false">a breath near the fold</button>
          </div>
        </div>
        <div class="ctl-row buttons">
          <div class="seg-row" role="group" aria-label="Speed">
            <button class="ctl" type="button" data-speed="1" aria-pressed="true">1×</button>
            <button class="ctl" type="button" data-speed="4" aria-pressed="false">4×</button>
          </div>
          <button class="ctl" type="button" data-ctl="reset">reset</button>
        </div>
        <p class="note" data-out="note" aria-live="polite"></p>
        <p class="fine">These are the model's inputs, not instructions. It illustrates a hypothesis and measures nothing.</p>
      </div>
    </div>
  </section>

  <section id="checks" class="sec full" data-glyph="検">
    <h2>Four checks</h2>
    <p class="sub quote">What could hold a knot and let it go within seconds, checked with published numbers.</p>
    <div class="checks">
      <article class="check">
        <p class="q">Can the vessel hold itself?</p>
        <p class="a">Yes: a small artery is a switch.</p>
        <figure set:html={bandScale(s)} />
        <p set:html={`With measured wall strength (3.4 mN/mm; ${cite('zhang2007')}), the stretch at which its muscle is strongest (${cite('elassar2022')}), how its force falls as the muscle shortens (${cite('mulvany1979')}), the thickness of healthy human small arteries' walls (${cite('schiffrin1995')}), the pressure inside it, and the timing of breath and reactive hyperaemia, the band runs from ${f2(s.Aopen)} to ${f2(s.Afold)} of maximal tone: a shut vessel stays shut while its tone stays above ${(s.Aopen / s.urest).toFixed(1)} times rest (${f2(s.urest)}). It is the instability ${cite('burton1951')} described, which clinicians now read as a closing threshold (${cite('miller2026')}); nerves hold some arterioles shut in living tissue (${cite('bohlen1979')}). A switch in ${pct(r.share_bistable)} of ${r.samples.toLocaleString('en-GB')} plausible parameter sets.`} />
      </article>
      <article class="check">
        <p class="q">Can hyaluronan hold it?</p>
        <p class="a">No: a liquid resists motion, not position.</p>
        <figure set:html={logBars([{ label: 'drag of the most viscous collar', value: col.drag_Pa, unit: 'Pa' }, { label: 'pressure holding the vessel open', value: Math.round(col.pressure_Pa / 100) * 100, unit: 'Pa', strong: true }], 10, 20000, [10, 100, 1000, 10000])} />
        <p set:html={`At rest its drag is zero. At its most viscous (healthy synovial fluid, up to 175 Pa·s; ${cite('nicholls2018')}), in a collar 20 µm thin around a vessel snapping open in a second, the drag is ${Math.round(col.drag_Pa)} Pa: ${Math.round(col.pressure_over_drag)} times weaker than the pressure holding the vessel open. Fascia holds 6–90 µg of hyaluronan per gram (${cite('fede2018')}), ${Math.round(col.synovial_over_fascia_min)}–${Math.round(col.synovial_over_fascia_max)} times less than joint fluid (${cite('nakayama2000')}), and without protein hyaluronan does not gel (${cite('krause2001')}). If a collar holds, it is something stiffer.`} />
      </article>
      <article class="check">
        <p class="q">Can cooling let it go within a breath?</p>
        <p class="a">No: heat is too slow.</p>
        <figure set:html={logBars([{ label: 'an out-breath, at six breaths a minute', value: 6, unit: 's' }, { label: 'skin warming at maximal blood flow', value: cool.tau_s_at_max_flow, unit: 's', strong: true }, { label: 'at a tenth of that flow', value: cool.tau_s_at_tenth_flow, unit: 's', strong: true }], 1, 2000, [1, 10, 100, 1000])} />
        <p set:html={`When the vessel opens, the patch it feeds warms with a time constant of at least ${Math.round(cool.tau_s_at_max_flow)} s even at the body's maximal skin blood flow (6–8 L/min; ${cite('charkoudian2003')}), and about ${Math.round(cool.tau_s_at_tenth_flow / 60)} minutes at a tenth of it, while losing heat to the room at 7.9 W/m²·K (${cite('dedear1997')}). Letting go within a breath needs something faster than heat.`} />
      </article>
      <article class="check">
        <p class="q">Does a latch remember?</p>
        <p class="a">No: it economises.</p>
        <blockquote class="pull">“The rate-limiting step for relaxation appears to be removal of [Ca2+] and not latch-bridge detachment.”</blockquote>
        <p set:html={`Smooth muscle can hold force with less calcium and ATP, the latch (${cite('murphy2005')}), but in arteries relaxation follows the fall of calcium (${cite('rembold1991')}). A latch lets a held vessel stay held cheaply while the drive lasts; the memory is the switch. Its rate constants (${cite('hai1988')}) are not yet in an open paper; with them, the latch will run here too.`} />
      </article>
    </div>
  </section>

  <section id="predicts" class="sec" data-glyph="験">
    <h2>What it predicts</h2>
    <ul class="prose preds">
      <li><strong>Blood returns where a knot lets go.</strong> Within seconds of release, flow over the spot rises from near nothing to {f2(sc.stress_eases.summary.flow_after_open ?? 0)} of resting flow when stress eases, or {f2(sc.press_and_release.summary.flow_after_open ?? 0)} after a press while drive stays raised. Laser speckle imaging over the spot would see it; a theory with nothing held in the tissue predicts no local change. It rises above rest only as tone falls.</li>
      <li><strong>Pressure, then release, lets go faster than calm alone:</strong> {pressed.toFixed(1)} s after the pressure lifts against {Math.round(eased)} s after stress eases, with a burst from the sensory nerves of {f2(sc.press_and_release.summary.peak_spark)} against {f2(sc.stress_eases.summary.peak_spark)}. The pressure runs up a debt, and returning blood repays it through the nerves.</li>
      <li><strong>Slowing near the edge.</strong> As stress carries a vessel toward its fold, it answers small changes more and more slowly; flow over the spot should flicker more slowly just before a knot forms.</li>
      <li><strong>Through drive, breath lets go of knots only if it is uneven.</strong> Tone rises in about a second and fades over {Math.round(p.tau_down)} s, so an even swing with each breath holds a knot slightly tighter. The out-breath has to lower the skin's sympathetic drive more than the in-breath raises it; laser Doppler over hairy skin can measure whether it does. Breath may also act through movement: rhythmic stretch cuts smooth muscle's force at once <Fragment set:html={`(${cite('ljung1975')})`} />, and squeezed arteries widen within seconds of release, more after several squeezes than after one long one <Fragment set:html={`(${cite('clifford2006')})`} />. The model now carries that route, fitted to those squeezes; it acts where the breath moves the tissue, and adds up over breaths (what a breath would have to do, theory by theory, is in the <a href={`${base}/hypotheses/#differ`}>field guide</a>).</li>
      <li><strong>What to measure next:</strong> how much force a small artery's muscle keeps when the vessel is nearly shut, and how thick its wall is, in skin perforators themselves (the model takes them from rat arteries and healthy human walls). More than anything else, they decide whether a knot can hold at rest.</li>
    </ul>
  </section>

  <section id="sure" class="sec" data-glyph="確">
    <h2>How sure</h2>
    <p class="prose">
      Every uncertain parameter sampled across its range, {r.samples.toLocaleString('en-GB')} sets in a Sobol design. A
      single deep breath rarely shuts a relaxed vessel; stress has to carry tone most of the way to the fold first.
    </p>
    <figure class="bars" set:html={shareBars([
      { label: 'a switch at all', value: r.share_bistable },
      { label: 'holds even at rest', value: r.share_holds_at_rest },
      { label: 'a breath shuts a relaxed vessel', value: r.share_gasp_shuts_at_rest },
    ])} />
    <p class="prose">What decides whether a knot can hold at rest (total Sobol index):</p>
    <figure class="bars" set:html={shareBars(sobol.map((x) => ({ ...x, fmt: (v: number) => v.toFixed(2) })))} />
  </section>

  <section id="measured" class="sec" data-glyph="測">
    <h2>Against measurements</h2>
    <div class="table-wrap" role="region" aria-label="Model against measurements" tabindex="0">
      <table class="vtab">
        <thead><tr><th scope="col"></th><th scope="col">model</th><th scope="col">measured</th><th scope="col">used as</th></tr></thead>
        <tbody>
          <tr><th scope="row">lowest flow after a deep breath</th><td>{f2(v.gasp.lowest_flow)} of rest</td><td set:html={`0.29–0.41 (${cite('lau1995')})`} /><td>fitted</td></tr>
          <tr><th scope="row">when it is lowest</th><td>{v.gasp.at_s.toFixed(1)} s</td><td set:html={`4.6–5.2 s (${cite('mayrovitz2026')})`} /><td class="test">test: {(v.gasp.at_s - 5.2).toFixed(1)} s late</td></tr>
          <tr><th scope="row">recovered</th><td>{Math.round(v.gasp.recovered_s)} s</td><td set:html={`about 34 s, one recording (${cite('mayrovitz2026')})`} /><td>fitted</td></tr>
          <tr><th scope="row">flush after a 5 min occlusion</th><td>+{pct(v.flush.rise)}</td><td set:html={`+187 ± 61% (${cite('alexandrou2021')})`} /><td>sets resting tone; falls a little short</td></tr>
          <tr><th scope="row">its peak</th><td>{v.flush.peak_s.toFixed(1)} s</td><td set:html={`11.1 ± 5.1 s (${cite('alexandrou2021')})`} /><td>fitted</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="time" class="sec full" data-glyph="時">
    <h2>Time: how a knot sets</h2>
    <p class="sub">
      The switch alone holds a knot only while tone stays {healthyRatio.toFixed(1)} times rest. But smooth muscle held at a new length adapts to it: it regains
      the force it lost there, as its optimal length moves toward the length it is held at{' '}
      <Fragment set:html={`(${cite('syyong2008')}; ${cite('pratusevich1995')}; ${cite('bednarek2011')})`} />. Arterioles held constricted for four hours no longer
      relax fully when the drive is removed <Fragment set:html={`(${cite('martinezlemus2004')}; ${cite('hill2003')})`} />; held for days, they remodel inward, and
      only if their muscle is active <Fragment set:html={`(${cite('bakker2002')})`} />. In this variant the muscle's optimum follows the length it is held at,{' '}
      {pct(ad.share)} of the way (fitted to the 73% of lost force that pulmonary arterial muscle regained), over about {ad.tau_h.toFixed(0)} h at full activation
      (bracketed by the arterioles: five minutes leaves no trace, four hours does). It belongs to any vessel held by its own muscle: the perforator's, and the
      latch's.
    </p>
    <figure class="paper-fig scroll-x" set:html={knotSets(ad)} />
    <div class="two">
      <div>
        <p class="find"><strong>A knot can set.</strong> Held shut at {holdMult}× resting tone, a knot holds at rest after {setHealthy.toFixed(1)} h: it outlasts
          the stress that made it. Held an hour, it lets go when stress ends; held three, it stays. With the walls of hypertension it can be held from{' '}
          {hyFirst.mult}× rest, and sets there in {(hyFirst.hours ?? NaN).toFixed(1)} h.</p>
        <p class="find"><strong>A set knot is harder to release.</strong> Fully adapted, it stays shut down to {f2(ad.healthy.adapted_aopen_over_rest)} of
          resting tone: calm alone no longer frees it. It needs drive below rest, pressure, or movement.</p>
        <p class="find"><strong>Old knots let go with a wave; young ones without.</strong> A set knot's muscle is weak at open lengths until it re-adapts, so
          released, the vessel opens to {oldKnot.peak_flow.toFixed(1)}× resting flow. A new knot's release brings flow back only to rest, and one released
          before it set reopens narrowed, as the lab's arterioles did after four hours.</p>
        <p class="find"><strong>Days make it structural.</strong> Three days of tone narrow the relaxed lumen by {Math.round(100 * ad.remodel.shrink)}% around
          the same wall <Fragment set:html={`(${cite('bakker2002')})`} />: that alone brings the hold from {ad.remodel.before.toFixed(1)}× to{' '}
          {ad.remodel.aopen_over_rest.toFixed(1)}× resting tone.</p>
      </div>
      <div class="tiles">
        <p class="tile"><span class="big">{setHealthy.toFixed(1)} h</span><span class="fl">held shut at {holdMult}× resting tone before a knot holds at rest</span></p>
        <p class="tile"><span class="big">{pct(adRob.share_sets)}</span><span class="fl">of plausible switches can set; {pct(adRob.share_sets_within)} within {adRob.within_h} h
          held midway up the band (median {(adRob.set_h[1] ?? NaN).toFixed(1)} h)</span></p>
        <p class="tile"><span class="big">{oldKnot.peak_flow.toFixed(1)}×</span><span class="fl">resting flow when an old knot lets go; a new one's, 1×</span></p>
        <p class="tile-note">{adRob.samples} settings: the adaptation's time and share, and the switch's own ranges, each sampled.</p>
      </div>
    </div>
    <p class="caption">
      What it does not show. With drive held steady, the model's open vessels creep shut under sustained tone ({(creep15.hours ?? NaN).toFixed(0)} h at{' '}
      {creep15.mult}× rest), but arterioles held at {Math.round(100 * ad.lab.diameter)}% of their diameter for four hours kept it, where the model's would have
      shut within {(ad.lab.shuts_h ?? NaN).toFixed(1)} h. In an open vessel adaptation seems to make holding cheaper, not narrower, and flow and metabolism push
      back <Fragment set:html={`(${cite('vanbavel2014')})`} />. A shut vessel has no flow, and the results above do not lean on what is missing. The blind
      test is a small artery held shut for hours (<a href={`${base}/research/#study-10`}>study 10</a> on the Research page).
    </p>
  </section>

  <section id="trees" class="sec full" data-glyph="樹">
    <h2>Trees: a parent and its children</h2>
    <p class="sub">
      Perforators branch: a parent vessel feeds children, and they share its pressure. Each vessel here is the same switch, with its own wall;
      pressures are solved at every step. The worked tree has walls as in hypertension (media 7.5–10% of the lumen) and drive raised to{' '}
      {tree.figure.u_m.toFixed(2)} of maximal tone; the tree's own numbers are guesses and are sampled below.
    </p>
    <figure class="ink-fig wide-fig scroll-x" set:html={treeStory(tree.figure)} />
    <div class="two">
      <div>
        <p class="find"><strong>One knot upstream makes a cluster below it.</strong> When a local surge shuts the parent, the pressure beneath it collapses and all
          four children snap shut within seconds.</p>
        <p class="find"><strong>Release the parent, and the cluster lets go together.</strong> The pressure surges back and three children open within a second.
          The thickest-walled one stays shut while stress stays raised: the next knot in the queue, which goes only when drive falls.</p>
        <p class="find"><strong>Siblings protect each other.</strong> On a shared feed, each closure raises the pressure holding the others open: a surge of
          stress shut {tree.siblings.shut_by_surge} of {tree.siblings.siblings}, where alone, at the same pressure, {tree.siblings.shut_alone} would. Clusters come from the tree's hierarchy, not from neighbours.</p>
        <p class="find"><strong>The higher the stress, the longer the queue.</strong> In the worked tree, the children left held after the parent lets go:{' '}
