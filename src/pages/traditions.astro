---
import Doc from '../layouts/Doc.astro';
import { refById } from '../data/references';
import acu from '../data/sim/acupoints.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/ejhong/knots/blob/main';
const cite = (id: string) => {
  const ref = refById(id);
  if (!ref) return id;
  const parts = ref.authors.split(',')[0].split(' et al')[0].trim().split(' ');
  const last = parts[parts.length - 1];
  const who = /^\p{Lu}{1,3}$/u.test(last) ? parts.slice(0, -1).join(' ') : last;
  return `<a href="${base}/library/#${id}">${who}, ${ref.year}</a>`;
};
// Are the perforators where the points are? (sim/exploratory/2026-11-02-acupoints-perforators.py → acupoints.json). The
// position paper cites it as research/#points: that anchor sits on the Research page's study on acupoints, which links here.
const ACU_LINES: Record<string, { where: string; with: string; ends: boolean }> = {
  anterior: { where: 'Front of the lower leg', with: 'anterior tibial perforators · ST36–40, GB36–39', ends: true },
  lateral: { where: 'Behind the fibula', with: 'peroneal perforators · GB35, BL58, BL59', ends: true },
  front: { where: 'Front of the thigh', with: 'the thigh perforator on the hip-to-kneecap line · ST32–34', ends: true },
  forearm: { where: 'Forearm', with: 'radial artery perforators · LU6–8', ends: false },
  back: { where: 'Back of the calf', with: 'medial sural perforators · BL55–57', ends: false },
};
const acuLines = acu.lines.map((l) => ({ ...l, ...ACU_LINES[l.name.split(' ')[0]] }));
const pct = (x: number) => `${Math.round(100 * x)}%`;
const x2 = (v: number) => `${v.toFixed(2)}×`;
const p2 = (v: number) => v.toFixed(2);
const baseRate = (r: string) => `${pct(acu.base_rate[r as '1'].lo)}–${pct(acu.base_rate[r as '1'].hi)}`;
const ptScore = (name: string, code: string) => (acu.lines.find((l) => l.name.startsWith(name))!.points as unknown as Record<string, number>)[code];
const CORRESPONDENCES = [
  ['Ashi points, acupoints', 'China', 'Perforators, held', 'Reported at 80–100% of points, one small study with controls; vessel–nerve bundles at 2 of 100 in another dissection. Against measured clusters, points only a little nearer than random (see below)'],
  ['Sinew channels and their knots (結)', 'China', 'Lines where the fascia is anchored to bone', 'Proposed; untested'],
  ['Cou li — the texture between skin and flesh', 'China', 'The superficial fascial plane', 'Proposed'],
  ['Propagated sensation along the channel', 'China', 'Hydraulic or neural signalling along a perforator tree (conducted vasodilation itself fades over millimetres)', 'Speeds overlap (cm/s); untested together'],
  ['Channel-knots (rtsa mdud) untied by the winds', 'Tibet', 'Held states released by breath', 'Proposed'],
  ['Granthis — Brahma, Viṣṇu, Rudra', 'India', 'Knots along the midline, the last between the brows (the front root of the galea)', 'Proposed'],
  ['Kuṇḍalinī rising; kriyās', 'India', 'Release travelling along trees; the fascia re-knitting', 'Documented as experience (Lindahl 2017); mechanism open'],
  ['Saṅkhāras as solidified sensations', 'Buddhist', 'Held states that dissolve under equanimous attention and breath', 'Proposed'],
  ['Rapture (pīti) suffusing the body', 'Buddhist', 'The skin’s small vessels opening widely at once — warmth, tingling, well-being', 'Proposed'],
  ['Cupping and gua sha', 'China', 'Tools for the fascia: lift and shear the superficial plane', 'Mechanically plausible'],
];
// Foam rolling: what its teachers advise and its trials find, beside what is reported of knots (sources in the prose below).
const ROLLING = [
  ['Finding a spot', 'For the workbook and the trainers’ guide, a tender spot on which pressure is then held; the guide finds it by rolling a region slowly. Hitzmann advises against intense direct pressure on sensitive spots.', 'A bump, from very small to about the size of a penny, found by touch; it seldom hurts unless pressed hard. Some find that a trained breath helps to find knots too.'],
  ['Pressure', 'Moderate: a pain of 5 out of 10 in the workbook, a discomfort of 5 to 7 in the guide, never sharp pain; for Miller and Hitzmann it need not hurt. In two small trials, harder rolling added no range of motion.', 'Pressed hard under a roller, a knot can hurt sharply: past what the teachers advise.'],
  ['Breath', 'For the workbook and the guide, a gauge: a held breath or a grimace means pressing too hard. For Miller, a method: a big breath in, held while the muscles around the ball contract, then an out-breath that lets go.', 'A trained breath: a subtle weave of small in- and out-breaths builds the release, which is probably carried out on an out-breath that can be fairly strong. Under a roller’s pain the out-breaths are often strong and many, as in the breathing taught for childbirth.'],
  ['Time', 'About 30 to 45 seconds of held pressure on a spot; in the workbook, its pain eases over days of short, repeated sessions.', 'The let-go itself takes seconds, sometimes with a small pop; the most stubborn knots may take a whole session of work first.'],
  ['Tingling', 'Pain, numbness or tingling that persists belongs with a physician or physical therapist.', 'Sometimes a star of tingling across a patch of skin as a knot lets go.'],
  ['The other side', 'The teachers cited say nothing of it. In trials, heavy rolling of one calf raised the pain threshold of a tender spot in the other almost as much as rolling its own, and rolling one leg adds range of motion to the other, most likely through a reduced perception of pain.', 'Working the knots on one side can ease the other side as well.'],
  ['What follows', 'At times, tears, which the teachers treat as normal.', 'A wave of well-being after a release; at times, a euphoria.'],
  ['What it is for', 'Relief from pain, and range of motion, which rises for a while.', 'The knots themselves, released one place at a time.'],
];
const index = [
  { id: 'rolling', label: 'foam rolling' },
  { id: 'reading', label: 'reading' },
  { id: 'china', label: 'China' },
  { id: 'daoist', label: 'Daoist' },
  { id: 'india', label: 'Yoga · tantra' },
  { id: 'tibet', label: 'Tibet' },
  { id: 'buddhist', label: 'Buddhist' },
  { id: 'japan', label: 'Japan' },
  { id: 'table', label: 'correspondences' },
  { id: 'points', label: 'points and perforators' },
];
---
<Doc
  title="Maps of the inner body"
  kicker="Traditions"
  current="traditions"
  lede="Nearly every tradition that mapped the inner body arrived at the same three claims: there are knots, breath is the tool, and untying them changes the mind."
  description="Maps of the inner body from Chinese medicine, Daoist alchemy, yoga and tantra, Tibetan tsa lung and Dzogchen, and Buddhist practice, and the advice of today’s foam-rolling teachers — read beside the anatomy of perforators and fascia, and beside what is reported of knots."
  glyph="経"
  index={index}
>
  <section id="rolling" class="sec" data-glyph="転">
    <h2>The roller’s teachers</h2>
    <p class="label">Foam rolling · what its teachers advise, beside what is reported of knots</p>
    <div class="prose">
      <p>
        The newest tradition of work on the soft tissue is the foam roller’s, and it has teachers of its own: physiotherapists,
        massage therapists and trainers, and the books and courses they write. Their advice is set out here as they give it,
        beside what is reported of knots. It is gentler than the reports.
      </p>
      <p><strong>Pressure.</strong> The teachers ask for moderate pressure. <em>The Trigger Point Therapy Workbook</em> aims at a
        pain of 5 on a scale of 1 to 10, “a pleasant kind of pain”; its earlier editions asked for more, and the third edition
        values being able to relax <Fragment set:html={`(${cite('davies2013')})`} />. A trainers’ guide from the National Academy
        of Sports Medicine puts discomfort at 5 to 7 out of 10, never sharp pain <Fragment set:html={`(${cite('penney2021')})`} />.
        Jill Miller, author of <em>The Roll Model</em>, holds that rolling does not have to hurt to work{' '}
        <Fragment set:html={`(${cite('jmiller2025')})`} />, and Sue Hitzmann, creator of the MELT Method, that pain cannot be
        self-inflicted to get out of pain, and that consistency matters more than intensity{' '}
        <Fragment set:html={`(${cite('hitzmann2026')})`} />. In two small trials, harder rolling added no range of motion: rolling
        at pain ratings of about 4, 6 and 8 out of 10 raised it alike <Fragment set:html={`(${cite('grabow2018')})`} />, as did
        rolling at 15–25% or 45–55% of body weight <Fragment set:html={`(${cite('hirose2025')})`} />.</p>
      <p><strong>Breath.</strong> For the workbook and the trainers’ guide the breath is a gauge: “If you are grimacing or holding
        your breath, you are pressing too hard” <Fragment set:html={`(${cite('davies2013')})`} />. The trainers’ guide rules out
        “a breath-holding grimace” and holds a spot “while breathing and consciously relaxing”{' '}
        <Fragment set:html={`(${cite('penney2021')})`} />. Miller makes it a method. She reads the pain of a ball as the muscle
        bracing against it, and meets it with contract-relax: a big breath in, held while the muscles around the ball contract,
        then out, letting go, again and again, until the guarding quiets and the ball sinks in{' '}
        <Fragment set:html={`(${cite('jmiller2026')})`} />.</p>
      <p><strong>Time.</strong> The teachers speak of tens of seconds on a spot and of days for it to ease. The trainers’ guide
        holds pressure for about 30 to 45 seconds <Fragment set:html={`(${cite('penney2021')})`} />. The workbook repeats short
        sessions daily until the same pressure brings a pain of only 2 or 3, and does not expect that in one session{' '}
        <Fragment set:html={`(${cite('davies2013')})`} />. For range of motion, a review of the trials’ doses favours one to three
        sets of 30 to 120 seconds of rolling along a muscle <Fragment set:html={`(${cite('behm2020')})`} />.</p>
      <p><strong>What it does.</strong> The field calls it self-myofascial release; the reviews are more cautious. Rolling raises
        range of motion at once, about as much as stretching does <Fragment set:html={`(${cite('wilke2020')})`} />, and after
        exercise it eases muscle pain a little <Fragment set:html={`(${cite('wiewelhove2019')})`} />. That release of the fascia
        is the main way rollers work has too little evidence behind it, and one review calls the name misleading; it puts the
        effects down instead to receptors in the skin and fascia, small nerve fibres that shift the balance of sympathetic and
        parasympathetic activity, the body’s own damping of pain, reflex falls in muscle tone, and changes in blood flow and in
        the fascia’s water <Fragment set:html={`(${cite('behm2019')})`} />, ground that several of the theories on the{' '}
        <a href={`${base}/hypotheses/`}>Hypotheses</a> page stand on.</p>
      <p><strong>Cautions.</strong> The trainers’ guide advises against rolling directly over the lumbar spine, the joints and
        acute injuries <Fragment set:html={`(${cite('penney2021')})`} />. A set of proposed clinical standards lists among its
        contraindications direct pressure over the face, eyes, arteries, veins or nerves and over bony prominences, extreme
        discomfort, deep vein thrombosis, peripheral vascular disease, medicines that thin the blood or alter sensation, and
        conditions in which sensation is lost or altered; its authors call the list a starting point, not a complete one{' '}
        <Fragment set:html={`(${cite('cheatham2018')})`} />. The workbook’s rule is never to massage a pulse, lest plaque be
        loosened from a large artery and carried to the brain <Fragment set:html={`(${cite('davies2013')})`} />. Pain, numbness or
        tingling that persists, or symptoms that worsen, belong with a physician or physical therapist{' '}
        <Fragment set:html={`(${cite('penney2021')})`} />. Rolling can also bring tears: teachers see people well up in the
        middle of a class, treat it as normal, keep rolling optional, and send anyone who cries every time to a counsellor{' '}
        <Fragment set:html={`(${cite('halvorson2016')})`} />.</p>
    </div>
    <div class="table-wrap">
      <table class="roll">
        <thead>
          <tr><th></th><th>What the teachers advise, and trials find</th><th>What is reported of knots</th></tr>
        </thead>
        <tbody>
          {ROLLING.map((r) => (
            <tr>{r.map((c) => <td>{c}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="prose">
      <p><strong>Where they meet.</strong> Both attend to the breath. For two of the teachers it is a gauge, and for Miller a
        method; her contract-relax shares one thing with the breath reported, a letting go on an out-breath. Otherwise they
        differ: hers is a big breath held with the muscles contracted, the reported one a weave of small breaths. The trials, too,
        measure something like the mirroring reported: heavy rolling of one calf raised the pain threshold of a tender spot in
        the other almost as much as rolling its own <Fragment set:html={`(${cite('aboodarda2015')})`} />, and rolling one leg adds
        range of motion to the other, most likely, on one review’s reading, through a reduced perception of pain{' '}
        <Fragment set:html={`(${cite('konrad2023')})`} />. And both know that a release can move people. The teachers see tears in
        their classes, in one account as a client’s locked upper back let go and the breath came freely{' '}
        <Fragment set:html={`(${cite('halvorson2016')})`} />; the reports describe a wave of well-being after a release, at times a
        euphoria. Tears and euphoria may be one response: the feeling that can come with a release.</p>
      <p><strong>Where they part.</strong> On pain, first: the teachers ask for moderate discomfort, and the workbook has lowered
        its level since its earlier editions; the reports describe rolling past that point, into sharp pain met with strong
        out-breaths. On time: the teachers hold a spot for tens of seconds and expect its pain to ease over days; the reports
        describe a let-go within seconds, which may be another event or the same one seen more closely. On tingling: the teachers
        send pain, numbness or tingling that persists to a physician, and the reports describe a tingle as a knot lets go; the
        two are not always easy to tell apart, and the teachers’ caution stands. And on what is worked: the teachers work on
        tender spots and the trials measure range of motion and pain, while the reports describe bumps that seldom hurt. The trials score what is felt, as pain out of ten, soreness or recovery, and
        the research on rolling has hardly begun to ask people to describe what they feel. None of the trials cited here asked whether a bump was there before and gone after, or whether knots let go at the pressures the
        teachers advise; a recording at a release could show what happens there
        (<a href={`${base}/research/#study-4`}>study 4</a>).</p>
    </div>
    <p class="fine prose">
      A summary of advice, not advice: nothing here is a practice or a protocol. Where the reports go further than the teachers
      advise, harder and with stronger breaths, the site’s moderation guidance applies (see{' '}
      <a href={`${base}/about/#moderation`}>About</a>).
    </p>
  </section>

  <section id="reading" class="sec" data-glyph="読">
    <h2>A note on reading</h2>
    <div class="prose">
      <p>
        These maps were drawn from the inside, in their own vocabularies, over two thousand years. They are not anatomy, and nothing here
        claims they were secretly describing it. The claim is narrower: where the traditions and modern reports agree on a <em>place</em> in
        the body, there is often a real structure there — a correspondence specific enough to be checked blind. Correspondence found after
        the fact is the weakest kind of evidence. Five of these maps are drawn on one body in the <a href={`${base}/atlas/`}>atlas</a> (Maps),
        beside its perforators, knots and deep channels: the channels and points of Chinese medicine and its sinew channels on the skin, and
        the Daoist orbit, the yogic cakras and the Tibetan channels and wheels inside the figure, where the traditions place them.
      </p>
    </div>
  </section>

  <section id="china" class="sec" data-glyph="経絡">
    <h2>Points, channels, and the knots of the sinews</h2>
    <p class="label">China · Huangdi Neijing and after</p>
    <div class="prose">
      <p>
        Chinese medicine works with two kinds of structure. The first are points. The tender <em>ashi</em> points, named by Sun Simiao for
        the patient’s cry when they are pressed, follow one rule: take the painful spot as the point. The 361 classical acupoints lie along
        twelve primary channels and two midline vessels — the Governor (Du) up the back and the Conception (Ren) down the front.
      </p>
      <p>
        The second is the fascia. The <em>Neijing</em> describes the <em>cou li</em>, the interstices between skin and flesh, through which
        the defensive qi circulates and pathogenic “wind” enters. It also describes the <em>jing jin</em>, twelve sinew channels of muscle and
        connective tissue, each of which <em>knots</em> — 結, jié, to bind or tie — at bony prominences such as the ankle, knee, hip, shoulder
        and cheekbone, and whose treatment is heat at the painful spot. Needling and acupressure act at points; cupping and gua sha act on
        the plane, lifting and shearing it until “sha” rises.
      </p>
      <p>
        For decades, Chinese researchers have also documented <em>propagated sensation along the channel</em>: stimulating a point produces
        warmth or tingling that travels along the meridian at one to ten centimetres a second and is halted by pressure or cold — a profile
        reminiscent of a vascular or neural wave along a fascial plane, though conducted dilation along a single arteriole wall fades over
        millimetres and could not by itself span a limb.
      </p>
      <p>
        Are the points the perforators? About 80% of them have been reported to lie where a vessel–nerve bundle pierces the fascia,
        and the channels to run along the planes between muscles, where many perforators travel. Point names may themselves record
        what early anatomists saw in dissection (<a href={`${base}/library/#shaw2016`}>Shaw, 2016</a>). But the perforators' clusters vary by centimetres between people,
        practitioners' marks for one point spread as widely, and only one small study has set the points against control points:
        none has asked how often a point placed at random would land as near a vessel. Set against measured perforator clusters, the points sit only a little nearer than chance:{' '}
        <a href="#points">the evidence, a test against chance, and a study that might decide it</a>.
      </p>
    </div>
    <p class="in-atlas"><a class="btn" href={`${base}/atlas/?map=meridians`}>channels and points in the atlas →</a> <a class="btn" href={`${base}/atlas/?map=sinew`}>sinew channels →</a></p>
  </section>

  <section id="daoist" class="sec" data-glyph="周天">
    <h2>The orbit</h2>
    <p class="label">Daoist internal alchemy</p>
    <div class="prose">
      <p>
        In <em>neidan</em>, internal alchemy, the practitioner circulates breath-energy around the <em>microcosmic orbit</em>: up the
        Governor vessel along the spine and over the head, then down the Conception vessel in front, through gates where the flow is said to
        be blocked until the work opens them. Three dantian — below the navel, at the heart and between the brows — are the fields in which
        the work is done. The manuals counsel patience: the orbit opens over years, and is not to be forced.
      </p>
    </div>
    <p class="in-atlas"><a class="btn" href={`${base}/atlas/?map=orbit`}>the orbit in the atlas →</a></p>
  </section>

  <section id="india" class="sec" data-glyph="輪">
    <h2>Nāḍīs, cakras, and the three knots</h2>
    <p class="label">Yoga and tantra</p>
    <div class="prose">
      <p>
        The yogic body is a network of <em>nāḍīs</em> — seventy-two thousand in the Haṭha Yoga Pradīpikā, three hundred and fifty thousand in
        the Śiva Saṃhitā — of which three matter most: <em>suṣumṇā</em> in the centre, with <em>iḍā</em> and <em>piṅgalā</em> winding on
        either side. Along the central channel sit the <em>cakras</em>, and at three of them, knots: the <strong>granthis</strong> of Brahmā
        low in the body, of Viṣṇu at the heart, and of Rudra between the brows. Breath and attention pierce them in turn, and each piercing
        marks a stage.
      </p>
      <p>
        In the kuṇḍalinī literature the energy is a serpent coiled at the base of the spine, rising through the knots to the crown. The
        rising is described as heat, currents and involuntary movement — the <em>kriyās</em> — and sometimes as a crisis that takes years to
        settle. One number is worth holding lightly: seventy-two thousand channels, and about a hundred thousand small perforators.
      </p>
    </div>
    <p class="in-atlas"><a class="btn" href={`${base}/atlas/?map=chakras`}>cakras and nāḍīs in the atlas →</a></p>
  </section>

  <section id="tibet" class="sec" data-glyph="脈風">
    <h2>Channels, winds, drops — and knots</h2>
    <p class="label">Tibet · tsa lung and Dzogchen</p>
    <div class="prose">
      <p>
        Tibetan practice works with <em>tsa</em>, channels; <em>lung</em>, winds; and <em>tigle</em>, drops. A central channel runs from the
        crown to below the navel, with right and left channels beside it that coil around it at the channel-wheels, forming{' '}
        <strong>channel-knots</strong> (<em>rtsa mdud</em>), tightest at the heart. The Six Yogas and the tsa lung exercises untie them by
        working the winds with the breath — and the traditions warn against untying them too fast.
      </p>
      <p>
        Dzogchen adds a channel of its own, the <em>kati</em>, a crystal tube joining the heart to the eyes, and makes the tradition’s most
        extreme claim about the body: the <strong>rainbow body</strong> (<em>’ja’ lus</em>), in which a realised practitioner’s body is said to
        shrink at death and dissolve into light, leaving only hair and nails. On the perforator view the endpoint is humbler, and measurable:
        a body with all its perforators open and none of its knots.
      </p>
    </div>
    <p class="in-atlas"><a class="btn" href={`${base}/atlas/?map=tsalung`}>channels and wheels in the atlas →</a></p>
  </section>

  <section id="buddhist" class="sec" data-glyph="龍">
    <h2>Saṅkhāras, and the serpent over the head</h2>
    <p class="label">Buddhist practice and iconography</p>
    <div class="prose">
      <p>
        In the Vipassana taught by S. N. Goenka, gross, solid bodily sensations are <em>saṅkhāras</em> — congealed reactions — that dissolve
        under equanimous attention. This is almost word for word what happens on a foam roller, with attention as the probe. The suttas
        describe the rapture of deep concentration suffusing the whole body, as water kneaded into a ball of bath powder soaks it through,
        within and without — the well-being that can come with a release.
      </p>
      <p>
        After the awakening, the Udāna says, a great storm came, and the nāga king <strong>Mucalinda</strong> coiled around the seated Buddha
        and spread his hood over his head for seven days. In the iconography the hood has seven heads and forms a canopy over the crown,
        where the <em>uṣṇīṣa</em> rises from the top of the Buddha’s head. It is imagery, not evidence — but serpents appear wherever the
        traditions describe what moves in the body: kuṇḍalinī coiled at the base of the spine, the nāga’s hood over the crown, and the
        snake-like rising some practitioners describe today.
      </p>
    </div>
  </section>

  <section id="japan" class="sec" data-glyph="凝り">
    <h2>Kori</h2>
    <p class="label">Japan</p>
    <div class="prose">
      <p>
        Japanese has an everyday word for a knot: <em>kori</em> (凝り), a congealing — and <em>katakori</em>, stiff shoulders, is among the most
        common complaints in the country. Shiatsu presses <em>tsubo</em>, points; Zen training gathers the breath into the <em>hara</em>,
        below the navel.
      </p>
    </div>
  </section>

  <section id="table" class="sec full" data-glyph="対照">
    <h2>Proposed correspondences</h2>
    <p class="label">Read beside the anatomy</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Traditional structure</th><th>Tradition</th><th>Proposed correlate</th><th>Status</th></tr>
        </thead>
        <tbody>
          {CORRESPONDENCES.map((r) => (
            <tr>{r.map((c) => <td>{c}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="fine prose">
      Each could be checked blind. Are the classical points perforators (<a href="#points">a first test</a>, below)? Are the knots of the sinew channels the lines where the fascia is
      anchored? Are the channels the trees and planes between them?
    </p>
  </section>

  <section id="points" class="sec" data-glyph="穴">
    <h2>Are the perforators where the points are?</h2>
    <p class="label">The points beside the anatomy, and a test against chance</p>
    <div class="prose">
      <p>
        Two questions: do the major perforators come through the fascia in the same places in everyone, and do the acupoints sit
        on them? The zones are shared; the vessels are not. The points sit a little nearer the perforators than chance would put
        them, too little to tell from chance with the evidence there is.
      </p>
      <p><strong>The zones, yes.</strong> About forty source arteries, and on average 374 major perforators in each
        body, follow the connective-tissue framework <Fragment set:html={`(${cite('taylor1987')})`} />: the arteries are constant and
        the single vessels variable <Fragment set:html={`(${cite('morris2010')})`} />. Some places almost always have one. Perforators
        gather at the middle of the line from the hip bone to the kneecap (74.6% in its middle three tenths; none at all in 6.6% of
        thighs) <Fragment set:html={`(${cite('ulatowski2012')})`} />. An internal mammary perforator was present on both sides in
        every case, about 1.8 cm from the edge of the breastbone <Fragment set:html={`(${cite('kanoi2017')})`} />, the largest in the
        first or second rib space in three cases of four <Fragment set:html={`(${cite('okumura2016')})`} />. The lowest
        posterior tibial perforator lay 3.5–8.2 cm above the inner ankle in all thirty legs <Fragment set:html={`(${cite('bulla2015')})`} />.</p>
      <p><strong>The vessels, no.</strong> Each cluster spreads over two to four centimetres between people, an SD of 6–11% of the
        shin's length on CT angiography <Fragment set:html={`(${cite('martin2013')})`} />, and the two sides of one body differ. On the
        thighs the average place agrees within 3% of thigh length but the number of perforators does not{' '}
        <Fragment set:html={`(${cite('lu2019')})`} />; the largest internal mammary perforator is in the same rib space on both sides
        in only 49% <Fragment set:html={`(${cite('okumura2016')})`} />; the abdomen's perforators do not correspond between sides{' '}
        <Fragment set:html={`(${cite('rozen2010b')})`} />, nor does the branching of their source artery{' '}
        <Fragment set:html={`(${cite('rozen2010')})`} />. Surgeons map each side before they cut.</p>
      <p><strong>Points are proportional too.</strong> Acupoints are placed by proportional inches (cun) between landmarks, and
        surgeons place perforators the same way, as fractions of a segment. That is the frame to compare them in, but the spread
        that remains after scaling is still centimetres on both sides: 95% of 71 doctors' marks for one point fell within 2.7 cm²
        (PC6) to 41.4 cm² (ST38), a circle of 1 to 3.6 cm radius <Fragment set:html={`(${cite('molsberger2012')})`} />. A fixed map of
        points could only ever match the zones.</p>
      <p><strong>What it means for knots.</strong> No map of knots can hold across people, only a map of the zones where
        perforators crowd: the atlas's perforators are placed that way, by density, and are representative. Within one person the
        perforators do not move. So if knots sit at perforators, or at the nerves that pass beside them, one person's knots should
        come and go among a fixed set of places, their own map, and a knot that seems to move should be one place letting go and
        another taking up. A theory that puts a knot wherever stress is held needs no such stations.</p>
      <p><strong>What has been claimed.</strong> Heine reported that about 80% of acupoints lie where a vessel–nerve bundle
        perforates the fascia <Fragment set:html={`(${cite('heine1988')})`} />; the figure is widely repeated, and its method cannot be
        checked from the record. Earlier, dissection beneath 201 points found a nerve at 29%, a vessel at 34% and both at 37%: no one
        structure common to all <Fragment set:html={`(${cite('bossy1975')})`} />. A multicentre dissection of 100 lower-leg points found
        vessel–nerve bundles at two <Fragment set:html={`(${cite('maurer2019')})`} />. The two may not have looked at the same layer of
        fascia, which is worth settling against Heine's original. Most points do lie on the connective-tissue planes between
        muscles <Fragment set:html={`(${cite('langevin2002')})`} />, which are where many perforators run, but planes are not
        perforators. One study used controls: thermography found a perforator at 87.5% of 144 thigh points and at 18.1% of control
        points 4 cm along the same channel, in six people, unblinded <Fragment set:html={`(${cite('alvarezprats2019')})`} />. A
        dissection of two arms found a perforating vessel at all 30 points studied <Fragment set:html={`(${cite('meng2024')})`} />; a
        Doppler study found “a certain correspondence”, with physicians' marks for one point up to 16.6 mm apart{' '}
        <Fragment set:html={`(${cite('guo2024')})`} />. None compared the points with points placed at random.</p>
      <p><strong>Why chance matters.</strong> If the 374 major perforators were scattered evenly over an adult's skin (1.6–2 m²),
        a spot chosen at random would lie within 1 cm of one {baseRate('1')} of the time, within 2 cm {baseRate('2')}, within 3 cm{' '}
        {baseRate('3')}. Points are found only to within one to three centimetres{' '}
        <Fragment set:html={`(${cite('molsberger2012')}; ${cite('aird2002')})`} />, and smaller perforators are far denser, so “a
        perforator near the point” is common by chance. The comparison of trigger points with acupoints fell into the same trap: a
        71% correspondence <Fragment set:html={`(${cite('melzack1977')})`} />, later put nearer 18–19%{' '}
        <Fragment set:html={`(${cite('birch2003')})`} />. A coincidence rate means nothing without the rate for points that are not
        points, and without saying which vessels count.</p>
      <p><strong>A test against chance.</strong> On five lines of the limbs, a measured perforator cluster and a run of WHO points
        lie along the same septum. Both are written as a fraction of the segment, the perforators with their spread between people,
        the points by their cun, and the perforator density at the points is compared with the density at points placed at random
        on the same line, in {acu.variants} variants: the papers that give a percentage without saying from which end were run both
        ways, and the location error and the cun conversion were varied. At the {acu.points} points the density is{' '}
        {x2(acu.ratio.median)} that at random points (the median of the variants; p {p2(acu.p.min)}–{p2(acu.p.max)}, below 0.05 in{' '}
        {pct(acu.p.share_below_05)} of them). A map whose points sat on the clusters would score{' '}
        {x2(acu.perfect.min)}–{x2(acu.perfect.max)}, p &lt; 0.0001: the test could see it.</p>
    </div>
    <div class="table-wrap">
      <table class="pt">
        <thead><tr><th>Line</th><th>Perforators · points</th><th>Density at the points, against random</th><th>p</th></tr></thead>
        <tbody>
          {acuLines.map((l) => (
            <tr>
              <td>{l.where}</td>
              <td>{l.with}</td>
              <td>{l.ratio.min.toFixed(1)}–{x2(l.ratio.max)}{l.ends ? ' *' : ''}</td>
              <td class="nw">{p2(l.p.min)}–{p2(l.p.max)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="fine prose">* The paper gives a percentage without saying which end it is measured from; the range spans both readings.</p>
    <div class="prose">
      <p><strong>Some points sit on a cluster.</strong> SP6, three cun above the inner ankle, is about{' '}
        {acu.medial.points.SP6.toFixed(1)} cm up on a {Math.round(acu.medial.leg_cm)} cm shin; the lowest posterior tibial perforator
        lies at a median 6.75 cm <Fragment set:html={`(${cite('bulla2015')})`} />. LU6 and LU7 sit at 58% and 12.5% of the forearm; the
        radial artery's two clusters at 61.7% and 17.6% <Fragment set:html={`(${cite('saintcyr2010')})`} /> (density {x2(ptScore('forearm', 'LU6'))}{' '}
        and {x2(ptScore('forearm', 'LU7'))} the line's average). BL56 is about 12.5 cm below the knee crease; the medial sural
        perforators 11.4 ± 2.7 cm <Fragment set:html={`(${cite('kao2010')})`} /> ({x2(ptScore('back', 'BL56'))}). ST32 lies on the
        very line surgeons draw to find the thigh's perforator.</p>
      <p><strong>Others do not.</strong> ST33, ST34, BL55 and BL57 lie between clusters. The abdomen's dominant
        perforator lies at a median 3.3 cm out and 0.9 cm below the navel <Fragment set:html={`(${cite('saad2014')})`} />,
        between the Kidney line (half a cun out) and the Stomach line (two cun). The dominant lumbar perforator reaches the fat
        69.5 mm from the midline, mostly at the third lumbar level <Fragment set:html={`(${cite('hamdi2016')})`} />: on the course
        of the outer Bladder line, where the WHO places no point.</p>
      <p><strong>Across the limb, they agree; that is partly built in.</strong> Many channels run along the septa that
        perforators leave by: the points “behind the edge of the shinbone” are on the posterior tibial perforators' septum, the
        Lung points at the wrist over the radial artery. But points and septa are both defined by the same muscles and bones, so
        that agreement is not independent evidence. Along the line, where it would be, the points do slightly better than
        random and much worse than a map placed on the clusters.</p>
      <p><strong>Its limits.</strong> The perforator positions are averages from different bodies, five to sixty
        limbs a study; there are {acu.points} points on five lines; the shin's cun and the anatomists' tibial height are not quite
        the same length. It is a map from averages, not a measurement. Not shown, not excluded.</p>
      <p><strong>A study that might decide it.</strong> In the same people, perforators mapped by thermal camera as the skin
        rewarms after a mild cold <Fragment set:html={`(${cite('weum2016b')})`} /> and checked by Doppler, while practitioners mark the
        points by the WHO's proportional rules, out of the reader's sight; the share of points with a perforator within 0.5, 1, 2
        and 3 cm set against random and shifted maps, with the vessels that count fixed before looking. Or, from records: the
        channels laid over the CT angiograms taken before abdominal flap surgery, which record perforators by the thousand. It is{' '}
        <a href={`${base}/research/#study-10`}>study 10</a> on the Research page. A match could not tell perforators from
        the cutaneous nerves that come through the same openings; a recording at a release might{' '}
        (<a href={`${base}/research/#study-4`}>study 4</a>).</p>
    </div>
    <p class="fine prose">
      The test's code is in the repository (<a href={`${repo}/sim/exploratory/2026-11-02-acupoints-perforators.py`}>acupoints-perforators.py</a>),
      every number with its source. Any measurement with people belongs under the site's moderation guidance (see{' '}
      <a href={`${base}/about/#moderation`}>About</a>).
    </p>
  </section>
